<Window x:Class="RaccoonWarehouse.Common.Loading.LoadingWindow_v2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        ShowActivated="False"
        Topmost="True"
        Width="420"
        Height="272">

    <Grid Margin="0,0,40,0">
        <Border Width="351"
                Padding="24"
                CornerRadius="26"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Effect="{StaticResource DropShadowSoft}" Height="336" Margin="29,0,0,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1D2936" Offset="0"/>
                    <GradientStop Color="#214756" Offset="0.55"/>
                    <GradientStop Color="#2E6B63" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Width="74"
                            Height="74"
                            CornerRadius="37"
                            Background="#14FFFFFF"
                            BorderBrush="#24FFFFFF"
                            BorderThickness="1"
                            Margin="0,0,0,16">
                        <Grid>
                            <Image Source="pack://application:,,,/Assets/logo/Logo newfinal.ico"
                                   Width="40"
                                   Height="40"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Grid Width="60"
                          Height="60"
                          Margin="0,0,0,18">
                        <Ellipse Stroke="#22FFFFFF"
                                 StrokeThickness="5"/>

                        <Ellipse Stroke="#A9E5BB"
                                 StrokeThickness="5"
                                 StrokeDashArray="1.2 2.8"
                                 StrokeStartLineCap="Round"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform/>
                            </Ellipse.RenderTransform>

                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="(Ellipse.RenderTransform).(RotateTransform.Angle)"
                                                             From="0"
                                                             To="360"
                                                             Duration="0:0:1.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>

                        <Ellipse Width="36"
                                 Height="36"
                                 Stroke="#4DD7F1E5"
                                 StrokeThickness="3"
                                 StrokeDashArray="0.8 3.6"
                                 StrokeStartLineCap="Round"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform/>
                            </Ellipse.RenderTransform>

                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="(Ellipse.RenderTransform).(RotateTransform.Angle)"
                                                             From="360"
                                                             To="0"
                                                             Duration="0:0:1.8"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                    </Grid>

                    <TextBlock Text="Raccoon Warehouse"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,4"/>

                    <TextBlock x:Name="MessageText"
                               Text="Preparing your workspace..."
                               Margin="0,8,0,0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#DDEDEA"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="220"/>

                    <TextBlock x:Name="HintText"
                               Text="Loading dashboard and actions"
                               Margin="0,4,0,0"
                               FontSize="11"
                               Foreground="#B9D0CC"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
