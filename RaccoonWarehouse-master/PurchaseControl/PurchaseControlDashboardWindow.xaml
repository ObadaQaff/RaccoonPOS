<Window x:Class="RaccoonWarehouse.PurchaseControl.PurchaseControlDashboardWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Spider Pharmacy | Purchase Control Dashboard" Height="820" Width="1500" WindowStartupLocation="CenterScreen" Background="#EEF4F8" Loaded="Window_Loaded">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Grid.Row="0" Background="#17385F" CornerRadius="8" Padding="22,18" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SPIDER PHARMACY | PURCHASE CONTROL" Foreground="White" FontSize="27" FontWeight="Bold"/><TextBlock Text="Summary of purchase requests, orders, receipts, payments, and supplier balances." Foreground="#D9ECF8" Margin="0,7,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="PURCHASING DASHBOARD | لوحة المشتريات" Foreground="#BFE4F4" FontSize="15" FontWeight="SemiBold"/></Grid></Border>
<UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,14"><Border Background="White" BorderBrush="#C9D8E5" BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="Purchase orders | أوامر الشراء" Foreground="#17385F"/><TextBlock x:Name="PoCountText" Text="0" FontSize="25" FontWeight="Bold" Foreground="#1594C3" Margin="0,6,0,0"/></StackPanel></Border><Border Background="White" BorderBrush="#C9D8E5" BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="Purchase requests | طلبات الشراء" Foreground="#17385F"/><TextBlock x:Name="PrCountText" Text="0" FontSize="25" FontWeight="Bold" Foreground="#1594C3" Margin="0,6,0,0"/></StackPanel></Border><Border Background="White" BorderBrush="#C9D8E5" BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="Approved PR | المعتمد" Foreground="#17385F"/><TextBlock x:Name="ApprovedPrText" Text="0" FontSize="25" FontWeight="Bold" Foreground="#16735F" Margin="0,6,0,0"/></StackPanel></Border><Border Background="White" BorderBrush="#C9D8E5" BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="Purchase total | إجمالي المشتريات" Foreground="#17385F"/><TextBlock x:Name="PurchaseTotalText" Text="0.000 JOD" FontSize="21" FontWeight="Bold" Foreground="#17385F" Margin="0,6,0,0"/></StackPanel></Border><Border Background="White" BorderBrush="#C9D8E5" BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="Paid | المدفوع" Foreground="#17385F"/><TextBlock x:Name="PaidTotalText" Text="0.000 JOD" FontSize="21" FontWeight="Bold" Foreground="#16735F" Margin="0,6,0,0"/></StackPanel></Border><Border Background="#FFF1D6" BorderBrush="#EACB8A" BorderThickness="1" CornerRadius="7" Padding="14"><StackPanel><TextBlock Text="Outstanding | الرصيد المستحق" Foreground="#815D17"/><TextBlock x:Name="OutstandingText" Text="0.000 JOD" FontSize="21" FontWeight="Bold" Foreground="#815D17" Margin="0,6,0,0"/></StackPanel></Border></UniformGrid>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="White" BorderBrush="#C9D8E5" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,12,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="SUPPLIER SUMMARY | ملخص الموردين" Foreground="#17385F" FontSize="19" FontWeight="Bold" Margin="0,0,0,10"/><DataGrid x:Name="SupplierGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" RowHeight="34"><DataGrid.Columns><DataGridTextColumn Header="Supplier | المورد" Binding="{Binding SupplierName}" Width="1.6*"/><DataGridTextColumn Header="Purchases | المشتريات" Binding="{Binding PurchaseTotal, StringFormat=N3}" Width="1*"/><DataGridTextColumn Header="Paid | المدفوع" Binding="{Binding PaidTotal, StringFormat=N3}" Width="1*"/><DataGridTextColumn Header="Outstanding | المستحق" Binding="{Binding Outstanding, StringFormat=N3}" Width="1*"/></DataGrid.Columns></DataGrid></Grid></Border><Border Grid.Column="1" Background="White" BorderBrush="#C9D8E5" BorderThickness="1" CornerRadius="8" Padding="14"><StackPanel><TextBlock Text="QUICK WORKFLOW | طريقة العمل" Foreground="#17385F" FontSize="19" FontWeight="Bold" Margin="0,0,0,10"/><TextBlock Text="01  PR Items | سجل أصناف طلبات الشراء" Padding="12" Background="#E8F4FA" Foreground="#17385F" Margin="0,0,0,2"/><TextBlock Text="02  Review and approve PR | راجع واعتمد الطلب" Padding="12" Background="#F3F8FB" Foreground="#17385F" Margin="0,0,0,2"/><TextBlock Text="03  Create PO from approved PR | أنشئ أمر شراء" Padding="12" Background="#E8F4FA" Foreground="#17385F" Margin="0,0,0,2"/><TextBlock Text="04  Receive goods | سجل الاستلام" Padding="12" Background="#F3F8FB" Foreground="#17385F" Margin="0,0,0,2"/><TextBlock Text="05  Record payments | سجل الدفعات" Padding="12" Background="#E8F4FA" Foreground="#17385F" Margin="0,0,0,2"/><TextBlock Text="06  Reconcile suppliers | طابق أرصدة الموردين" Padding="12" Background="#F3F8FB" Foreground="#17385F"/></StackPanel></Border></Grid>
<TextBlock Grid.Row="3" Text="Dashboard values are calculated from existing PR, PO, and Purchase Control records. Refresh to recalculate." Foreground="#6D7E8D" FontStyle="Italic" Margin="0,12,0,0"/><Button Content="↻ Refresh" Click="Refresh_Click" HorizontalAlignment="Right" Grid.Row="3" Padding="18,8" Background="#245985" Foreground="White" FontWeight="SemiBold" Margin="0,8,0,0"/>
</Grid></Window>
