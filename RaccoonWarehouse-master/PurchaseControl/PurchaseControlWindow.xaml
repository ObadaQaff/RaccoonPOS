<Window x:Class="RaccoonWarehouse.PurchaseControl.PurchaseControlWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Purchase Control | متابعة المشتريات" Height="820" Width="1900" MinWidth="1200" WindowStartupLocation="CenterScreen" Background="#EEF4F8" Loaded="Window_Loaded">
    <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#17385F" CornerRadius="8" Padding="20,15" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PURCHASE CONTROL | متابعة المشتريات" Foreground="White" FontSize="25" FontWeight="Bold"/><TextBlock Text="Free-text purchasing register for orders, invoices, receipts, payments, and supplier follow-up." Foreground="#D9ECF8" Margin="0,6,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="CONTROL REGISTER | سجل المتابعة" Foreground="#BFE4F4" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Top"/></Grid></Border>
        <Border Grid.Row="1" Background="#F7FBFD" BorderBrush="#C9D8E5" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12"><StackPanel Orientation="Horizontal"><Button Content="＋ Add line" Click="Add_Click" Padding="18,8" Background="#1594C3" Foreground="White" FontWeight="SemiBold" Margin="0,0,8,0"/><Button Content="Save selected" Click="Save_Click" Padding="18,8" Background="#16735F" Foreground="White" FontWeight="SemiBold" Margin="0,0,8,0"/><Button Content="↻ Refresh" Click="Refresh_Click" Padding="18,8" Background="#E5EEF5" Foreground="#17385F" FontWeight="SemiBold"/><TextBlock Text="All fields are free text; no product, quantity, tax, discount, or product foreign key is required." VerticalAlignment="Center" Foreground="#6D7E8D" Margin="18,0,0,0"/></StackPanel></Border>
        <DataGrid x:Name="EntriesGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" SelectionMode="Single" HeadersVisibility="Column" FrozenColumnCount="2" RowHeight="32" BorderBrush="#C9D8E5" Background="White">
            <DataGrid.Columns><DataGridTextColumn Header="Payment mode | الطريقة" Binding="{Binding PaymentMethod, UpdateSourceTrigger=PropertyChanged}" Width="135"/><DataGridTextColumn Header="PO No | الرقم" Binding="{Binding PurchaseOrderNumber, UpdateSourceTrigger=PropertyChanged}" Width="110"/><DataGridTextColumn Header="PO date | التاريخ" Binding="{Binding PurchaseOrderDate, UpdateSourceTrigger=PropertyChanged}" Width="115"/><DataGridTextColumn Header="PR No | الطلب" Binding="{Binding PurchaseRequestNumber, UpdateSourceTrigger=PropertyChanged}" Width="110"/><DataGridTextColumn Header="Supplier | المورد" Binding="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}" Width="170"/><DataGridTextColumn Header="PO amount | المبلغ" Binding="{Binding PurchaseOrderAmount, UpdateSourceTrigger=PropertyChanged}" Width="120"/><DataGridTextColumn Header="Invoice No | الفاتورة" Binding="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}" Width="125"/><DataGridTextColumn Header="Invoice date | التاريخ" Binding="{Binding InvoiceDate, UpdateSourceTrigger=PropertyChanged}" Width="115"/><DataGridTextColumn Header="Delivery date | التسليم" Binding="{Binding DeliveryDate, UpdateSourceTrigger=PropertyChanged}" Width="115"/><DataGridTextColumn Header="Description | الوصف" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="220"/><DataGridTextColumn Header="Category | التصنيف" Binding="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Width="145"/><DataGridTextColumn Header="Paid | المدفوع" Binding="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}" Width="110"/><DataGridTextColumn Header="Due | المستحق" Binding="{Binding DueAmount, UpdateSourceTrigger=PropertyChanged}" Width="110"/><DataGridTextColumn Header="Receipt | الاستلام" Binding="{Binding ReceiptAmount, UpdateSourceTrigger=PropertyChanged}" Width="110"/><DataGridTextColumn Header="Payment status | حالة الدفع" Binding="{Binding PaymentStatus, UpdateSourceTrigger=PropertyChanged}" Width="150"/><DataGridTextColumn Header="Due date | الاستحقاق" Binding="{Binding DueDate, UpdateSourceTrigger=PropertyChanged}" Width="115"/><DataGridTextColumn Header="Link check | المطابقة" Binding="{Binding LinkCheck, UpdateSourceTrigger=PropertyChanged}" Width="140"/><DataGridTextColumn Header="Notes | ملاحظات" Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Width="220"/><DataGridTextColumn Header="Overdue days | التأخير" Binding="{Binding OverdueDays, UpdateSourceTrigger=PropertyChanged}" Width="110"/><DataGridTextColumn Header="Received value | المستلم" Binding="{Binding ReceivedValue, UpdateSourceTrigger=PropertyChanged}" Width="125"/></DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="3" Text="Free-text register only. It does not create inventory, accounting, invoice, or product records automatically." Foreground="#6D7E8D" FontStyle="Italic" Margin="0,10,0,0"/>
    </Grid>
</Window>
