<Window x:Class="RaccoonWarehouse.PurchaseOrders.PurchaseOrderDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تفاصيل أمر الشراء" Height="850" Width="1320" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppPageBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="DetailCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="AmountValue" TargetType="TextBlock" BasedOn="{StaticResource DetailValue}">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
        </Style>
        <Style x:Key="NumericCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>
        <Style x:Key="DetailsGrid" TargetType="DataGrid">
            <Setter Property="RowHeight" Value="42"/>
            <Setter Property="ColumnHeaderHeight" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E9EEF3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F7FAFD"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F1F6FA"/>
                        <Setter Property="Foreground" Value="{StaticResource AppBlueBrush}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource AppBlueHeroBrush}" CornerRadius="20" Padding="22,18" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="تفاصيل أمر الشراء" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="OrderSummaryText" Foreground="#D3E6F3" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#204B72" CornerRadius="14" Padding="24,10" Margin="16,0,0,0">
                    <StackPanel>
                        <TextBlock Text="عدد البنود" Foreground="#D3E6F3" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ItemCountText" FontSize="26" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource DetailCard}" Margin="0,0,0,14">
            <UniformGrid Columns="3">
                <StackPanel Margin="0,0,16,12"><TextBlock Text="المورد" Style="{StaticResource DetailLabel}"/><TextBlock x:Name="SupplierText" Style="{StaticResource DetailValue}"/></StackPanel>
                <StackPanel Margin="0,0,16,12"><TextBlock Text="التاريخ" Style="{StaticResource DetailLabel}"/><TextBlock x:Name="DateText" Style="{StaticResource DetailValue}"/></StackPanel>
                <StackPanel Margin="0,0,0,12"><TextBlock Text="طريقة الدفع" Style="{StaticResource DetailLabel}"/><TextBlock x:Name="PaymentText" Style="{StaticResource DetailValue}"/></StackPanel>
                <StackPanel Margin="0,0,16,0"><TextBlock Text="حالة الأمر" Style="{StaticResource DetailLabel}"/><TextBlock x:Name="StatusText" Style="{StaticResource DetailValue}"/></StackPanel>
                <StackPanel Margin="0,0,16,0"><TextBlock Text="حالة الدفع" Style="{StaticResource DetailLabel}"/><TextBlock x:Name="PaymentStatusText" Style="{StaticResource DetailValue}"/></StackPanel>
                <StackPanel><TextBlock Text="تاريخ الدفع" Style="{StaticResource DetailLabel}"/><TextBlock x:Name="PaidDateText" Style="{StaticResource DetailValue}"/></StackPanel>
            </UniformGrid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource DetailCard}" Padding="12" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="تفاصيل الأصناف" Style="{StaticResource DetailValue}" Margin="4,0,4,10"/>
                <DataGrid x:Name="LinesGrid" Grid.Row="1" AutoGenerateColumns="False" Style="{StaticResource DetailsGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" ElementStyle="{StaticResource ProductValueTextStyle}" Width="2*" MinWidth="210"/>
                        <DataGridTextColumn Header="الوحدة" Binding="{Binding UnitName}" Width="*" MinWidth="85"/>
                        <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, StringFormat=N3}" ElementStyle="{StaticResource NumericCell}" Width="*" MinWidth="95"/>
                        <DataGridTextColumn Header="التكلفة" Binding="{Binding UnitCost, StringFormat=N3}" ElementStyle="{StaticResource NumericCell}" Width="*" MinWidth="95"/>
                        <DataGridTextColumn Header="الخصم" Binding="{Binding LineDiscountAmount, StringFormat=N3}" ElementStyle="{StaticResource NumericCell}" Width="*" MinWidth="90"/>
                        <DataGridTextColumn Header="نسبة الضريبة" Binding="{Binding TaxRate, StringFormat=N2}" ElementStyle="{StaticResource NumericCell}" Width="*" MinWidth="95"/>
                        <DataGridTextColumn Header="الضريبة" Binding="{Binding TaxAmount, StringFormat=N3}" ElementStyle="{StaticResource NumericCell}" Width="*" MinWidth="100"/>
                        <DataGridTextColumn Header="الانتهاء" Binding="{Binding ExpiryDate, StringFormat=dd/MM/yyyy, TargetNullValue=—}" Width="*" MinWidth="100"/>
                        <DataGridTextColumn Header="إجمالي السطر شامل الضريبة" Binding="{Binding LineTotal, StringFormat=N3}" ElementStyle="{StaticResource NumericCell}" Width="1.4*" MinWidth="185"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource DetailCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="قبل الضريبة (بعد خصم السطر)" Style="{StaticResource DetailLabel}" TextWrapping="Wrap"/><TextBlock x:Name="SubtotalText" Style="{StaticResource AmountValue}"/></StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource DetailCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="خصم أمر الشراء" Style="{StaticResource DetailLabel}"/><TextBlock x:Name="DiscountText" Style="{StaticResource AmountValue}"/></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource DetailCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="إجمالي الضريبة" Style="{StaticResource DetailLabel}"/><TextBlock x:Name="TaxText" Style="{StaticResource AmountValue}"/></StackPanel></Border>
                <Border Grid.Column="3" Background="{StaticResource AppPrimaryBrush}" CornerRadius="16" Padding="16"><StackPanel><TextBlock Text="الإجمالي المستحق" Foreground="#D4E9E2" FontSize="13" Margin="0,0,0,5"/><TextBlock x:Name="GrandTotalText" Style="{StaticResource AmountValue}" Foreground="White"/></StackPanel></Border>
            </Grid>
            <TextBlock x:Name="TaxBasisText" Style="{StaticResource DetailLabel}" Margin="4,7,4,0"/>
        </StackPanel>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Expander Header="الملاحظات والمتابعة" Foreground="{StaticResource AppMutedTextBrush}" Margin="0,0,16,0" VerticalAlignment="Top">
                <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6,8">
                        <TextBlock x:Name="NotesText" TextWrapping="Wrap"/>
                        <TextBlock x:Name="PaymentNoteText" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock x:Name="AuditText" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Expander>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="طباعة" Click="Print_Click" Style="{StaticResource AppHeroButtonStyle}" MinWidth="130" Margin="0,0,10,0"/>
                <Button Content="إغلاق" Click="Close_Click" Style="{StaticResource AppHeroButtonStyle}" Background="{StaticResource AppBlueBrush}" MinWidth="130"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
