<Window x:Class="RaccoonWarehouse.PurchaseOrders.PurchaseOrderDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Purchase Order Details / تفاصيل أمر الشراء"
        Height="760" Width="1120"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppPageBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Purchase Order Details / تفاصيل أمر الشراء"
                       FontSize="28" FontWeight="Bold"
                       Foreground="{StaticResource AppBlueBrush}"/>
            <TextBlock x:Name="OrderSummaryText"
                       Margin="0,6,0,0"
                       Foreground="{StaticResource AppMutedTextBrush}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="Supplier / المورد" FontWeight="SemiBold"/>
                <TextBlock x:Name="SupplierText" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                <TextBlock Text="Date / التاريخ" FontWeight="SemiBold"/>
                <TextBlock x:Name="DateText" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                <TextBlock Text="Payment term / طريقة الدفع" FontWeight="SemiBold"/>
                <TextBlock x:Name="PaymentText" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="3">
                <TextBlock Text="Status / الحالة" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusText" Margin="0,4,0,0" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>

        <DataGrid x:Name="LinesGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Product / المنتج" Binding="{Binding ProductName}" ElementStyle="{StaticResource ProductValueTextStyle}" Width="2*"/>
                <DataGridTextColumn Header="Unit / الوحدة" Binding="{Binding UnitName}" Width="1.1*"/>
                <DataGridTextColumn Header="Quantity / الكمية" Binding="{Binding Quantity, StringFormat=N3}" Width="1*"/>
                <DataGridTextColumn Header="Unit cost / التكلفة" Binding="{Binding UnitCost, StringFormat=N3}" Width="1*"/>
                <DataGridTextColumn Header="Discount / الخصم" Binding="{Binding LineDiscountAmount, StringFormat=N3}" Width="1*"/>
                <DataGridTextColumn Header="Tax / الضريبة" Binding="{Binding TaxAmount, StringFormat=N3}" Width="1*"/>
                <DataGridTextColumn Header="Expiry / الانتهاء" Binding="{Binding ExpiryDate, StringFormat=dd/MM/yyyy}" Width="1.2*"/>
                <DataGridTextColumn Header="Line total / الإجمالي" Binding="{Binding LineSubTotal, StringFormat=N3}" Width="1.2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock x:Name="NotesText" TextWrapping="Wrap" Foreground="{StaticResource AppMutedTextBrush}"/>
                <TextBlock x:Name="AuditText" Margin="0,6,0,0" Foreground="{StaticResource AppMutedTextBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock x:Name="TotalsText" TextAlignment="Right" FontSize="16" FontWeight="SemiBold"/>
                <Button Content="Close / إغلاق" Click="Close_Click" Padding="24,8" Margin="0,12,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
