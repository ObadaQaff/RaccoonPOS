<Window x:Class="RaccoonWarehouse.PurchaseOrders.PurchaseOrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Purchase Orders / أوامر الشراء"
        Height="720" Width="1200"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Background="{StaticResource AppPageBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Purchase Orders / أوامر الشراء" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AppBlueBrush}"/>
            <TextBlock Text="Review submitted orders and convert approved orders into purchase invoices." Margin="0,6,0,0" Foreground="{StaticResource AppMutedTextBrush}"/>
        </StackPanel>
        <DataGrid x:Name="OrdersGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" MouseDoubleClick="OrdersGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Number" Binding="{Binding OrderNumber}" Width="1.2*"/>
                <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="1.6*"/>
                <DataGridTextColumn Header="Date" Binding="{Binding DocumentDate, StringFormat=dd/MM/yyyy}" Width="1*"/>
                <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat=N3}" Width="1*"/>
                <DataGridTextColumn Header="Lines" Binding="{Binding LineCount}" Width="0.7*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1.1*"/>
                <DataGridTextColumn Header="Invoice" Binding="{Binding ConvertedInvoiceId}" Width="0.9*"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Refresh / تحديث" Click="Refresh_Click" Padding="18,8" Margin="0,0,10,0"/>
            <Button Content="View details / التفاصيل" Click="ViewDetails_Click" Padding="18,8" Margin="0,0,10,0"/>
            <Button x:Name="ApproveButton" Content="Approve and convert / اعتماد وتحويل" Click="Approve_Click" Padding="18,8" Background="{StaticResource AppBlueBrush}" Foreground="White"/>
            <Button x:Name="RejectButton" Content="Reject / رفض" Click="Reject_Click" Padding="18,8" Margin="10,0,0,0" Background="{StaticResource AppAccentBrush}"/>
        </StackPanel>
    </Grid>
</Window>
