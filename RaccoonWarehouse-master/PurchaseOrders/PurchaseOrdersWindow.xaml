<Window x:Class="RaccoonWarehouse.PurchaseOrders.PurchaseOrdersWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Purchase Order | أمر شراء" Height="900" Width="1450" MinHeight="720" MinWidth="1100" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Background="#EEF4F8">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button"><Setter Property="Padding" Value="18,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#17385F"/><Setter Property="Margin" Value="0,0,0,5"/></Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#17385F" CornerRadius="8" Padding="22,18" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PURCHASE ORDER FORM | نموذج أمر شراء" Foreground="White" FontSize="27" FontWeight="Bold"/><TextBlock Text="Review supplier orders, approval status, delivery, and purchasing totals." Foreground="#D9ECF8" Margin="0,7,0,0"/></StackPanel><Border Grid.Column="1" Background="#245985" CornerRadius="8" Padding="18,8" VerticalAlignment="Top"><TextBlock x:Name="SelectedStatusText" Text="PO status | الحالة: No order selected" Foreground="White" FontSize="16" FontWeight="Bold"/></Border></Grid></Border>
        <Border Grid.Row="1" Background="#F7FBFD" BorderBrush="#C9D8E5" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="PO No | رقم الأمر" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="SelectedOrderNumberText" Text="No order selected" FontSize="16"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Supplier | المورد" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="SelectedSupplierText" Text="—" FontSize="16"/></StackPanel><StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="Order date | التاريخ" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="SelectedDateText" Text="—" FontSize="16"/></StackPanel><StackPanel Grid.Column="3" Margin="0,0,12,0"><TextBlock Text="Payment term | طريقة الدفع" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="SelectedPaymentText" Text="—" FontSize="16"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Total amount | الإجمالي" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="SelectedTotalText" Text="0.000" FontSize="18" FontWeight="Bold" Foreground="#16735F"/></StackPanel></Grid></Border>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.95*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="White" BorderBrush="#C9D8E5" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,12,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="PURCHASE ORDERS | أوامر الشراء" Foreground="#17385F" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/><DataGrid x:Name="OrdersGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" SelectionChanged="OrdersGrid_SelectionChanged" MouseDoubleClick="OrdersGrid_MouseDoubleClick" RowHeight="34" BorderBrush="#D9E3EC"><DataGrid.Columns><DataGridTextColumn Header="PO No" Binding="{Binding OrderNumber}" Width="1.3*"/><DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="1.4*"/><DataGridTextColumn Header="Date" Binding="{Binding DocumentDate, StringFormat=dd/MM/yyyy}" Width="1*"/><DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat=N3}" Width="1*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1.2*"/></DataGrid.Columns></DataGrid></Grid></Border><Border Grid.Column="1" Background="White" BorderBrush="#C9D8E5" BorderThickness="1" CornerRadius="8" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="ORDERED PRODUCTS | أصناف أمر الشراء" Foreground="#17385F" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/><DataGrid x:Name="LinesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" RowHeight="36" BorderBrush="#D9E3EC"><DataGrid.Columns><DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="1.8*"/><DataGridTextColumn Header="Unit" Binding="{Binding UnitName}" Width="1*"/><DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, StringFormat=N3}" Width="1*"/><DataGridTextColumn Header="Unit cost" Binding="{Binding UnitCost, StringFormat=N3}" Width="1*"/><DataGridTextColumn Header="Discount" Binding="{Binding LineDiscountAmount, StringFormat=N3}" Width="1*"/><DataGridTextColumn Header="Tax" Binding="{Binding TaxAmount, StringFormat=N3}" Width="1*"/><DataGridTextColumn Header="Line total" Binding="{Binding LineSubTotal, StringFormat=N3}" Width="1.2*"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="2" Text="PO approval does not post inventory until receiving or invoice posting." Foreground="#6D7E8D" FontStyle="Italic" Margin="0,10,0,0"/></Grid></Border></Grid>
        <Grid Grid.Row="3" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button Content="↻  Refresh" Click="Refresh_Click" Style="{StaticResource ActionButton}" Background="#E5EEF5" Foreground="#17385F"/><Button Content="View details" Click="ViewDetails_Click" Style="{StaticResource ActionButton}" Background="#245985" Foreground="White"/><Button x:Name="ApproveButton" Content="Approve" Click="Approve_Click" Style="{StaticResource ActionButton}" Background="#16735F" Foreground="White"/><Button x:Name="RejectButton" Content="Reject" Click="Reject_Click" Style="{StaticResource ActionButton}" Background="#B6434B" Foreground="White"/></StackPanel><Border Grid.Column="1" Background="#FFF1D6" BorderBrush="#EACB8A" BorderThickness="1" CornerRadius="6" Padding="16,8"><TextBlock Text="PO approval | اعتماد الأمر: Pending" Foreground="#815D17" FontWeight="SemiBold"/></Border></Grid>
    </Grid>
</Window>
