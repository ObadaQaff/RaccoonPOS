<Window x:Class="RaccoonWarehouse.Accounting.PartyBalanceReport"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RaccoonWarehouse.Accounting"
        Title="Accounts Balances" Height="820" Width="1350"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft"
        Background="{StaticResource AppPageBackgroundBrush}">
    <Window.Resources>
        <local:PartyBalanceColorConverter x:Key="PartyBalanceColorConverter"/>
    </Window.Resources>
    <Grid Background="{StaticResource AppPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="145"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" CornerRadius="0,0,34,34" Background="{StaticResource AppDashboardHeroBrush}">
            <Grid Margin="34,16,34,20">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,285,0">
                    <TextBlock x:Name="TitleText" Foreground="White" FontSize="28" FontWeight="Bold"/>
                    <TextBlock x:Name="SubtitleText" Foreground="#D6E7E2" FontSize="14" Margin="0,5,0,0"/>
                </StackPanel>
                <Border HorizontalAlignment="Left" VerticalAlignment="Center" Background="#1FFFFFFF" CornerRadius="20" Padding="22,14">
                    <StackPanel>
                        <TextBlock x:Name="TotalLabelText" Foreground="#CFE8E3" FontSize="13" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TotalOutstandingText" Text="0.00" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="24,-28,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource AppCardBorderStyle}" Padding="22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock x:Name="AsOfLabelText" FontWeight="SemiBold"/>
                        <DatePicker x:Name="AsOfDatePicker" Height="40" Margin="0,8,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock x:Name="SearchLabelText" FontWeight="SemiBold"/>
                        <TextBox x:Name="SearchTextBox" Height="40" Margin="0,8,0,0" Padding="8"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" x:Name="RoleFilterPanel" Margin="0,0,14,0">
                        <TextBlock x:Name="RoleFilterLabelText" FontWeight="SemiBold"/>
                        <ComboBox x:Name="RoleFilterComboBox" Height="40" Margin="0,8,0,0" SelectedValuePath="Tag" SelectedValue="all">
                            <ComboBoxItem Tag="all" Content="All"/>
                            <ComboBoxItem Tag="customer" Content="Customer"/>
                            <ComboBoxItem Tag="supplier" Content="Supplier"/>
                        </ComboBox>
                    </StackPanel>
                    <CheckBox x:Name="OutstandingOnlyCheckBox" IsChecked="False" Visibility="Collapsed"/>
                    <StackPanel Grid.Column="3" Margin="0,0,14,0">
                        <TextBlock x:Name="BalanceFilterLabelText" FontWeight="SemiBold"/>
                        <ComboBox x:Name="BalanceFilterComboBox" Height="40" Margin="0,8,0,0" SelectedValuePath="Tag" SelectedValue="all">
                            <ComboBoxItem Tag="all" Content="All"/>
                            <ComboBoxItem Tag="positive" Content="More than zero"/>
                            <ComboBoxItem Tag="zero" Content="Equal to zero"/>
                            <ComboBoxItem Tag="negative" Content="Less than zero"/>
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Grid.Column="4" x:Name="CountText" VerticalAlignment="Bottom" Margin="0,0,0,11" Foreground="#6B7280"/>
                    <Button Grid.Column="4" x:Name="GenerateButton" Width="160" Height="42" VerticalAlignment="Bottom" Style="{StaticResource AppHeroButtonStyle}" Click="GenerateButton_Click"/>
                    <Button Grid.Column="5" x:Name="ExportExcelButton" Width="145" Height="42" Margin="10,0,0,0" VerticalAlignment="Bottom" Style="{StaticResource AppSecondaryButtonStyle}" Click="ExportExcelButton_Click"/>
                    <Button Grid.Column="6" x:Name="PrintButton" Width="110" Height="42" Margin="10,0,0,0" VerticalAlignment="Bottom" Style="{StaticResource AppSecondaryButtonStyle}" Click="PrintButton_Click"/>
                </Grid>
            </Border>
            <Border Grid.Row="1" Margin="0,18,0,0" Style="{StaticResource AppCardBorderStyle}" Padding="16">
                <DataGrid x:Name="ReportGrid" Style="{StaticResource AppModernDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" SelectionMode="Single" MouseDoubleClick="ReportGrid_MouseDoubleClick"
                          SelectionChanged="ReportGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="PartyTypeColumn" Binding="{Binding RoleLabel}" Width="170"/>
                        <DataGridTextColumn x:Name="NameColumn" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn x:Name="PhoneColumn" Binding="{Binding PhoneNumber}" Width="180"/>
                        <DataGridTextColumn x:Name="DebitColumn" Binding="{Binding TotalDebit, StringFormat=N2}" Width="150"/>
                        <DataGridTextColumn x:Name="CreditColumn" Binding="{Binding TotalCredit, StringFormat=N2}" Width="150"/>
                        <DataGridTemplateColumn x:Name="BalanceColumn" Header="Outstanding balance" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Balance, StringFormat=N2}"
                                               TextAlignment="Right"
                                               Foreground="{Binding Balance, Converter={StaticResource PartyBalanceColorConverter}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:Name="LastMovementColumn" Binding="{Binding LastMovementDate, StringFormat=yyyy-MM-dd}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <TextBlock x:Name="HintText" Foreground="#6B7280" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="ReceivePaymentButton" Width="170" Height="40" Margin="10,0,0,0"
                            IsEnabled="False" Style="{StaticResource AppHeroButtonStyle}" Click="ReceivePaymentButton_Click"/>
                    <Button x:Name="CloseButton" Width="120" Height="40" Style="{StaticResource AppSecondaryButtonStyle}" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
