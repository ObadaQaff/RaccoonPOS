<Window x:Class="RaccoonWarehouse.Accounting.TrialBalanceReport"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Title="ميزان المراجعة"
        Height="900"
        Width="1450"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{StaticResource AppPageBackgroundBrush}">
    <ScrollViewer x:Name="TrialBalancePageScrollViewer"
                  PreviewMouseWheel="TrialBalancePageScrollViewer_PreviewMouseWheel"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">
    <Grid Background="{StaticResource AppPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="220"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" CornerRadius="0,0,34,34" Background="{StaticResource AppDashboardHeroBrush}">
            <Grid Margin="34,24,34,34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ميزان المراجعة" FontSize="34" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="مراجعة الأرصدة الافتتاحية والحركة وصافي الرصيد لكل حساب." Margin="0,8,0,0" FontSize="16" Foreground="#D6E7E2"/>
                </StackPanel>
                <Border Grid.Column="1" Padding="18,12" CornerRadius="20" Background="#1FFFFFFF" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="التقرير" FontSize="12" Foreground="#CFE8E3" HorizontalAlignment="Center"/>
                        <TextBlock Text="محاسبي" Margin="0,4,0,0" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="24,-52,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource AppCardBorderStyle}" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="من تاريخ" FontWeight="SemiBold"/>
                        <DatePicker x:Name="FromDatePicker" Margin="0,8,0,0" Height="40"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="إلى تاريخ" FontWeight="SemiBold"/>
                        <DatePicker x:Name="ToDatePicker" Margin="0,8,0,0" Height="40"/>
                    </StackPanel>
                    <CheckBox x:Name="IncludeZeroCheckBox" Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,16,8" Content="إظهار الحسابات الصفرية"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                        <Button Width="180" Style="{StaticResource AppHeroButtonStyle}" Click="GenerateBtn_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <fa:ImageAwesome Icon="Table" Width="16" Height="16" Margin="0,0,8,0"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="عرض التقرير"/>
                            </StackPanel>
                        </Button>
                        <Button Width="120" Style="{StaticResource AppSecondaryButtonStyle}" Click="BackBtn_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <fa:ImageAwesome Icon="ArrowRight" Width="16" Height="16" Margin="0,0,8,0"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="رجوع"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,18,0,0">
                <Border Style="{StaticResource AppCardBorderStyle}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="إجمالي مدين" Foreground="#6B7280"/>
                        <TextBlock x:Name="TotalDebitText" FontSize="24" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource AppCardBorderStyle}" Padding="18" Margin="12,0">
                    <StackPanel>
                        <TextBlock Text="إجمالي دائن" Foreground="#6B7280"/>
                        <TextBlock x:Name="TotalCreditText" FontSize="24" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource AppCardBorderStyle}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="الحالة" Foreground="#6B7280"/>
                        <TextBlock x:Name="BalancedText" FontSize="24" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <Border Grid.Row="2" Margin="0,18,0,0" Style="{StaticResource AppCardBorderStyle}" Padding="16" Grid.IsSharedSizeScope="True">
                <StackPanel>
                    <Grid Margin="24,0,0,8">
                        <Grid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="15"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" SharedSizeGroup="AccountCode"/>
                            <ColumnDefinition Width="260" SharedSizeGroup="AccountName"/>
                            <ColumnDefinition Width="140" SharedSizeGroup="AccountType"/>
                            <ColumnDefinition Width="150" SharedSizeGroup="Opening"/>
                            <ColumnDefinition Width="150" SharedSizeGroup="Debit"/>
                            <ColumnDefinition Width="150" SharedSizeGroup="Credit"/>
                            <ColumnDefinition Width="150" SharedSizeGroup="ClosingDebit"/>
                            <ColumnDefinition Width="150" SharedSizeGroup="ClosingCredit"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="الرمز" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="الحساب" FontWeight="Bold"/>
                        <TextBlock Grid.Column="2" Text="النوع" FontWeight="Bold"/>
                        <TextBlock Grid.Column="3" Text="رصيد افتتاحي" FontWeight="Bold"/>
                        <TextBlock Grid.Column="4" Text="مدين الفترة" FontWeight="Bold"/>
                        <TextBlock Grid.Column="5" Text="دائن الفترة" FontWeight="Bold"/>
                        <TextBlock Grid.Column="6" Text="رصيد مدين" FontWeight="Bold"/>
                        <TextBlock Grid.Column="7" Text="رصيد دائن" FontWeight="Bold"/>
                    </Grid>
                    <TreeView x:Name="TrialBalanceTree"
                          Background="Transparent"
                          BorderThickness="0"
                          MouseDoubleClick="TrialBalanceTree_MouseDoubleClick"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate x:Key="TrialBalanceRowTemplate" ItemsSource="{Binding Children}">
                            <Grid Margin="0,4" MinHeight="42">
                                <Grid.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="16"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </Grid.Resources>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" SharedSizeGroup="AccountCode"/>
                                    <ColumnDefinition Width="260" SharedSizeGroup="AccountName"/>
                                    <ColumnDefinition Width="140" SharedSizeGroup="AccountType"/>
                                    <ColumnDefinition Width="150" SharedSizeGroup="Opening"/>
                                    <ColumnDefinition Width="150" SharedSizeGroup="Debit"/>
                                    <ColumnDefinition Width="150" SharedSizeGroup="Credit"/>
                                    <ColumnDefinition Width="150" SharedSizeGroup="ClosingDebit"/>
                                    <ColumnDefinition Width="150" SharedSizeGroup="ClosingCredit"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding AccountCode}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding AccountName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{Binding AccountTypeLabel}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding OpeningBalance, StringFormat=N2}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{Binding Debit, StringFormat=N2}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="{Binding Credit, StringFormat=N2}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="6" Text="{Binding ClosingDebit, StringFormat=N2}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="7" Text="{Binding ClosingCredit, StringFormat=N2}" VerticalAlignment="Center"/>
                            </Grid>
                        </HierarchicalDataTemplate>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="IsExpanded" Value="False"/>
                        </Style>
                    </TreeView.Resources>
                    <TreeView.ItemTemplate>
                        <StaticResource ResourceKey="TrialBalanceRowTemplate"/>
                    </TreeView.ItemTemplate>
                    </TreeView>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
    </ScrollViewer>
</Window>
