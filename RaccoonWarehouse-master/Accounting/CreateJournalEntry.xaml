<Window x:Class="RaccoonWarehouse.Accounting.CreateJournalEntry"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        mc:Ignorable="d"
        Title="قيد يومية يدوي"
        Height="900"
        Width="1400"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{StaticResource AppPageBackgroundBrush}">
    <Grid Background="{StaticResource AppPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="220"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" CornerRadius="0,0,34,34" Background="{StaticResource AppDashboardHeroBrush}">
            <Grid Margin="34,24,34,34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="قيد يومية يدوي" FontSize="34" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="إنشاء قيد متوازن وترحيله مباشرة." Margin="0,8,0,0" FontSize="16" Foreground="#D6E7E2"/>
                </StackPanel>
                <Border Grid.Column="1" Padding="18,12" CornerRadius="20" Background="#1FFFFFFF" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="النوع" FontSize="12" Foreground="#CFE8E3" HorizontalAlignment="Center"/>
                        <TextBlock Text="يدوي" Margin="0,4,0,0" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="24,-52,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource AppCardBorderStyle}" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="الوصف" FontWeight="SemiBold"/>
                        <TextBox x:Name="DescriptionTextBox" Margin="0,8,0,0" Height="40" Padding="12,8"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="تاريخ القيد" FontWeight="SemiBold"/>
                        <DatePicker x:Name="EntryDatePicker" Margin="0,8,0,0" Height="40"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="1" Margin="0,18,0,0" Style="{StaticResource AppCardBorderStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="LinesGrid" Style="{StaticResource AppModernDataGridStyle}" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridComboBoxColumn Header="الحساب"
                                                    Width="280"
                                                    SelectedValueBinding="{Binding AccountId, UpdateSourceTrigger=PropertyChanged}"
                                                    SelectedValuePath="Id"
                                                    DisplayMemberPath="DisplayLabel"
                                                    ItemsSource="{Binding AccountsSource, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <DataGridTextColumn Header="مدين" Width="140" Binding="{Binding Debit, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="دائن" Width="140" Binding="{Binding Credit, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="الوصف" Width="*" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
                        <Button Width="130" Style="{StaticResource AppSecondaryButtonStyle}" Click="AddLineBtn_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <fa:ImageAwesome Icon="Plus" Width="14" Height="14" Margin="0,0,8,0"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="إضافة سطر"/>
                            </StackPanel>
                        </Button>
                        <Button Width="140" Style="{StaticResource AppSecondaryButtonStyle}" Click="RemoveLineBtn_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <fa:ImageAwesome Icon="Trash" Width="14" Height="14" Margin="0,0,8,0"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="حذف سطر"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Margin="24,0,24,24" Style="{StaticResource AppCardBorderStyle}" Padding="24">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock x:Name="TotalsTextBlock" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Margin="0,0,24,0"/>
                    <Button Width="170" Style="{StaticResource AppHeroButtonStyle}" Click="PostBtn_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <fa:ImageAwesome Icon="Check" Width="16" Height="16" Margin="0,0,8,0"
                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="ترحيل القيد"/>
                        </StackPanel>
                    </Button>
                    <Button Width="120" Style="{StaticResource AppSecondaryButtonStyle}" Click="BackBtn_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <fa:ImageAwesome Icon="ArrowRight" Width="16" Height="16" Margin="0,0,8,0"
                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="رجوع"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
