<Window x:Class="RaccoonWarehouse.Accounting.AccountingFeatureSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Title="إعدادات نظام المحاسبة"
        Width="820"
        Height="560"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{StaticResource AppPageBackgroundBrush}">
    <Grid Background="{StaticResource AppPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="180"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="0,0,34,34" Background="{StaticResource AppDashboardHeroBrush}">
            <Grid Margin="34,24,34,34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="إعدادات المحاسبة" FontSize="34" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="التحكم في تفعيل الوحدة وتاريخ قفل الترحيل للمحافظة على سلامة الفترات المقفلة."
                               Margin="0,8,0,0"
                               FontSize="16"
                               Foreground="#D6E7E2"/>
                </StackPanel>
                <Border Grid.Column="1" Padding="18,12" CornerRadius="20" Background="#1FFFFFFF" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="الضبط" FontSize="12" Foreground="#CFE8E3" HorizontalAlignment="Center"/>
                        <TextBlock Text="مركزي" Margin="0,4,0,0" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,-52,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource AppCardBorderStyle}" Padding="28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Padding="18" CornerRadius="18" Background="#F5F8F7" BorderBrush="#D9E2DE" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="تشغيل وحدة المحاسبة" FontSize="22" FontWeight="Bold" Foreground="#183C36"/>
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="{StaticResource AppMutedTextBrush}"
                                       Text="عند الإيقاف يتم إخفاء واجهات المحاسبة ومنع استخدامها مع الاحتفاظ بالبيانات الحالية."/>
                            <CheckBox x:Name="EnabledCheckBox" Margin="0,18,0,0" Content="نظام المحاسبة مفعل" FontSize="18"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Margin="0,22,0,0" Padding="18" CornerRadius="18" Background="#F5F8F7" BorderBrush="#D9E2DE" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,18,0">
                                <TextBlock Text="تاريخ قفل الترحيل" FontSize="22" FontWeight="Bold" Foreground="#183C36"/>
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{StaticResource AppMutedTextBrush}"
                                           Text="يمنع ترحيل أي قيد بتاريخ يساوي أو يسبق هذا التاريخ. اتركه فارغاً لعدم وجود قفل."/>
                                <DatePicker x:Name="PostingLockDatePicker" Margin="0,18,0,0" Height="42"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Width="150"
                                    Height="42"
                                    VerticalAlignment="Bottom"
                                    Style="{StaticResource AppSecondaryButtonStyle}"
                                    Click="ClearPostingLockDate_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <fa:ImageAwesome Icon="Eraser" Width="15" Height="15" Margin="0,0,8,0"
                                                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Text="مسح التاريخ"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="0,18,0,0" Style="{StaticResource AppCardBorderStyle}" Padding="24">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Width="150" Style="{StaticResource AppHeroButtonStyle}" Click="Save_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <fa:ImageAwesome Icon="Save" Width="15" Height="15" Margin="0,0,8,0"
                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="حفظ"/>
                        </StackPanel>
                    </Button>
                    <Button Width="130" Style="{StaticResource AppSecondaryButtonStyle}" Click="Close_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <fa:ImageAwesome Icon="ArrowRight" Width="15" Height="15" Margin="0,0,8,0"
                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="إغلاق"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
