<Window x:Class="RaccoonWarehouse.Accounting.BalanceSheetReport"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Title="الميزانية العمومية"
        Height="920"
        Width="1500"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{StaticResource AppPageBackgroundBrush}">
    <Grid Background="{StaticResource AppPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="220"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" CornerRadius="0,0,34,34" Background="{StaticResource AppDashboardHeroBrush}">
            <Grid Margin="34,24,34,34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="الميزانية العمومية" FontSize="34" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="صورة محاسبية للأصول والالتزامات وحقوق الملكية حتى تاريخ محدد." Margin="0,8,0,0" FontSize="16" Foreground="#D6E7E2"/>
                </StackPanel>
                <Border Grid.Column="1" Padding="18,12" CornerRadius="20" Background="#1FFFFFFF" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="التقرير" FontSize="12" Foreground="#CFE8E3" HorizontalAlignment="Center"/>
                        <TextBlock Text="مالي" Margin="0,4,0,0" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="24,-52,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource AppCardBorderStyle}" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="حتى تاريخ" FontWeight="SemiBold"/>
                        <DatePicker x:Name="AsOfDatePicker" Margin="0,8,0,0" Height="40"/>
                    </StackPanel>
                    <CheckBox x:Name="IncludeZeroCheckBox" Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,16,8" Content="إظهار الحسابات الصفرية"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                        <Button Width="180" Style="{StaticResource AppHeroButtonStyle}" Click="GenerateBtn_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <fa:ImageAwesome Icon="LineChart" Width="16" Height="16" Margin="0,0,8,0"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="عرض التقرير"/>
                            </StackPanel>
                        </Button>
                        <Button Width="120" Style="{StaticResource AppSecondaryButtonStyle}" Click="BackBtn_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <fa:ImageAwesome Icon="ArrowRight" Width="16" Height="16" Margin="0,0,8,0"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="رجوع"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,18,0,0">
                <Border Style="{StaticResource AppCardBorderStyle}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="إجمالي الأصول" Foreground="#6B7280"/>
                        <TextBlock x:Name="AssetsTotalText" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource AppCardBorderStyle}" Padding="18" Margin="12,0">
                    <StackPanel>
                        <TextBlock Text="إجمالي الالتزامات" Foreground="#6B7280"/>
                        <TextBlock x:Name="LiabilitiesTotalText" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource AppCardBorderStyle}" Padding="18" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="إجمالي حقوق الملكية" Foreground="#6B7280"/>
                        <TextBlock x:Name="EquityTotalText" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource AppCardBorderStyle}" Padding="18">
                    <StackPanel>
                        <TextBlock Text="الالتزامات + الملكية" Foreground="#6B7280"/>
                        <TextBlock x:Name="LiabilitiesAndEquityText" FontSize="22" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource AppCardBorderStyle}" Padding="16" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="الأصول" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                        <DataGrid Grid.Row="1" x:Name="AssetsGrid" Style="{StaticResource AppModernDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الرمز" Binding="{Binding AccountCode}" Width="100"/>
                                <DataGridTextColumn Header="الحساب" Binding="{Binding AccountName}" Width="*"/>
                                <DataGridTextColumn Header="الرصيد" Binding="{Binding Balance, StringFormat=N2}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource AppCardBorderStyle}" Padding="16" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="الالتزامات" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                        <DataGrid Grid.Row="1" x:Name="LiabilitiesGrid" Style="{StaticResource AppModernDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الرمز" Binding="{Binding AccountCode}" Width="100"/>
                                <DataGridTextColumn Header="الحساب" Binding="{Binding AccountName}" Width="*"/>
                                <DataGridTextColumn Header="الرصيد" Binding="{Binding Balance, StringFormat=N2}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource AppCardBorderStyle}" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="حقوق الملكية" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                        <DataGrid Grid.Row="1" x:Name="EquityGrid" Style="{StaticResource AppModernDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الرمز" Binding="{Binding AccountCode}" Width="100"/>
                                <DataGridTextColumn Header="الحساب" Binding="{Binding AccountName}" Width="*"/>
                                <DataGridTextColumn Header="الرصيد" Binding="{Binding Balance, StringFormat=N2}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
