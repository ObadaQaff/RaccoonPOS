<Window x:Class="RaccoonWarehouse.FinancialTransactions.Reports.InvoicePaymentMethodsReport"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Invoice Payment Methods" Height="800" Width="1400"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="#F2F6FA" FlowDirection="RightToLeft">
    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2D8DCF"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="16,8"/><Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#E3EAF0"/><Setter Property="Foreground" Value="#2D8DCF"/>
        </Style>
        <Style x:Key="ReportGridStyle" TargetType="DataGrid">
            <Setter Property="RowHeight" Value="38"/><Setter Property="ColumnHeaderHeight" Value="44"/>
            <Setter Property="FontSize" Value="14"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#DDE5EC"/><Setter Property="Background" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F7FAFD"/><Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/><Setter Property="AutoGenerateColumns" Value="False"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#2D8DCF" CornerRadius="12" Padding="14" Margin="0,0,0,12">
            <TextBlock x:Name="TitleText" Text="Invoice Payment Methods" Foreground="White" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Border>
        <Border Grid.Row="1" Background="White" BorderBrush="#D0D7DD" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="6,0"><TextBlock x:Name="FromLabel" Text="From date" FontWeight="SemiBold"/><DatePicker x:Name="FromDatePicker" Height="36"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="6,0"><TextBlock x:Name="ToLabel" Text="To date" FontWeight="SemiBold"/><DatePicker x:Name="ToDatePicker" Height="36"/></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0">
                    <TextBlock x:Name="CountLabel" Text="Invoices:" VerticalAlignment="Center" Foreground="#667"/><TextBlock x:Name="CountText" Text="0" VerticalAlignment="Center" FontWeight="Bold" Margin="6,0,18,0"/>
                    <TextBlock x:Name="TotalLabel" Text="Total:" VerticalAlignment="Center" Foreground="#667"/><TextBlock x:Name="TotalText" Text="0.00000" VerticalAlignment="Center" FontWeight="Bold" Margin="6,0"/>
                </StackPanel>
                <Button Grid.Column="3" x:Name="GenerateButton" Content="Show report" Style="{StaticResource PrimaryButtonStyle}" Click="GenerateButton_Click" Margin="6,0"/>
                <Button Grid.Column="4" x:Name="BackButton" Content="Back" Style="{StaticResource SecondaryButtonStyle}" Click="BackButton_Click" Margin="6,0"/>
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#D0D7DD" BorderThickness="1" CornerRadius="12" Padding="10">
            <DataGrid x:Name="InvoicePaymentsGrid" Style="{StaticResource ReportGridStyle}" MouseDoubleClick="InvoicePaymentsGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="InvoiceNumberColumn" Header="Invoice" Binding="{Binding InvoiceNumber}" Width="110"/>
                    <DataGridTextColumn x:Name="DateColumn" Header="Date" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="125"/>
                    <DataGridTextColumn x:Name="CustomerColumn" Header="Customer" Binding="{Binding CustomerName}" Width="190"/>
                    <DataGridTextColumn x:Name="CashierColumn" Header="Cashier" Binding="{Binding CashierName}" Width="150"/>
                    <DataGridTextColumn x:Name="InvoiceTotalColumn" Header="Invoice total" Binding="{Binding InvoiceTotal, StringFormat=0.00000}" Width="135"/>
                    <DataGridTextColumn x:Name="CashColumn" Header="Cash" Binding="{Binding CashAmount, StringFormat=0.00000}" Width="115"/>
                    <DataGridTextColumn x:Name="VisaColumn" Header="Visa" Binding="{Binding VisaAmount, StringFormat=0.00000}" Width="115"/>
                    <DataGridTextColumn x:Name="MasterColumn" Header="Master" Binding="{Binding MasterAmount, StringFormat=0.00000}" Width="115"/>
                    <DataGridTextColumn x:Name="DebitColumn" Header="Debit" Binding="{Binding DebitAmount, StringFormat=0.00000}" Width="115"/>
                    <DataGridTextColumn x:Name="CheckColumn" Header="Check" Binding="{Binding CheckAmount, StringFormat=0.00000}" Width="115"/>
                    <DataGridTextColumn x:Name="MobileColumn" Header="Mobile" Binding="{Binding MobileAmount, StringFormat=0.00000}" Width="115"/>
                    <DataGridTextColumn x:Name="CreditColumn" Header="Credit" Binding="{Binding CreditAmount, StringFormat=0.00000}" Width="115"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Border Grid.Row="3" Background="#E8EEF3" CornerRadius="12" Padding="10" Margin="0,12,0,0"><TextBlock Text="© 2026 Raccoon Warehouse" HorizontalAlignment="Center" Foreground="#416784"/></Border>
    </Grid>
</Window>
