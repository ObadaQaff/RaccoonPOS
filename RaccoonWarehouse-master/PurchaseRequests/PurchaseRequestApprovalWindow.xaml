<Window xmlns:security="clr-namespace:RaccoonWarehouse.Security" x:Class="RaccoonWarehouse.PurchaseRequests.PurchaseRequestApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Approve Purchase Request"
        Height="760" Width="1350" MinHeight="560" MinWidth="1000"
        WindowStartupLocation="CenterScreen" Background="#EEF4F8"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#17385F" CornerRadius="8" Padding="22,18" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="PURCHASE REQUEST APPROVAL" Foreground="White" FontSize="27" FontWeight="Bold"/>
                    <TextBlock Text="Review quantities and prices before approving the request." Foreground="#D9ECF8" Margin="0,7,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#245985" CornerRadius="8" Padding="18,8" VerticalAlignment="Top">
                    <TextBlock x:Name="RequestSummaryText" Text="Loading..." Foreground="White" FontSize="16" FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#C9D8E5" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,14,10"><TextBlock Text="PR number" Foreground="#17385F" FontWeight="SemiBold"/><TextBlock x:Name="RequestNumberText" Text="-" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,14,10"><TextBlock Text="Request date" Foreground="#17385F" FontWeight="SemiBold"/><TextBlock x:Name="RequestDateText" Text="-" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,14,10"><TextBlock Text="Requested by" Foreground="#17385F" FontWeight="SemiBold"/><TextBlock x:Name="RequesterText" Text="-" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,0,10"><TextBlock Text="Submitted by" Foreground="#17385F" FontWeight="SemiBold"/><TextBlock x:Name="SubmittedByText" Text="-" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,14,10"><TextBlock Text="Submitted date" Foreground="#17385F" FontWeight="SemiBold"/><TextBlock x:Name="SubmittedDateText" Text="-" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,14,10"><TextBlock Text="Category" Foreground="#17385F" FontWeight="SemiBold"/><TextBlock x:Name="CategoryText" Text="-" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,14,10"><TextBlock Text="Department" Foreground="#17385F" FontWeight="SemiBold"/><TextBlock x:Name="DepartmentText" Text="-" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,0,10"><TextBlock Text="Priority" Foreground="#17385F" FontWeight="SemiBold"/><TextBlock x:Name="PriorityText" Text="-" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="4"><TextBlock Text="Notes" Foreground="#17385F" FontWeight="SemiBold"/><TextBlock x:Name="RequestNotesText" Text="-" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#C9D8E5" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock Text="Overall review note / ملاحظة المراجعة" Foreground="#17385F" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,7,16,0"/>
                <TextBox x:Name="ReviewNotesTextBox" Grid.Column="1" MinHeight="58" Padding="8" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="#FFF1D6" BorderBrush="#EACB8A" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,14">
            <TextBlock Text="Approved quantity and price are initialized from the request. Check Reject for lines that should not be purchased." Foreground="#815D17" FontWeight="SemiBold"/>
        </Border>

        <Border Grid.Row="4" Background="White" BorderBrush="#C9D8E5" BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DataGrid x:Name="LinesGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" RowHeight="42" BorderBrush="#D9E3EC">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" IsReadOnly="True" Width="1.2*"/>
                        <DataGridTextColumn Header="Item name" Binding="{Binding ItemName}" IsReadOnly="True" Width="2*"/>
                        <DataGridTextColumn Header="Requested qty" Binding="{Binding RequestedQuantity, StringFormat=N3}" IsReadOnly="True" Width="1*"/>
                        <DataGridTextColumn Header="Approved qty" Binding="{Binding ApprovedQuantity, StringFormat=N3, UpdateSourceTrigger=PropertyChanged}" Width="1*"/>
                        <DataGridTextColumn Header="Requested price" Binding="{Binding RequestedUnitPrice, StringFormat=N3}" IsReadOnly="True" Width="1*"/>
                        <DataGridTextColumn Header="Approved price" Binding="{Binding ApprovedUnitPrice, StringFormat=N3, UpdateSourceTrigger=PropertyChanged}" Width="1*"/>
                        <DataGridTemplateColumn Header="Reject" Width="0.8*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsRejected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Approval note" Binding="{Binding ApprovalNotes, UpdateSourceTrigger=PropertyChanged}" Width="1.8*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="1" Background="#F7FBFD" BorderBrush="#D9E3EC" BorderThickness="0,1,0,0" Padding="12,9">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Requested total:" Foreground="#17385F" FontWeight="SemiBold" Margin="0,0,6,0"/>
                        <TextBlock x:Name="RequestedTotalText" Text="0.000" Foreground="#17385F" FontWeight="Bold" Margin="0,0,20,0"/>
                        <TextBlock Text="Approved total:" Foreground="#16735F" FontWeight="SemiBold" Margin="0,0,6,0"/>
                        <TextBlock x:Name="ApprovedTotalText" Text="0.000" Foreground="#16735F" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="5" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Approve" Click="Approve_Click" Style="{StaticResource ActionButton}" Background="#16735F" Foreground="White" security:PermissionWindowGuard.Keys="PurchaseRequest.Approve"/>
                <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource ActionButton}" Background="#E5EEF5" Foreground="#17385F"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
