<Window x:Class="RaccoonWarehouse.PurchaseRequests.PurchaseRequestDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Purchase Request Details"
        Height="820" Width="1450" MinHeight="620" MinWidth="1050"
        WindowStartupLocation="CenterScreen" Background="#EEF4F8"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#17385F"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#17385F" CornerRadius="8" Padding="22,18" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="PURCHASE REQUEST DETAILS" Foreground="White" FontSize="27" FontWeight="Bold"/>
                    <TextBlock Text="Read-only view of the request and its approval history." Foreground="#D9ECF8" Margin="0,7,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#245985" CornerRadius="8" Padding="18,8" VerticalAlignment="Top">
                    <TextBlock x:Name="SummaryText" Text="Loading..." Foreground="White" FontSize="16" FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#C9D8E5" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,14,10"><TextBlock Text="PR number" Style="{StaticResource Label}"/><TextBlock x:Name="RequestNumberText" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,14,10"><TextBlock Text="Status" Style="{StaticResource Label}"/><TextBlock x:Name="StatusText" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,14,10"><TextBlock Text="Category" Style="{StaticResource Label}"/><TextBlock x:Name="CategoryText" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,0,10"><TextBlock Text="Request date" Style="{StaticResource Label}"/><TextBlock x:Name="RequestDateText" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,14,10"><TextBlock Text="Requested by" Style="{StaticResource Label}"/><TextBlock x:Name="RequesterText" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,14,10"><TextBlock Text="Submitted by / date" Style="{StaticResource Label}"/><TextBlock x:Name="SubmittedText" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,14,10"><TextBlock Text="Approved by / date" Style="{StaticResource Label}"/><TextBlock x:Name="ApprovedText" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,0,10"><TextBlock Text="Rejected by / date" Style="{StaticResource Label}"/><TextBlock x:Name="RejectedText" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,14,0"><TextBlock Text="Department" Style="{StaticResource Label}"/><TextBlock x:Name="DepartmentText" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,14,0"><TextBlock Text="Priority" Style="{StaticResource Label}"/><TextBlock x:Name="PriorityText" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2"><TextBlock Text="Notes / rejection reason" Style="{StaticResource Label}"/><TextBlock x:Name="NotesText" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                <StackPanel Grid.Row="3" Grid.ColumnSpan="4"><TextBlock Text="Review note" Style="{StaticResource Label}"/><TextBlock x:Name="ReviewNotesText" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#C9D8E5" BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DataGrid x:Name="LinesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" RowHeight="38" BorderBrush="#D9E3EC">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="1.1*"/>
                        <DataGridTextColumn Header="Item name" Binding="{Binding ItemName}" Width="2*"/>
                        <DataGridTextColumn Header="Unit" Binding="{Binding UnitName}" Width="0.9*"/>
                        <DataGridTextColumn Header="Requested qty" Binding="{Binding RequestedQuantity, StringFormat=N3}" Width="1*"/>
                        <DataGridTextColumn Header="Unit price" Binding="{Binding UnitPrice, StringFormat=N3}" Width="1*"/>
                        <DataGridTextColumn Header="Approved qty" Binding="{Binding ApprovedQuantity, StringFormat=N3}" Width="1*"/>
                        <DataGridTextColumn Header="Approved price" Binding="{Binding ApprovedUnitPrice, StringFormat=N3}" Width="1*"/>
                        <DataGridTextColumn Header="Decision" Binding="{Binding Decision}" Width="1*"/>
                        <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="1.2*"/>
                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="1.5*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="1" Background="#F7FBFD" BorderBrush="#D9E3EC" BorderThickness="0,1,0,0" Padding="12,9">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Total amount:" Style="{StaticResource Label}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TotalAmountText" Foreground="#17385F" FontWeight="Bold" Margin="0,0,20,0"/>
                        <TextBlock Text="Approved total:" Foreground="#16735F" FontWeight="SemiBold" Margin="0,0,6,0"/>
                        <TextBlock x:Name="ApprovedTotalText" Foreground="#16735F" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Close" Click="Close_Click" Style="{StaticResource ActionButton}" Background="#E5EEF5" Foreground="#17385F"/>
        </StackPanel>
    </Grid>
</Window>
