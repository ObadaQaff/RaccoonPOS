<Window x:Class="RaccoonWarehouse.PurchaseRequests.PurchaseRequestsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Purchase Requests"
        Height="760" Width="1250" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="#EEF4F8"
        Loaded="Window_Loaded" Activated="Window_Activated">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#17385F" CornerRadius="8" Padding="22,18" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="PURCHASE REQUESTS" Foreground="White" FontSize="27" FontWeight="Bold"/>
                    <TextBlock Text="Review, submit, approve, and convert purchase requests." Foreground="#D9ECF8" Margin="0,7,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#245985" CornerRadius="8" Padding="18,8" VerticalAlignment="Top">
                    <TextBlock x:Name="SelectedStatusText" Text="No request selected" Foreground="White" FontSize="16" FontWeight="Bold"/>
                </Border>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Border Width="230" Background="#E5EEF5" CornerRadius="6" Padding="14,10" Margin="0,0,10,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="SubmittedHeadingText" Text="Submitted (0)" Foreground="#17385F" FontSize="18" FontWeight="Bold" TextAlignment="Center"/>
                            <TextBlock x:Name="SubmittedAmountText" Text="Amount: 0.000" Foreground="#17385F" FontSize="22" FontWeight="Bold" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Width="230" Background="#DFF4E8" CornerRadius="6" Padding="14,10" Margin="0,0,10,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="ApprovedHeadingText" Text="Approved (0)" Foreground="#16735F" FontSize="18" FontWeight="Bold" TextAlignment="Center"/>
                            <TextBlock x:Name="ApprovedAmountText" Text="Amount: 0.000" Foreground="#16735F" FontSize="22" FontWeight="Bold" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Width="230" Background="#FCE6E5" CornerRadius="6" Padding="14,10">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="RejectedHeadingText" Text="Rejected (0)" Foreground="#B6434B" FontSize="18" FontWeight="Bold" TextAlignment="Center"/>
                            <TextBlock x:Name="RejectedAmountText" Text="Amount: 0.000" Foreground="#B6434B" FontSize="22" FontWeight="Bold" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#C9D8E5" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="New request" Click="NewRequest_Click" Style="{StaticResource ActionButton}" Background="#16735F" Foreground="White"/>
                    <Button Content="Refresh" Click="Refresh_Click" Style="{StaticResource ActionButton}" Background="#E5EEF5" Foreground="#17385F"/>
                    <Button x:Name="SubmitButton" Content="Submit" Click="Submit_Click" Style="{StaticResource ActionButton}" Background="#245985" Foreground="White" Visibility="Collapsed"/>
                    <Button x:Name="ApproveButton" Content="Review / Approve" Click="Approve_Click" Style="{StaticResource ActionButton}" Background="#16735F" Foreground="White" Visibility="Collapsed"/>
                    <Button x:Name="RejectButton" Content="Reject" Click="Reject_Click" Style="{StaticResource ActionButton}" Background="#B6434B" Foreground="White" Visibility="Collapsed"/>
                    <Button x:Name="CreatePoButton" Content="Create PO" Click="CreatePo_Click" Style="{StaticResource ActionButton}" Background="#1594C3" Foreground="White" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="From" Foreground="#17385F" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <DatePicker x:Name="FromDatePicker" Width="125" Height="32" SelectedDateChanged="DateFilter_Changed"/>
                    <TextBlock Text="To" Foreground="#17385F" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,5,0"/>
                    <DatePicker x:Name="ToDatePicker" Width="125" Height="32" SelectedDateChanged="DateFilter_Changed"/>
                    <Button Content="مسح الفلاتر" Click="ClearDateFilter_Click" Style="{StaticResource ActionButton}" Background="#E5EEF5" Foreground="#17385F" Margin="12,0,0,0"/>
                </StackPanel>
                <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0">
                    <StackPanel Width="260" Margin="0,0,14,4">
                        <TextBlock Text="المورد" Foreground="#17385F" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="SupplierFilter" Height="34" IsEditable="True" IsTextSearchEnabled="False"
                                  StaysOpenOnEdit="True" MaxDropDownHeight="240"/>
                    </StackPanel>
                    <StackPanel Width="290" Margin="0,0,14,4">
                        <TextBlock Text="اسم الصنف" Foreground="#17385F" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="ProductNameFilter" Height="34" Padding="8,4" VerticalContentAlignment="Center"
                                 TextChanged="SearchFilter_Changed"/>
                    </StackPanel>
                    <StackPanel Width="220" Margin="0,0,0,4">
                        <TextBlock Text="الباركود" Foreground="#17385F" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="BarcodeFilter" Height="34" Padding="8,4" VerticalContentAlignment="Center"
                                 TextChanged="SearchFilter_Changed" FlowDirection="LeftToRight"/>
                    </StackPanel>
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#C9D8E5" BorderThickness="1" CornerRadius="8" Padding="12">
            <DataGrid x:Name="RequestsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      SelectionChanged="RequestsGrid_SelectionChanged" MouseDoubleClick="RequestsGrid_MouseDoubleClick"
                      ContextMenuOpening="RequestsGrid_ContextMenuOpening"
                      HeadersVisibility="Column" RowHeight="38" BorderBrush="#D9E3EC">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PR number" Binding="{Binding RequestNumber}" Width="1.4*"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding RequestDate, StringFormat=dd/MM/yyyy}" Width="1*"/>
                    <DataGridTextColumn Header="Requested by" Binding="{Binding RequesterName}" Width="1.4*"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="1*"/>
                    <DataGridTextColumn Header="Items" Binding="{Binding LineCount}" Width="0.7*"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1.2*"/>
                    <DataGridTextColumn Header="Total amount" Binding="{Binding TotalAmount, StringFormat=N3}" Width="1.2*"/>
                    <DataGridTextColumn Header="Approved total" Binding="{Binding ApprovedTotalAmount, StringFormat=N3}" Width="1.2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Background="#FFF1D6" BorderBrush="#EACB8A" BorderThickness="1" CornerRadius="6" Padding="16,8" Margin="0,14,0,0">
            <TextBlock Text="Approval changes status only; stock is posted by the purchase workflow." Foreground="#815D17" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
