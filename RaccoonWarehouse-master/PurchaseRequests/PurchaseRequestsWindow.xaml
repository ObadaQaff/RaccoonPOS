<Window x:Class="RaccoonWarehouse.PurchaseRequests.PurchaseRequestsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Purchase Request | نموذج طلب شراء" Height="900" Width="1450" MinHeight="720" MinWidth="1100" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Background="#EEF4F8">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#17385F"/><Setter Property="Margin" Value="0,0,0,5"/></Style>
        <Style x:Key="FieldBox" TargetType="Control"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="9,5"/><Setter Property="BorderBrush" Value="#C9D8E5"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/></Style>
        <Style x:Key="ActionButton" TargetType="Button"><Setter Property="Padding" Value="18,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/></Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#17385F" CornerRadius="8" Padding="22,18" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PURCHASE REQUEST FORM | نموذج طلب شراء" Foreground="White" FontSize="27" FontWeight="Bold"/><TextBlock Text="Prepare, review, submit, and approve purchasing needs before creating a purchase order." Foreground="#D9ECF8" Margin="0,7,0,0"/></StackPanel><Border Grid.Column="1" Background="#245985" CornerRadius="8" Padding="18,8" VerticalAlignment="Top"><TextBlock x:Name="SelectedStatusText" Text="PR status | الحالة: No request selected" Foreground="White" FontSize="16" FontWeight="Bold"/></Border></Grid></Border>
        <Border Grid.Row="1" Background="#F7FBFD" BorderBrush="#C9D8E5" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="PR No | رقم الطلب" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RequestNumberTextBox" Style="{StaticResource FieldBox}" IsReadOnly="True" Text="Auto generated"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Request date | التاريخ" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="RequestDatePicker" Height="34"/></StackPanel><StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="Requested by | مقدم الطلب" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RequesterTextBox" Style="{StaticResource FieldBox}"/></StackPanel><StackPanel Grid.Column="3" Margin="0,0,12,0"><TextBlock Text="Department | القسم" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DepartmentTextBox" Style="{StaticResource FieldBox}"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Priority | الأولوية" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="PriorityComboBox" Style="{StaticResource FieldBox}" SelectedIndex="1"><ComboBoxItem Content="HIGH"/><ComboBoxItem Content="MEDIUM"/><ComboBoxItem Content="LOW"/></ComboBox></StackPanel></Grid></Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#C9D8E5" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,10,0"><TextBlock Text="Item name / اسم الصنف" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ProductNameTextBox" Style="{StaticResource FieldBox}" ToolTip="Type the existing product name"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Requested quantity" Style="{StaticResource FieldLabel}"/><TextBox x:Name="QuantityTextBox" Style="{StaticResource FieldBox}" Text="1"/></StackPanel><StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="Supplier / المورد" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SupplierTextBox" Style="{StaticResource FieldBox}"/></StackPanel><StackPanel Grid.Column="3" Margin="0,0,10,0"><TextBlock Text="Justification / سبب الطلب" Style="{StaticResource FieldLabel}"/><TextBox x:Name="JustificationTextBox" Style="{StaticResource FieldBox}"/></StackPanel><Button Grid.Column="4" Content="＋  Add item" Click="Create_Click" Style="{StaticResource ActionButton}" Background="#1594C3" Foreground="White" VerticalAlignment="Bottom"/></Grid></Border>
        <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.95*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="White" BorderBrush="#C9D8E5" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,12,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="PURCHASE REQUESTS | طلبات الشراء" Foreground="#17385F" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/><DataGrid x:Name="RequestsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="RequestsGrid_SelectionChanged" HeadersVisibility="Column" RowHeight="34" BorderBrush="#D9E3EC"><DataGrid.Columns><DataGridTextColumn Header="PR No" Binding="{Binding RequestNumber}" Width="1.3*"/><DataGridTextColumn Header="Date" Binding="{Binding RequestDate, StringFormat=dd/MM/yyyy}" Width="1*"/><DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="0.9*"/><DataGridTextColumn Header="Items" Binding="{Binding LineCount}" Width="0.7*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1.2*"/></DataGrid.Columns></DataGrid></Grid></Border><Border Grid.Column="1" Background="White" BorderBrush="#C9D8E5" BorderThickness="1" CornerRadius="8" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="REQUESTED PRODUCTS | أصناف طلب الشراء" Foreground="#17385F" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/><DataGrid x:Name="LinesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" RowHeight="36" BorderBrush="#D9E3EC"><DataGrid.Columns><DataGridTextColumn Header="Item name" Binding="{Binding ProductName}" Width="1.4*"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="1.6*"/><DataGridTextColumn Header="Requested qty" Binding="{Binding RequestedQuantity, StringFormat=N3}" Width="1*"/><DataGridTextColumn Header="Stock on hand" Binding="{Binding AvailableStockSnapshot, StringFormat=N3}" Width="1*"/><DataGridTextColumn Header="Approved qty" Binding="{Binding ApprovedQuantity, StringFormat=N3}" Width="1*"/><DataGridTextColumn Header="Need beyond stock" Binding="{Binding ExpectedStockoutDate, StringFormat=dd/MM/yyyy}" Width="1.2*"/><DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="1.4*"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="2" Text="PR approval does not post inventory or accounting entries." Foreground="#6D7E8D" FontStyle="Italic" Margin="0,10,0,0"/></Grid></Border></Grid>
        <Grid Grid.Row="4" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button Content="↻  Refresh" Click="Refresh_Click" Style="{StaticResource ActionButton}" Background="#E5EEF5" Foreground="#17385F"/><Button Content="Submit" Click="Submit_Click" Style="{StaticResource ActionButton}" Background="#245985" Foreground="White"/><Button Content="Approve" Click="Approve_Click" Style="{StaticResource ActionButton}" Background="#16735F" Foreground="White"/><Button Content="Create PO from approved PR" Click="CreatePo_Click" Style="{StaticResource ActionButton}" Background="#1594C3" Foreground="White"/><Button Content="Reject" Click="Reject_Click" Style="{StaticResource ActionButton}" Background="#B6434B" Foreground="White"/></StackPanel><Border Grid.Column="1" Background="#FFF1D6" BorderBrush="#EACB8A" BorderThickness="1" CornerRadius="6" Padding="16,8"><TextBlock Text="Manager approval | اعتماد المدير: Pending" Foreground="#815D17" FontWeight="SemiBold"/></Border></Grid>
    </Grid>
</Window>
