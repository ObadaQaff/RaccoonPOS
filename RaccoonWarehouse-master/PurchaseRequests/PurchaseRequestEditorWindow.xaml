<Window x:Class="RaccoonWarehouse.PurchaseRequests.PurchaseRequestEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Purchase Request"
        Height="900" Width="1450" MinHeight="680" MinWidth="1050"
        WindowStartupLocation="CenterScreen" Background="#EEF4F8"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#17385F"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="Control">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="BorderBrush" Value="#C9D8E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#17385F" CornerRadius="8" Padding="22,18" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="PURCHASE REQUEST" Foreground="White" FontSize="27" FontWeight="Bold"/>
                    <TextBlock Text="Create or update a request before sending it for approval." Foreground="#D9ECF8" Margin="0,7,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#245985" CornerRadius="8" Padding="18,8" VerticalAlignment="Top">
                    <TextBlock x:Name="StatusText" Text="Draft" Foreground="White" FontSize="16" FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#F7FBFD" BorderBrush="#C9D8E5" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="PR number" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RequestNumberTextBox" Style="{StaticResource FieldBox}" IsReadOnly="True" Text="Generated on save"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Request date" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="RequestDatePicker" Height="34"/></StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="Requested by" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RequesterTextBox" Style="{StaticResource FieldBox}" IsReadOnly="True"/></StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,12,0"><TextBlock Text="Category" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="CategoryComboBox" Style="{StaticResource FieldBox}" SelectionChanged="CategoryComboBox_SelectionChanged"><ComboBoxItem Content="Drugs" Tag="Drugs"/><ComboBoxItem Content="Other" Tag="Other"/></ComboBox></StackPanel>
                <StackPanel Grid.Column="4" Margin="0,0,12,0"><TextBlock Text="Department" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DepartmentTextBox" Style="{StaticResource FieldBox}"/></StackPanel>
                <StackPanel Grid.Column="5"><TextBlock Text="Priority" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="PriorityComboBox" Style="{StaticResource FieldBox}" SelectedIndex="1"><ComboBoxItem Content="HIGH"/><ComboBoxItem Content="MEDIUM"/><ComboBoxItem Content="LOW"/></ComboBox></StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#C9D8E5" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="2.5*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.ColumnSpan="4" Text="Add request lines" Foreground="#17385F" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="Supplier filter" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="SupplierFilterComboBox" Style="{StaticResource FieldBox}" DisplayMemberPath="Name" SelectedValuePath="Id" IsEditable="True"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Bottom"><TextBlock x:Name="ModeHintText" Text="Drugs mode: choose products from the catalog. Filter by supplier, name, or barcode." Foreground="#4B687C" VerticalAlignment="Center" Margin="0,0,0,7"/></StackPanel>
                <Button Grid.Row="1" Grid.Column="2" x:Name="SelectProductsButton" Content="Select products" Click="SelectProducts_Click" Style="{StaticResource ActionButton}" Background="#1594C3" Foreground="White" VerticalAlignment="Bottom"/>
                <Button Grid.Row="1" Grid.Column="3" x:Name="AddOtherLineButton" Content="Add free-text line" Click="AddOtherLine_Click" Style="{StaticResource ActionButton}" Background="#1594C3" Foreground="White" VerticalAlignment="Bottom" Visibility="Collapsed"/>
                <Grid Grid.Row="2" Grid.ColumnSpan="4" Margin="0,12,0,0" x:Name="OtherLineEditor" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0"><TextBlock Text="Item name" Style="{StaticResource FieldLabel}"/><TextBox x:Name="OtherNameTextBox" Style="{StaticResource FieldBox}"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Unit" Style="{StaticResource FieldLabel}"/><TextBox x:Name="OtherUnitTextBox" Style="{StaticResource FieldBox}"/></StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="Unit price" Style="{StaticResource FieldLabel}"/><TextBox x:Name="OtherPriceTextBox" Style="{StaticResource FieldBox}" Text="0"/></StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,10,0"><TextBlock Text="Requested qty" Style="{StaticResource FieldLabel}"/><TextBox x:Name="OtherQuantityTextBox" Style="{StaticResource FieldBox}" Text="1"/></StackPanel>
                    <StackPanel Grid.Column="4" Margin="0,0,10,0"><TextBlock Text="Supplier" Style="{StaticResource FieldLabel}"/><TextBox x:Name="OtherSupplierTextBox" Style="{StaticResource FieldBox}"/></StackPanel>
                    <StackPanel Grid.Column="5"><TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/><TextBox x:Name="OtherNotesTextBox" Style="{StaticResource FieldBox}"/></StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="White" BorderBrush="#C9D8E5" BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="REQUEST LINES" Foreground="#17385F" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                <Button Grid.Column="1" Content="Remove selected line" Click="RemoveLine_Click" Style="{StaticResource ActionButton}" Background="#F5E4E6" Foreground="#96313A"/>
                <DataGrid x:Name="LinesGrid" Grid.Row="1" Grid.ColumnSpan="2" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" RowHeight="36" BorderBrush="#D9E3EC">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" IsReadOnly="True" Width="1.1*"/>
                        <DataGridTextColumn Header="Item name" Binding="{Binding ItemName}" IsReadOnly="True" Width="1.7*"/>
                        <DataGridTextColumn Header="Unit" Binding="{Binding UnitName}" IsReadOnly="True" Width="0.9*"/>
                        <DataGridTextColumn Header="Unit price" Binding="{Binding UnitPrice, StringFormat=N3, UpdateSourceTrigger=PropertyChanged}" Width="0.9*"/>
                        <DataGridTextColumn Header="Requested qty" Binding="{Binding RequestedQuantity, StringFormat=N3, UpdateSourceTrigger=PropertyChanged}" Width="1*"/>
                        <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" IsReadOnly="True" Width="1.3*"/>
                        <DataGridTextColumn Header="Stock" Binding="{Binding AvailableStockSnapshot, StringFormat=N3}" IsReadOnly="True" Width="0.9*"/>
                        <DataGridTextColumn Header="Need beyond stock" Binding="{Binding NeedBeyondStock, StringFormat=N3}" IsReadOnly="True" Width="1.1*"/>
                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Width="1.4*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Saving a request does not post inventory or accounting entries." Foreground="#6D7E8D" FontStyle="Italic"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="Total amount:" Foreground="#17385F" FontWeight="SemiBold" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TotalAmountText" Text="0.000" Foreground="#16735F" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Save draft" Click="SaveDraft_Click" Style="{StaticResource ActionButton}" Background="#16735F" Foreground="White"/>
                <Button Content="Close" Click="Close_Click" Style="{StaticResource ActionButton}" Background="#E5EEF5" Foreground="#17385F"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
