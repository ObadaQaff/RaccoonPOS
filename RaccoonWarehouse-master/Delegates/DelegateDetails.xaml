<Window x:Class="RaccoonWarehouse.Delegates.DelegateDetails"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تفاصيل مندوب"
        FlowDirection="RightToLeft"
        Background="{StaticResource AppPageBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="NameText" FontSize="28" FontWeight="Bold"/>
            <TextBlock x:Name="MetaText" Margin="0,8,0,18" Foreground="{StaticResource AppMutedTextBrush}"/>
            <UniformGrid Columns="2" Rows="5">
                <Border Style="{StaticResource AppBadgeBorderStyle}"><StackPanel><TextBlock Text="الكود"/><TextBlock x:Name="CodeText" FontWeight="Bold"/></StackPanel></Border>
                <Border Style="{StaticResource AppBadgeBorderStyle}"><StackPanel><TextBlock Text="الحالة"/><TextBlock x:Name="StatusText" FontWeight="Bold"/></StackPanel></Border>
                <Border Style="{StaticResource AppBadgeBorderStyle}"><StackPanel><TextBlock Text="النوع"/><TextBlock x:Name="TypeText" FontWeight="Bold"/></StackPanel></Border>
                <Border Style="{StaticResource AppBadgeBorderStyle}"><StackPanel><TextBlock Text="الهاتف"/><TextBlock x:Name="PhoneText" FontWeight="Bold"/></StackPanel></Border>
                <Border Style="{StaticResource AppBadgeBorderStyle}"><StackPanel><TextBlock Text="المستخدم"/><TextBlock x:Name="UserText" FontWeight="Bold"/></StackPanel></Border>
                <Border Style="{StaticResource AppBadgeBorderStyle}"><StackPanel><TextBlock Text="عدد الفواتير"/><TextBlock x:Name="InvoiceCountText" FontWeight="Bold"/></StackPanel></Border>
                <Border Style="{StaticResource AppBadgeBorderStyle}"><StackPanel><TextBlock Text="إجمالي المبيعات"/><TextBlock x:Name="SalesText" FontWeight="Bold"/></StackPanel></Border>
                <Border Style="{StaticResource AppBadgeBorderStyle}"><StackPanel><TextBlock Text="آخر تحديث"/><TextBlock x:Name="UpdatedText" FontWeight="Bold"/></StackPanel></Border>
                <Border Style="{StaticResource AppBadgeBorderStyle}"><StackPanel><TextBlock Text="الملاحظات"/><TextBlock x:Name="NotesText" TextWrapping="Wrap" FontWeight="Bold"/></StackPanel></Border>
            </UniformGrid>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
            <Button Content="إغلاق" Width="120" Style="{StaticResource AppSecondaryButtonStyle}" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
