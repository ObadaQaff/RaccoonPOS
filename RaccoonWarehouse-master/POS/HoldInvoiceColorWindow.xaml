<Window x:Class="RaccoonWarehouse.POS.HoldInvoiceColorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose hold color / اختيار لون الفاتورة المعلقة"
        Height="260"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F2F6FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Choose a color for this held invoice / اختر لوناً لهذه الفاتورة المعلقة"
                   FontSize="20"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,16"/>
        <UniformGrid x:Name="ColorsGrid" Grid.Row="1" Rows="2" Columns="3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Button Grid.Row="2" Content="Cancel / إلغاء" Width="110" Height="36" HorizontalAlignment="Center" Margin="0,18,0,0" Click="CancelButton_Click"/>
    </Grid>
</Window>
