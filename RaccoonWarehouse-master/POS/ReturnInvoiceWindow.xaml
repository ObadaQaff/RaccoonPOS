<Window x:Class="RaccoonWarehouse.POS.ReturnInvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Return Invoice / اختيار فاتورة الإرجاع"
        Width="1050"
        Height="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F5F6FA"
        WindowStyle="ToolWindow">
    <Grid Margin="18" FlowDirection="RightToLeft">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#1F4E66" CornerRadius="10" Padding="16">
            <StackPanel>
                <TextBlock Text="Select Return Invoice / اختيار فاتورة الإرجاع"
                           Foreground="White" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Full invoice details load only after selection / يتم تحميل التفاصيل بعد الاختيار فقط"
                           Foreground="#DCEAF0" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12" Margin="0,12,0,12"
                BorderBrush="#D8E1E6" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="From / من" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker x:Name="DateFrom" Grid.Column="1"/>
                <TextBlock Grid.Column="2" Text="To / إلى" VerticalAlignment="Center" Margin="18,0,8,0"/>
                <DatePicker x:Name="DateTo" Grid.Column="3"/>
                <TextBlock Grid.Column="4" Text="Number / رقم الفاتورة" VerticalAlignment="Center" Margin="18,0,8,0"/>
                <TextBox x:Name="InvoiceNumberTextBox" Grid.Column="5" Height="32" Padding="6"/>
                <Button Grid.Column="7" Content="Search / بحث" Height="32" Margin="12,0,0,0"
                        Style="{StaticResource PrimaryButtonStyle}" Click="Search_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="8"
                BorderBrush="#D8E1E6" BorderThickness="1">
            <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" MouseDoubleClick="Select_Click">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Number / رقم الفاتورة" Binding="{Binding InvoiceNumber}" Width="170"/>
                    <DataGridTextColumn Header="Date / التاريخ" Binding="{Binding CreatedDate, StringFormat=yyyy-MM-dd HH:mm}" Width="170"/>
                    <DataGridTextColumn Header="Customer / العميل" Binding="{Binding CustomerName}" Width="*"/>
                    <DataGridTextColumn Header="Payment / طريقة الدفع" Binding="{Binding PaymentMethodDisplay}" Width="220"/>
                    <DataGridTextColumn Header="Total / الإجمالي" Binding="{Binding TotalAmount, StringFormat=N3}" Width="140"/>
                    <DataGridTextColumn Header="Return status / حالة الإرجاع" Binding="{Binding ReturnStatus}" Width="230"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button Content="Select / اختيار" Width="150" Height="36" Margin="6"
                    Style="{StaticResource PrimaryButtonStyle}" Click="Select_Click"/>
            <Button Content="Cancel / إلغاء" Width="150" Height="36" Margin="6"
                    Style="{StaticResource CancelButtonStyle}" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
