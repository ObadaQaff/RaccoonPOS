<Window x:Class="RaccoonWarehouse.POS.DailySalesReport"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="لوحة الكاشيرات"
        Height="650"
        Width="1200"
        MinHeight="560"
        MinWidth="1000"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#F2F6FA"
        FlowDirection="RightToLeft">

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Center">
            <TextBlock Text="لوحة الكاشيرات"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#2D8DCF"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="اختر الكاشير والوردية لعرض كل الحركات والتفاصيل المرتبطة بهما."
                       FontSize="11"
                       Foreground="#55606D"
                       HorizontalAlignment="Center"
                       Margin="0,2,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="6"
                Margin="0,5,0,0"
                BorderBrush="#D0D7DD"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="الكاشير"
                                   FontSize="10"
                                   Foreground="#5E6B75"
                                   Margin="0,0,0,2"/>
                        <ComboBox x:Name="CashierComboBox"
                                  Width="160"
                                  Height="28"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectionChanged="CashierComboBox_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="الوردية"
                                   FontSize="10"
                                   Foreground="#5E6B75"
                                   Margin="0,0,0,2"/>
                        <ComboBox x:Name="SessionComboBox"
                                  Width="240"
                                  Height="28"
                                  DisplayMemberPath="DisplayText"
                                  SelectionChanged="SessionComboBox_SelectionChanged"/>
                    </StackPanel>
                    <Button Content="تحديث"
                            Width="85"
                            Height="28"
                            Margin="0,14,0,0"
                            Click="RefreshScope_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Border Background="#EEF7EF" CornerRadius="8" Padding="8,5" Margin="0,0,5,0">
                        <StackPanel>
                            <TextBlock Text="تاريخ الوردية" Foreground="#5E6B75" FontSize="9"/>
                            <TextBlock Text="{Binding ReportDate, StringFormat={}{0:dd-MM-yyyy}}" FontWeight="SemiBold" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#EEF7EF" CornerRadius="8" Padding="8,5" Margin="0,0,5,0">
                        <StackPanel>
                            <TextBlock Text="الكاشير" Foreground="#5E6B75" FontSize="9"/>
                            <TextBlock Text="{Binding CashierName}" FontWeight="SemiBold" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#F8FAFC" CornerRadius="8" Padding="8,5" Margin="0,0,5,0">
                        <StackPanel>
                            <TextBlock Text="النطاق" Foreground="#5E6B75" FontSize="9"/>
                            <TextBlock Text="{Binding ScopeLabel}" FontWeight="SemiBold" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#F8FAFC" CornerRadius="8" Padding="8,5" Margin="0,0,5,0">
                        <StackPanel>
                            <TextBlock Text="الحالة" Foreground="#5E6B75" FontSize="9"/>
                            <TextBlock Text="{Binding SessionStatus}" FontWeight="SemiBold" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#EEF7EF" CornerRadius="8" Padding="8,5">
                        <StackPanel>
                            <TextBlock Text="الافتتاحي" Foreground="#5E6B75" FontSize="9"/>
                            <TextBlock Text="{Binding OpeningBalance, StringFormat={}{0:N2}}" FontWeight="SemiBold" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                Padding="8"
                Margin="0,8,0,0"
                BorderBrush="#D0D7DD"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="الورديات"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#2B3E50"
                           Margin="4,0,0,6"/>
                <DataGrid x:Name="SessionsGrid"
                          ItemsSource="{Binding Sessions}"
                          Style="{StaticResource MinimalDataGrid}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          SelectionChanged="SessionsGrid_SelectionChanged"
                          Height="100"
                          FontSize="10"
                          RowHeight="26"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الرقم" Binding="{Binding Id}" Width="90"/>
                        <DataGridTextColumn Header="الفتح" Binding="{Binding OpenedAt}" Width="170"/>
                        <DataGridTextColumn Header="الإغلاق" Binding="{Binding ClosedAt}" Width="170"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="120"/>
                        <DataGridTextColumn Header="الافتتاحي" Binding="{Binding StatrBalance, StringFormat={}{0:N2}}" Width="130"/>
                        <DataGridTextColumn Header="الختامي" Binding="{Binding EndingBalance, StringFormat={}{0:N2}}" Width="130"/>
                        <DataGridTextColumn Header="Net / Current" Binding="{Binding CurrentNet, StringFormat={}{0:N2}}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <UniformGrid Grid.Row="3" Columns="4" Margin="0,8,0,0">
            <Border Background="White" CornerRadius="8" Padding="8" Margin="0,0,6,0" BorderBrush="#D0D7DD" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="إجمالي المستندات" Foreground="#67727D" FontSize="12"/>
                    <TextBlock Text="{Binding TotalDocuments}" FontSize="19" FontWeight="Bold" Foreground="#2D8DCF"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="8" Margin="0,0,6,0" BorderBrush="#D0D7DD" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="إجمالي الوارد" Foreground="#67727D" FontSize="12"/>
                    <TextBlock Text="{Binding TotalIn, StringFormat={}{0:N2}}" FontSize="19" FontWeight="Bold" Foreground="#27AE60"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="8" Margin="0,0,6,0" BorderBrush="#D0D7DD" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="إجمالي الصادر" Foreground="#67727D" FontSize="12"/>
                    <TextBlock Text="{Binding TotalOut, StringFormat={}{0:N2}}" FontSize="19" FontWeight="Bold" Foreground="#C93F4D"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="8" BorderBrush="#D0D7DD" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="الصافي" Foreground="#67727D" FontSize="12"/>
                    <TextBlock Text="{Binding NetMovement, StringFormat={}{0:N2}}" FontSize="19" FontWeight="Bold" Foreground="#2D8DCF"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <UniformGrid Grid.Row="4" Columns="10" Margin="0,8,0,0">
            <Border Background="#EEF7EF" CornerRadius="8" Padding="8" Margin="0,0,6,0" BorderBrush="#D0D7DD" BorderThickness="1">
                <StackPanel><TextBlock Text="Cash / نقدي" Foreground="#67727D" FontSize="11"/><TextBlock x:Name="CashTotalTextBlock" Text="0.00" FontSize="16" FontWeight="Bold" Foreground="#27AE60"/></StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="8" Margin="0,0,6,0" BorderBrush="#D0D7DD" BorderThickness="1">
                <StackPanel><TextBlock Text="Visa / Visa" Foreground="#67727D" FontSize="11"/><TextBlock x:Name="VisaTotalTextBlock" Text="0.00" FontSize="16" FontWeight="Bold" Foreground="#2D8DCF"/></StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="8" Margin="0,0,6,0" BorderBrush="#D0D7DD" BorderThickness="1">
                <StackPanel><TextBlock Text="Credit / آجل" Foreground="#67727D" FontSize="11"/><TextBlock x:Name="CreditTotalTextBlock" Text="0.00" FontSize="16" FontWeight="Bold" Foreground="#C93F4D"/></StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="8" Margin="0,0,6,0" BorderBrush="#D0D7DD" BorderThickness="1">
                <StackPanel><TextBlock Text="Master / ماستر" Foreground="#67727D" FontSize="11"/><TextBlock x:Name="MasterTotalTextBlock" Text="0.00" FontSize="16" FontWeight="Bold" Foreground="#2D8DCF"/></StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="8" Margin="0,0,6,0" BorderBrush="#D0D7DD" BorderThickness="1">
                <StackPanel><TextBlock Text="Debit / مدين" Foreground="#67727D" FontSize="11"/><TextBlock x:Name="DebitTotalTextBlock" Text="0.00" FontSize="16" FontWeight="Bold" Foreground="#2D8DCF"/></StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="8" Margin="0,0,6,0" BorderBrush="#D0D7DD" BorderThickness="1">
                <StackPanel><TextBlock Text="Check / شيك" Foreground="#67727D" FontSize="11"/><TextBlock x:Name="CheckTotalTextBlock" Text="0.00" FontSize="16" FontWeight="Bold" Foreground="#2D8DCF"/></StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="8" BorderBrush="#D0D7DD" BorderThickness="1">
                <StackPanel><TextBlock Text="Mobile / موبايل" Foreground="#67727D" FontSize="11"/><TextBlock x:Name="MobileTotalTextBlock" Text="0.00" FontSize="16" FontWeight="Bold" Foreground="#2D8DCF"/></StackPanel>
            </Border>

            <Border Background="#EEF7EF" CornerRadius="8" Padding="8" Margin="0,0,6,0" BorderBrush="#D0D7DD" BorderThickness="1">
                <StackPanel><TextBlock Text="Receipts / سندات القبض" Foreground="#67727D" FontSize="11"/><TextBlock x:Name="VoucherReceiptsTextBlock" Text="0.00" FontSize="16" FontWeight="Bold" Foreground="#27AE60"/></StackPanel>
            </Border>
            <Border Background="#FFF3F3" CornerRadius="8" Padding="8" Margin="0,0,6,0" BorderBrush="#D0D7DD" BorderThickness="1">
                <StackPanel><TextBlock Text="Payments / سندات الدفع" Foreground="#67727D" FontSize="11"/><TextBlock x:Name="VoucherPaymentsTextBlock" Text="0.00" FontSize="16" FontWeight="Bold" Foreground="#C93F4D"/></StackPanel>
            </Border>
            <Border Background="White" CornerRadius="8" Padding="8" BorderBrush="#D0D7DD" BorderThickness="1">
                <StackPanel><TextBlock Text="Voucher Net / صافي السندات" Foreground="#67727D" FontSize="11"/><TextBlock x:Name="VoucherNetTextBlock" Text="0.00" FontSize="16" FontWeight="Bold" Foreground="#2D8DCF"/></StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="5"
                Background="White"
                CornerRadius="12"
                Padding="8"
                Margin="0,8,0,0"
                BorderBrush="#D0D7DD"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="4,0,4,10" LastChildFill="True">
                            <TextBlock Text="Search voucher number / رقم السند"
                               VerticalAlignment="Center"
                               Foreground="#55606D"
                               Margin="0,0,10,0"/>
                    <Button DockPanel.Dock="Right"
                            Content="Clear"
                            Width="85"
                            Height="34"
                            Margin="8,0,0,0"
                            Click="ClearInvoiceSearch_Click"/>
                    <TextBox x:Name="InvoiceSearchTextBox"
                             Height="34"
                             VerticalContentAlignment="Center"
                             TextChanged="InvoiceSearchTextBox_TextChanged"/>
                </DockPanel>
            <DataGrid Grid.Row="1" x:Name="TransactionsGrid"
                      ItemsSource="{Binding Transactions}"
                      Style="{StaticResource MinimalDataGrid}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      FontSize="10"
                      RowHeight="26"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      MouseDoubleClick="TransactionsGrid_MouseDoubleClick"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="التاريخ"
                                        Binding="{Binding Date}"
                                        SortMemberPath="Date"
                                        CanUserSort="True"
                                        Width="190"/>
                    <DataGridTextColumn Header="رقم المستند"
                                        Binding="{Binding DocumentNumber}"
                                        SortMemberPath="DocumentNumber"
                                        CanUserSort="True"
                                        Width="170"/>
                    <DataGridTemplateColumn Header="Falcon No. / رقم فالكون"
                                            SortMemberPath="FalconInvoiceNumber"
                                            CanUserSort="True"
                                            Width="190">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding FalconInvoiceNumber}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <Button Content="Copy"
                                            Padding="8,2"
                                            Tag="{Binding}"
                                            Click="CopyFalconInvoiceNumber_Click"
                                            IsEnabled="{Binding HasFalconInvoiceNumber}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="المبلغ"
                                        Binding="{Binding Amount, StringFormat={}{0:N2}}"
                                        SortMemberPath="Amount"
                                        CanUserSort="True"
                                        Width="130"/>
                    <DataGridTextColumn Header="Customer"
                                        Binding="{Binding CustomerName}"
                                        SortMemberPath="CustomerName"
                                        CanUserSort="True"
                                        Width="170"/>
                    <DataGridTextColumn Header="الطريقة"
                                        Binding="{Binding MethodText}"
                                        SortMemberPath="MethodText"
                                        CanUserSort="True"
                                        Width="120"/>
                    <DataGridTextColumn Header="النوع" Binding="{Binding DocumentTypeText}" Width="150"/>
                    <DataGridTextColumn Header="المرجع" Binding="{Binding ReferenceText}" Width="180"/>
                    <DataGridTextColumn Header="الاتجاه" Binding="{Binding DirectionText}" Width="100"/>
                    <DataGridTextColumn Header="الكاشير" Binding="{Binding CashierName}" Width="170"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusText}" Width="120"/>
                    <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="260"/>
                    <DataGridTemplateColumn Header="Copy" Width="85">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Copy"
                                        Padding="8,2"
                                        Tag="{Binding}"
                                        Click="CopyInvoiceNumber_Click"
                                        IsEnabled="{Binding IsInvoice}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Print" Width="85">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Print"
                                        Padding="8,2"
                                        Tag="{Binding}"
                                        Click="PrintInvoice_Click"
                                        IsEnabled="{Binding IsInvoice}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
