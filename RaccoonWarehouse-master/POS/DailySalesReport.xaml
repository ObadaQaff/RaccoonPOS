<Window x:Class="RaccoonWarehouse.POS.DailySalesReport"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="لوحة الكاشيرات"
        Height="760"
        Width="1440"
        MinHeight="640"
        MinWidth="1240"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#F2F6FA"
        FlowDirection="RightToLeft">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Center">
            <TextBlock Text="لوحة الكاشيرات"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#2D8DCF"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="اختر الكاشير والوردية لعرض كل الحركات والتفاصيل المرتبطة بهما."
                       FontSize="13"
                       Foreground="#55606D"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="12"
                Margin="0,15,0,0"
                BorderBrush="#D0D7DD"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="الكاشير"
                                   FontSize="12"
                                   Foreground="#5E6B75"
                                   Margin="0,0,0,4"/>
                        <ComboBox x:Name="CashierComboBox"
                                  Width="220"
                                  Height="38"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectionChanged="CashierComboBox_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="الوردية"
                                   FontSize="12"
                                   Foreground="#5E6B75"
                                   Margin="0,0,0,4"/>
                        <ComboBox x:Name="SessionComboBox"
                                  Width="340"
                                  Height="38"
                                  DisplayMemberPath="DisplayText"
                                  SelectionChanged="SessionComboBox_SelectionChanged"/>
                    </StackPanel>
                    <Button Content="تحديث"
                            Width="120"
                            Height="38"
                            Margin="0,20,0,0"
                            Click="RefreshScope_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Border Background="#EEF7EF" CornerRadius="10" Padding="12,8" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="تاريخ الوردية" Foreground="#5E6B75" FontSize="11"/>
                            <TextBlock Text="{Binding ReportDate, StringFormat={}{0:dd-MM-yyyy}}" FontWeight="SemiBold" FontSize="13"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#EEF7EF" CornerRadius="10" Padding="12,8" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="الكاشير" Foreground="#5E6B75" FontSize="11"/>
                            <TextBlock Text="{Binding CashierName}" FontWeight="SemiBold" FontSize="13"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#F8FAFC" CornerRadius="10" Padding="12,8" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="النطاق" Foreground="#5E6B75" FontSize="11"/>
                            <TextBlock Text="{Binding ScopeLabel}" FontWeight="SemiBold" FontSize="13"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#F8FAFC" CornerRadius="10" Padding="12,8" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="الحالة" Foreground="#5E6B75" FontSize="11"/>
                            <TextBlock Text="{Binding SessionStatus}" FontWeight="SemiBold" FontSize="13"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#EEF7EF" CornerRadius="10" Padding="12,8">
                        <StackPanel>
                            <TextBlock Text="الافتتاحي" Foreground="#5E6B75" FontSize="11"/>
                            <TextBlock Text="{Binding OpeningBalance, StringFormat={}{0:N2}}" FontWeight="SemiBold" FontSize="13"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                Padding="10"
                Margin="0,12,0,0"
                BorderBrush="#D0D7DD"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="الورديات"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#2B3E50"
                           Margin="4,0,0,10"/>
                <DataGrid x:Name="SessionsGrid"
                          ItemsSource="{Binding Sessions}"
                          Style="{StaticResource MinimalDataGrid}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          SelectionChanged="SessionsGrid_SelectionChanged"
                          Height="180"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الرقم" Binding="{Binding Id}" Width="90"/>
                        <DataGridTextColumn Header="الفتح" Binding="{Binding OpenedAt}" Width="170"/>
                        <DataGridTextColumn Header="الإغلاق" Binding="{Binding ClosedAt}" Width="170"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="120"/>
                        <DataGridTextColumn Header="الافتتاحي" Binding="{Binding StatrBalance, StringFormat={}{0:N2}}" Width="130"/>
                        <DataGridTextColumn Header="الختامي" Binding="{Binding EndingBalance, StringFormat={}{0:N2}}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <UniformGrid Grid.Row="3" Columns="4" Margin="0,12,0,0">
            <Border Background="White" CornerRadius="12" Padding="14" Margin="0,0,10,0" BorderBrush="#D0D7DD" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="إجمالي المستندات" Foreground="#67727D" FontSize="12"/>
                    <TextBlock Text="{Binding TotalDocuments}" FontSize="24" FontWeight="Bold" Foreground="#2D8DCF"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="12" Padding="14" Margin="0,0,10,0" BorderBrush="#D0D7DD" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="إجمالي الوارد" Foreground="#67727D" FontSize="12"/>
                    <TextBlock Text="{Binding TotalIn, StringFormat={}{0:N2}}" FontSize="24" FontWeight="Bold" Foreground="#27AE60"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="12" Padding="14" Margin="0,0,10,0" BorderBrush="#D0D7DD" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="إجمالي الصادر" Foreground="#67727D" FontSize="12"/>
                    <TextBlock Text="{Binding TotalOut, StringFormat={}{0:N2}}" FontSize="24" FontWeight="Bold" Foreground="#C93F4D"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="12" Padding="14" BorderBrush="#D0D7DD" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="الصافي" Foreground="#67727D" FontSize="12"/>
                    <TextBlock Text="{Binding NetMovement, StringFormat={}{0:N2}}" FontSize="24" FontWeight="Bold" Foreground="#2D8DCF"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="4"
                Background="White"
                CornerRadius="12"
                Padding="10"
                Margin="0,12,0,0"
                BorderBrush="#D0D7DD"
                BorderThickness="1">
            <DataGrid x:Name="TransactionsGrid"
                      ItemsSource="{Binding Transactions}"
                      Style="{StaticResource MinimalDataGrid}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      MouseDoubleClick="TransactionsGrid_MouseDoubleClick"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding Date}" Width="190"/>
                    <DataGridTextColumn Header="النوع" Binding="{Binding DocumentTypeText}" Width="150"/>
                    <DataGridTextColumn Header="رقم المستند" Binding="{Binding DocumentNumber}" Width="170"/>
                    <DataGridTextColumn Header="المرجع" Binding="{Binding ReferenceText}" Width="180"/>
                    <DataGridTextColumn Header="الاتجاه" Binding="{Binding DirectionText}" Width="100"/>
                    <DataGridTextColumn Header="الطريقة" Binding="{Binding MethodText}" Width="120"/>
                    <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="130"/>
                    <DataGridTextColumn Header="الكاشير" Binding="{Binding CashierName}" Width="170"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusText}" Width="120"/>
                    <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="260"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
