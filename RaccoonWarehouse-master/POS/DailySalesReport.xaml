<Window x:Class="RaccoonWarehouse.POS.DailySalesReport"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="التقرير اليومي"
        Height="620"
        Width="1280"
        MinHeight="560"
        MinWidth="1000"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#F2F6FA"
        FlowDirection="RightToLeft">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="التقرير اليومي للمبيعات"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#2D8DCF"
                   HorizontalAlignment="Center"/>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="12"
                Margin="0,15"
                BorderBrush="#D0D7DD"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <TextBlock Text="تاريخ الجلسة:"
                           FontSize="18"
                           Margin="10,0"
                           VerticalAlignment="Center"/>

                <DatePicker x:Name="ReportDatePicker"
                            SelectedDate="{Binding ReportDate}"
                            FontSize="16"
                            Width="200"
                            Height="42"
                            IsEnabled="False"
                            Focusable="False"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                Padding="10"
                BorderBrush="#D0D7DD"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,10">
                    <TextBlock Text="{Binding TotalInvoices, StringFormat=عدد الفواتير: {0}}"
                               FontSize="18"
                               Margin="20,0"/>

                    <TextBlock Text="{Binding TotalSales, StringFormat=إجمالي المبيعات: {0:N2}}"
                               FontSize="18"
                               Margin="20,0"/>

                    <TextBlock Text="{Binding TotalDiscount, StringFormat=الخصم: {0:N2}}"
                               FontSize="18"
                               Margin="20,0"/>

                    <TextBlock Text="{Binding NetSales, StringFormat=الصافي: {0:N2}}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#27AE60"
                               Margin="20,0"/>
                </StackPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Invoices}"
                          Style="{StaticResource MinimalDataGrid}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="رقم الفاتورة" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True">
                                        <Button Content="⧉"
                                                Width="30"
                                                Height="28"
                                                Margin="0,0,8,0"
                                                Padding="0"
                                                Cursor="Hand"
                                                ToolTip="نسخ رقم الفاتورة"
                                                Click="CopyInvoiceNumber_Click"/>
                                        <TextBlock Text="{Binding InvoiceNumber}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="التاريخ"
                                            Binding="{Binding ClosedAt}"
                                            Width="210"/>

                        <DataGridTextColumn Header="العميل"
                                            Binding="{Binding User.Name}"
                                            Width="220"/>

                        <DataGridTextColumn Header="نوع الفاتورة"
                                            Binding="{Binding InvoiceType}"
                                            Width="140"/>

                        <DataGridTextColumn Header="الإجمالي"
                                            Binding="{Binding TotalAmount, StringFormat={}{0:N2}}"
                                            Width="150"/>

                        <DataGridTextColumn Header="الخصم"
                                            Binding="{Binding DiscountAmount, StringFormat={}{0:N2}}"
                                            Width="130"/>

                        <DataGridTextColumn Header="الصافي"
                                            Binding="{Binding NetSales, StringFormat={}{0:N2}}"
                                            Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
