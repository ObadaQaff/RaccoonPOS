<Window x:Class="RaccoonWarehouse.Licensing.LicenseExpiredWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Width="520"
        Height="430"
        ShowInTaskbar="False"
        ShowActivated="True"
        Loaded="Window_Loaded">
    <Border Background="White"
            BorderBrush="#D9E3EA"
            BorderThickness="1"
            CornerRadius="20"
            Padding="32"
            Margin="12"
            Effect="{StaticResource DropShadowSoft}">
        <StackPanel HorizontalAlignment="Center">
            <TextBlock x:Name="TitleText"
                       Text="انتهت الفترة التجريبية"
                       FontSize="25"
                       FontWeight="Bold"
                       Foreground="#1F3345"
                       TextAlignment="Center"
                       Margin="0,4,0,14"/>

            <TextBlock x:Name="MessageText"
                       Text="انتهت الفترة التجريبية المجانية. يرجى التواصل معنا لتفعيل البرنامج."
                       FontSize="16"
                       Foreground="#64758D"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,24"/>

            <Border Background="#EEF7F5"
                    BorderBrush="#B8DED7"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18"
                    Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock x:Name="ContactLabelText"
                               Text="للتفعيل تواصل معنا عبر الهاتف أو واتساب"
                               FontSize="14"
                               Foreground="#356FA8"
                               TextAlignment="Center"/>
                    <TextBlock Text="0782495807"
                               FontSize="27"
                               FontWeight="Bold"
                               Foreground="#0F5B52"
                               TextAlignment="Center"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="WhatsAppButton"
                        Content="واتساب"
                        Width="130"
                        Height="42"
                        Margin="0,0,10,0"
                        Background="#0F9D58"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="WhatsAppButton_Click"/>
                <Button x:Name="PhoneButton"
                        Content="اتصال"
                        Width="130"
                        Height="42"
                        Margin="10,0,0,0"
                        Background="#2F83C5"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="PhoneButton_Click"/>
            </StackPanel>

            <Button x:Name="ExitButton"
                    Content="إغلاق البرنامج"
                    Width="180"
                    Height="36"
                    Margin="0,22,0,0"
                    Background="Transparent"
                    Foreground="#64758D"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="ExitButton_Click"/>
        </StackPanel>
    </Border>
</Window>
