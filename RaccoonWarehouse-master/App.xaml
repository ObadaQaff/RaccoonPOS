<Application x:Class="RaccoonWarehouse.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RaccoonWarehouse"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UI/Styles/WarehouseTheme.xaml"/>
                <ResourceDictionary Source="/UI/Styles/Buttons.xaml"/>
                <ResourceDictionary Source="/UI/Styles/AppChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <FlowDirection x:Key="CurrentFlowDirection">RightToLeft</FlowDirection>
            <TextAlignment x:Key="CurrentTextAlignment">Right</TextAlignment>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <DropShadowEffect x:Key="DropShadowSoft"
                  BlurRadius="20"
                  ShadowDepth="0"
                  Opacity="0.2"/>
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#EEF3F7"/>
            <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#356FA8" Offset="0"/>
                <GradientStop Color="#0F5B52" Offset="1"/>
            </LinearGradientBrush>
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1F3345"/>
            <SolidColorBrush x:Key="MutedTextBrush" Color="#64758D"/>
            <SolidColorBrush x:Key="HeroOverlayBrush" Color="#1FFFFFFF"/>
            <Style x:Key="ReportCardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="CornerRadius" Value="20"/>
                <Setter Property="BorderBrush" Value="#D9E3EA"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="18"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>
            <Style x:Key="ReportSecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#F1F6FA"/>
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>
            <Style x:Key="ReportPrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#2F83C5"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Padding" Value="16,10"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>
            <Style x:Key="ReportSearchTextBoxStyle" TargetType="TextBox">
                <Setter Property="Height" Value="42"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#D2DEE7"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

