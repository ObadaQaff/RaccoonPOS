<Window x:Class="RaccoonWarehouse.Permissions.PermissionGroupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مجموعات الصلاحيات / Permission Groups"
        Width="1420" Height="760" MinWidth="1180" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{StaticResource AppPageBackgroundBrush}"
        Loaded="Window_Loaded">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,18" MinHeight="68">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock Text="مجموعات الصلاحيات" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AppTextBrush}"/>
                <TextBlock Text="إدارة المجموعات والصلاحيات والمستخدمين المرتبطين بها / Manage groups, permissions, and assigned users" Margin="0,5,0,0" Foreground="{StaticResource AppMutedTextBrush}"/>
            </StackPanel>
            <Button Grid.Column="0" Content="مجموعة جديدة / New group" Width="200" Height="42" HorizontalAlignment="Left" VerticalAlignment="Bottom" Style="{StaticResource AppHeroButtonStyle}" Click="New_Click"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="*"/><ColumnDefinition Width="370"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Padding="14" Margin="0,0,14,0" Background="White" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="المجموعات / Groups" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                        <TextBlock x:Name="GroupsSummary" Margin="0,3,0,10" Foreground="{StaticResource AppMutedTextBrush}"/>
                    </StackPanel>
                    <ListBox Grid.Row="1" x:Name="GroupsList" Margin="0,8,0,0" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Group_Selected">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E7F7FB"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate>
                            <Border Padding="10" Margin="0,3" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="7">
                                    <StackPanel FlowDirection="RightToLeft">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                                    <TextBlock Text="{Binding Description}" Margin="0,3,0,0" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" Foreground="{StaticResource AppMutedTextBrush}"/>
                                <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Foreground="{StaticResource AppMutedTextBrush}"><Run Text="المستخدمون / Users: "/><Run Text="{Binding UserCount}"/><Run Text="   الصلاحيات / Permissions: "/><Run Text="{Binding PermissionCount}"/></TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="2" Content="مجموعة جديدة / New group" Height="42" Margin="0,14,0,0" Style="{StaticResource AppHeroButtonStyle}" Click="New_Click"/>
                </Grid>
            </Border>
            <Border Grid.Column="1" Padding="20" Margin="0,0,14,0" Background="White" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="بيانات المجموعة / Group details" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                        <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0"><TextBlock Text="اسم المجموعة / Group name" Style="{StaticResource AppFieldLabelStyle}"/><TextBox x:Name="GroupName" Margin="0,5,0,0" Style="{StaticResource AppTextInputStyle}"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="الوصف / Description" Style="{StaticResource AppFieldLabelStyle}"/><TextBox x:Name="GroupDescription" Margin="0,5,0,0" Style="{StaticResource AppTextInputStyle}"/></StackPanel>
                        </Grid>
                        <CheckBox x:Name="GroupActive" Content="المجموعة نشطة / Group is active" Margin="0,14,0,20" IsChecked="True"/>
                        <TextBlock Text="مصفوفة الصلاحيات / Permission matrix" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                        <TextBlock Text="حدد مستوى الوصول لكل جزء من النظام. / Select the access level for each area." Margin="0,4,0,8" Foreground="{StaticResource AppMutedTextBrush}"/>
                        <ItemsControl x:Name="PermissionsList"><ItemsControl.ItemTemplate><DataTemplate>
                            <Border Padding="8" Margin="0,2" Background="#FAFCFD" CornerRadius="5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ArabicName}" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Normal"/><Style.Triggers><DataTrigger Binding="{Binding IsCategory}" Value="True"><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/><Setter Property="Margin" Value="0,7,0,4"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                <ComboBox Grid.Column="1" Margin="14,0,0,0" ItemsSource="{Binding Levels}" SelectedItem="{Binding Level, Mode=TwoWay}" Style="{StaticResource AppComboBoxStyle}"/>
                            </Grid></Border>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border Grid.Column="2" Padding="16" Background="White" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="المستخدمون / Users" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                        <TextBlock x:Name="UsersSummary" Margin="0,4,0,10" Foreground="{StaticResource AppMutedTextBrush}"/>
                        <TextBox x:Name="UserSearchBox" Height="38" Padding="10,5" ToolTip="ابحث بالاسم أو الرقم أو الهاتف / Search by name, ID, or phone" TextChanged="UserSearchBox_TextChanged" Style="{StaticResource AppTextInputStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,9,0,8"><Button Content="تحديد النتائج / Select filtered" Height="32" Padding="10,0" Margin="0,0,6,0" Style="{StaticResource AppSecondaryButtonStyle}" Click="SelectFilteredUsers_Click"/><Button Content="مسح التحديد / Clear" Height="32" Padding="10,0" Style="{StaticResource AppSecondaryButtonStyle}" Click="ClearUsers_Click"/></StackPanel>
                    </StackPanel>
                    <ListBox x:Name="UsersList" SelectionMode="Multiple" SelectionChanged="UsersList_SelectionChanged" Margin="0,4,0,0" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Foreground="{StaticResource AppMutedTextBrush}"><Run Text="ID: "/><Run Text="{Binding Id}"/><Run Text="    "/><Run Text="{Binding PhoneNumber}"/></TextBlock></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
                </DockPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="0,10,0,0" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><Button Content="حفظ / Save" Width="140" Height="42" Style="{StaticResource AppHeroButtonStyle}" Click="Save_Click"/><Button Content="إغلاق / Close" Width="120" Height="42" Margin="8,0,0,0" Style="{StaticResource AppSecondaryButtonStyle}" Click="Close_Click"/></StackPanel>
        </Border>
    </Grid>
</Window>
