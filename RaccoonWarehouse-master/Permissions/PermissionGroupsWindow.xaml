<Window x:Class="RaccoonWarehouse.Permissions.PermissionGroupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مجموعات الصلاحيات"
        Width="1180"
        Height="760"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{StaticResource AppPageBackgroundBrush}"
        Loaded="Window_Loaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="مجموعات الصلاحيات"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="{StaticResource AppTextBrush}"
                   Margin="0,0,0,18" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Margin="0,0,18,0">
                <Button DockPanel.Dock="Bottom"
                        Content="مجموعة جديدة"
                        Height="42"
                        Margin="0,12,0,0"
                        Style="{StaticResource AppHeroButtonStyle}"
                        Click="New_Click" />
                <ListBox x:Name="GroupsList"
                         DisplayMemberPath="Name"
                         SelectionChanged="Group_Selected" />
            </DockPanel>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="بيانات المجموعة"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppTextBrush}" />
                    <TextBlock Text="اسم المجموعة"
                               Style="{StaticResource AppFieldLabelStyle}"
                               Margin="0,16,0,4" />
                    <TextBox x:Name="GroupName" Style="{StaticResource AppTextInputStyle}" />
                    <TextBlock Text="الوصف"
                               Style="{StaticResource AppFieldLabelStyle}"
                               Margin="0,12,0,4" />
                    <TextBox x:Name="GroupDescription" Style="{StaticResource AppTextInputStyle}" />
                    <CheckBox x:Name="GroupActive"
                              Content="المجموعة نشطة"
                              Margin="0,14,0,18"
                              IsChecked="True" />

                    <TextBlock Text="مصفوفة الصلاحيات"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppTextBrush}" />
                    <ItemsControl x:Name="PermissionsList" Margin="0,8,0,18">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="180" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding ArabicName}"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Normal" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCategory}" Value="True">
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                        <Setter Property="Margin" Value="0,10,0,2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding Levels}"
                                              SelectedItem="{Binding Level, Mode=TwoWay}"
                                              Style="{StaticResource AppComboBoxStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="المستخدمون"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AppTextBrush}" />
                    <ListBox x:Name="UsersList"
                             DisplayMemberPath="Name"
                             SelectionMode="Extended"
                             Height="150"
                             Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    Margin="0,18,0,0">
            <Button Content="حفظ"
                    Width="120"
                    Style="{StaticResource AppHeroButtonStyle}"
                    Click="Save_Click" />
            <Button Content="إغلاق"
                    Width="100"
                    Margin="8,0,0,0"
                    Style="{StaticResource AppSecondaryButtonStyle}"
                    Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
