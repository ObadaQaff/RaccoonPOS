<Window x:Class="RaccoonWarehouse.Notifications.NotificationToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Width="360"
        SizeToContent="Height"
        WindowStartupLocation="Manual">
    <Border x:Name="RootBorder"
            CornerRadius="18"
            BorderThickness="1"
            BorderBrush="{StaticResource AppBorderBrush}"
            Background="{StaticResource AppSurfaceBrush}"
            MouseLeftButtonUp="RootBorder_MouseLeftButtonUp">
        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="AccentBar"
                    Grid.Column="0"
                    CornerRadius="3"
                    Background="{StaticResource AppPrimaryBrush}"
                    Margin="0,0,12,0"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{StaticResource AppTextBrush}"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="MessageText"
                           Margin="0,6,0,0"
                           FontSize="13"
                           Foreground="{StaticResource AppMutedTextBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="2"
                    Width="30"
                    Height="30"
                    Margin="12,0,0,0"
                    Content="×"
                    FontSize="18"
                    FontWeight="Bold"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Foreground="{StaticResource AppMutedTextBrush}"
                    Click="CloseButton_Click"/>
        </Grid>
    </Border>
</Window>
