<Window x:Class="RaccoonWarehouse.Settings.PosRowColorSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="POS Row Colors" Height="720" Width="1120" WindowStartupLocation="CenterScreen" FlowDirection="{DynamicResource CurrentFlowDirection}" Background="{StaticResource AppPageBackgroundBrush}">
    <Grid Margin="24"><Border Style="{StaticResource AppCardBorderStyle}" Padding="22"><Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="TitleTextBlock" FontSize="25" FontWeight="Bold" Foreground="{StaticResource AppTextBrush}" Text="POS Row Colors"/>
        <TextBlock x:Name="DescriptionTextBlock" Grid.Row="1" Margin="0,8,0,16" TextWrapping="Wrap" Foreground="{StaticResource AppMutedTextBrush}" Text="Configure the rules used to highlight POS and product-search rows. Higher priority rules win."/>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
            <DataGrid x:Name="RulesGrid" Grid.Column="0" Margin="0,0,18,0" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="RulesGrid_SelectionChanged" Style="{StaticResource MinimalDataGrid}">
                <DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.5*"/><DataGridTextColumn Header="Condition" Binding="{Binding ConditionType}" Width="1.3*"/><DataGridTextColumn Header="Value" Binding="{Binding NumericValue}" Width="80"/><DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="75"/><DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="65"/><DataGridTemplateColumn Header="Preview" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Background="{Binding BackgroundColor}" BorderBrush="{Binding AccentColor}" BorderThickness="2" CornerRadius="5" Margin="5"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
            </DataGrid>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel>
                <TextBlock x:Name="EditorTitleTextBlock" FontSize="19" FontWeight="Bold" Foreground="{StaticResource AppTextBrush}" Text="Rule editor"/>
                <TextBlock x:Name="NameLabel" Style="{StaticResource AppFieldLabelStyle}" Text="Rule name"/><TextBox x:Name="NameTextBox" Style="{StaticResource AppTextBoxStyle}"/>
                <TextBlock x:Name="ConditionLabel" Style="{StaticResource AppFieldLabelStyle}" Text="Condition"/><ComboBox x:Name="ConditionComboBox" Style="{StaticResource AppComboBoxStyle}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectionChanged="ConditionComboBox_SelectionChanged"/>
                <TextBlock x:Name="ValueLabel" Style="{StaticResource AppFieldLabelStyle}" Text="Value"/><TextBox x:Name="ValueTextBox" Style="{StaticResource AppTextBoxStyle}"/>
                <TextBlock x:Name="CategoryLabel" Style="{StaticResource AppFieldLabelStyle}" Text="Category ID or name (optional)"/><TextBox x:Name="CategoryTextBox" Style="{StaticResource AppTextBoxStyle}"/>
                <TextBlock x:Name="PriorityLabel" Style="{StaticResource AppFieldLabelStyle}" Text="Priority"/><TextBox x:Name="PriorityTextBox" Style="{StaticResource AppTextBoxStyle}"/><CheckBox x:Name="ActiveCheckBox" Margin="0,10,0,8" Content="Active"/>
                <TextBlock x:Name="BackgroundLabel" Style="{StaticResource AppFieldLabelStyle}" Text="Background color"/><DockPanel><Border x:Name="BackgroundPreview" Width="34" Height="32" DockPanel.Dock="Right" Margin="8,0,0,0" BorderBrush="#90A4AE" BorderThickness="1"/><TextBox x:Name="BackgroundTextBox" Style="{StaticResource AppTextBoxStyle}" TextChanged="ColorTextChanged"/></DockPanel>
                <TextBlock x:Name="ForegroundLabel" Style="{StaticResource AppFieldLabelStyle}" Text="Text color"/><DockPanel><Border x:Name="ForegroundPreview" Width="34" Height="32" DockPanel.Dock="Right" Margin="8,0,0,0" BorderBrush="#90A4AE" BorderThickness="1"/><TextBox x:Name="ForegroundTextBox" Style="{StaticResource AppTextBoxStyle}" TextChanged="ColorTextChanged"/></DockPanel>
                <TextBlock x:Name="AccentLabel" Style="{StaticResource AppFieldLabelStyle}" Text="Accent color"/><DockPanel><Border x:Name="AccentPreview" Width="34" Height="32" DockPanel.Dock="Right" Margin="8,0,0,0" BorderBrush="#90A4AE" BorderThickness="1"/><TextBox x:Name="AccentTextBox" Style="{StaticResource AppTextBoxStyle}" TextChanged="ColorTextChanged"/></DockPanel>
                <TextBlock x:Name="RowPreviewLabel" Margin="0,14,0,4" Style="{StaticResource AppFieldLabelStyle}" Text="Live preview"/><Border x:Name="RowPreview" Height="42" Padding="10" CornerRadius="6" BorderThickness="2"><TextBlock x:Name="RowPreviewText" Text="Example product row" VerticalAlignment="Center" FontWeight="SemiBold"/></Border>
            </StackPanel></ScrollViewer>
        </Grid>
        <Grid Grid.Row="3" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button x:Name="AddButton" Width="120" Margin="0,0,8,0" Style="{StaticResource AppSecondaryButtonStyle}" Content="Add" Click="AddButton_Click"/><Button x:Name="DeleteButton" Width="120" Margin="0,0,8,0" Style="{StaticResource AppSecondaryButtonStyle}" Content="Delete" Click="DeleteButton_Click"/><Button x:Name="DefaultsButton" Width="155" Style="{StaticResource AppSecondaryButtonStyle}" Content="Restore defaults" Click="DefaultsButton_Click"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="CancelButton" Width="120" Margin="0,0,10,0" Style="{StaticResource AppSecondaryButtonStyle}" Content="Cancel" Click="CancelButton_Click"/><Button x:Name="SaveButton" Width="140" Style="{StaticResource AppHeroButtonStyle}" Content="Save" Click="SaveButton_Click"/></StackPanel></Grid>
    </Grid></Border></Grid>
</Window>
