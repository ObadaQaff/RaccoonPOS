<Window x:Class="RaccoonWarehouse.Settings.AuditLogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audit Logs"
        Height="850" Width="1450"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{StaticResource AppPageBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24" CornerRadius="22" Background="{StaticResource AppDashboardHeroBrush}">
            <StackPanel>
                <TextBlock Text="سجل مراجعة النظام" FontSize="30" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="System audit log" Margin="0,6,0,0" Foreground="#D7F1FF" />
                <TextBlock x:Name="StatusText" Margin="0,10,0,0" Foreground="#D7F1FF" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="0,16,0,16" Padding="16" Style="{StaticResource AppCardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Grid.Column="0" Margin="0,0,10,0" Height="38" Padding="10" ToolTip="Search action, entity, permission, or error" />
                <TextBox x:Name="UserIdBox" Grid.Column="1" Margin="0,0,10,0" Height="38" Padding="10" ToolTip="Employee ID" />
                <ComboBox x:Name="ResultFilterBox" Grid.Column="2" Margin="0,0,10,0" Height="38" SelectedIndex="0">
                    <ComboBoxItem Content="All results" Tag="" />
                    <ComboBoxItem Content="Successful" Tag="true" />
                    <ComboBoxItem Content="Failed" Tag="false" />
                </ComboBox>
                <Button Grid.Column="3" Margin="0,0,10,0" Padding="18,8" Style="{StaticResource AppHeroButtonStyle}" Click="SearchButton_Click" Content="Search" />
                <Button Grid.Column="4" Padding="18,8" Style="{StaticResource AppSecondaryButtonStyle}" Click="RefreshButton_Click" Content="Refresh" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Padding="12" Style="{StaticResource AppCardBorderStyle}">
            <DataGrid x:Name="AuditGrid" Style="{StaticResource AppModernDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding CreatedDate, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="170" />
                    <DataGridTextColumn Header="Employee" Binding="{Binding UserName}" Width="1.5*" />
                    <DataGridTextColumn Header="User ID" Binding="{Binding UserId}" Width="80" />
                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100" />
                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="1.3*" />
                    <DataGridTextColumn Header="Permission" Binding="{Binding PermissionKey}" Width="1.6*" />
                    <DataGridTextColumn Header="Entity" Binding="{Binding EntityType}" Width="1.2*" />
                    <DataGridTextColumn Header="Result" Binding="{Binding Succeeded}" Width="90" />
                    <DataGridTextColumn Header="Error" Binding="{Binding ErrorMessage}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Padding="18,8" Style="{StaticResource AppSecondaryButtonStyle}" Click="NextButton_Click" Content="Next" />
            <Button DockPanel.Dock="Right" Margin="0,0,10,0" Padding="18,8" Style="{StaticResource AppSecondaryButtonStyle}" Click="PreviousButton_Click" Content="Previous" />
            <TextBlock x:Name="PageText" VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource AppMutedTextBrush}" />
        </DockPanel>
    </Grid>
</Window>
