<Window x:Class="RaccoonWarehouse.Settings.AuditLogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audit Logs"
        Height="900" Width="1550"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{StaticResource AppPageBackgroundBrush}">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="30,24" CornerRadius="24" Background="{StaticResource AppDashboardHeroBrush}">
            <StackPanel>
                <TextBlock Text="سجل مراجعة النظام" FontSize="30" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="System audit log" Margin="0,8,0,0" FontSize="15" Foreground="#D7F1FF" />
                <TextBlock x:Name="StatusText" Margin="0,12,0,0" FontSize="14" Foreground="#D7F1FF" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="0,18,0,18" Padding="20" Style="{StaticResource AppCardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,12,6" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AppMutedTextBrush}" Text="Search action, entity, permission, or error" />
                <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,12,6" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AppMutedTextBrush}" Text="Employee ID" />
                <TextBlock Grid.Row="0" Grid.Column="2" Margin="0,0,12,6" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AppMutedTextBrush}" Text="Result" />
                <TextBox x:Name="SearchBox" Grid.Row="1" Grid.Column="0" Margin="0,0,12,0" Height="46" Padding="12,8" FontSize="15" ToolTip="Search action, entity, permission, or error" />
                <TextBox x:Name="UserIdBox" Grid.Row="1" Grid.Column="1" Margin="0,0,12,0" Height="46" Padding="12,8" FontSize="15" ToolTip="Employee ID" />
                <ComboBox x:Name="ResultFilterBox" Grid.Row="1" Grid.Column="2" Margin="0,0,12,0" Height="46" FontSize="15" SelectedIndex="0">
                    <ComboBoxItem Content="All results" Tag="" />
                    <ComboBoxItem Content="Successful" Tag="true" />
                    <ComboBoxItem Content="Failed" Tag="false" />
                </ComboBox>
                <Button Grid.Row="1" Grid.Column="3" Margin="0,0,10,0" MinWidth="110" Height="46" Padding="18,8" FontSize="15" Style="{StaticResource AppHeroButtonStyle}" Click="SearchButton_Click" Content="Search" />
                <Button Grid.Row="1" Grid.Column="4" MinWidth="110" Height="46" Padding="18,8" FontSize="15" Style="{StaticResource AppSecondaryButtonStyle}" Click="RefreshButton_Click" Content="Refresh" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Padding="16" Style="{StaticResource AppCardBorderStyle}">
            <DataGrid x:Name="AuditGrid" Style="{StaticResource AppModernDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True" FontSize="14" RowHeight="42" ColumnHeaderHeight="46">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding CreatedDate, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="170" />
                    <DataGridTextColumn Header="Employee" Binding="{Binding UserName}" Width="1.5*" />
                    <DataGridTextColumn Header="User ID" Binding="{Binding UserId}" Width="80" />
                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100" />
                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="1.3*" />
                    <DataGridTextColumn Header="Permission" Binding="{Binding PermissionKey}" Width="1.6*" />
                    <DataGridTextColumn Header="Entity" Binding="{Binding EntityType}" Width="1.2*" />
                    <DataGridTextColumn Header="Result" Binding="{Binding Succeeded}" Width="90" />
                    <DataGridTextColumn Header="Error" Binding="{Binding ErrorMessage}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" MinWidth="110" Height="44" Padding="18,8" FontSize="14" Style="{StaticResource AppSecondaryButtonStyle}" Click="NextButton_Click" Content="Next" />
            <Button DockPanel.Dock="Right" Margin="0,0,10,0" MinWidth="110" Height="44" Padding="18,8" FontSize="14" Style="{StaticResource AppSecondaryButtonStyle}" Click="PreviousButton_Click" Content="Previous" />
            <TextBlock x:Name="PageText" VerticalAlignment="Center" FontSize="15" Foreground="{StaticResource AppMutedTextBrush}" />
        </DockPanel>
    </Grid>
</Window>
