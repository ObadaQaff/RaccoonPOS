<Window x:Class="RaccoonWarehouse.Settings.ReportPermissionsManager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مدير صلاحيات النظام"
        Height="900"
        Width="1520"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{StaticResource PageBackgroundBrush}">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1F3345"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#64758D"/>
        <SolidColorBrush x:Key="HeroOverlayBrush" Color="#1FFFFFFF"/>

        <Style x:Key="FilterLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ReportCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="BorderBrush" Value="#D9E3EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="ReportSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F6FA"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReportPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2F83C5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReportSearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D2DEE7"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ActionCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Root"
                                Background="#F7FAFC"
                                BorderBrush="#D2DEE7"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="18"
                                        Height="18"
                                        Margin="0,0,8,0"
                                        CornerRadius="9"
                                        Background="White"
                                        BorderBrush="#A9BBC8"
                                        BorderThickness="1">
                                    <Path x:Name="Tick"
                                          Visibility="Collapsed"
                                          Stroke="White"
                                          StrokeThickness="2.2"
                                          Data="M 4 9 L 7.5 12.5 L 14 5.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E5F4EC"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#65A67C"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tick" Property="Stroke" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="TextElement.Foreground" Value="#184F2F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PermissionRowBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E1E6EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="210"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="0,0,34,34" Background="{StaticResource HeroBrush}">
            <Grid Margin="34,24,34,34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="مدير صلاحيات النظام" FontSize="34" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="إدارة الصلاحيات حسب الدور والوحدة والإجراء من شاشة واحدة أكثر وضوحاً وقابلية للتوسع."
                           Margin="0,10,0,0"
                           FontSize="14"
                           Foreground="#D7F1FF"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Padding="18,12"
                    CornerRadius="22"
                    Background="{StaticResource HeroOverlayBrush}"
                    VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="عدد الصلاحيات المحددة"
                                   FontSize="12"
                                   Foreground="#CFE8E3"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="SelectedCountText"
                                   Margin="0,4,0,0"
                                   Style="{StaticResource MetricValueStyle}"
                                   Foreground="White"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,-52,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource ReportCardBorderStyle}" Padding="22">
                <StackPanel>
                    <TextBlock Text="عناصر التحكم" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                    <TextBlock x:Name="SummaryTextBlock"
                               Margin="0,8,0,20"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="الدور" Style="{StaticResource FilterLabelStyle}"/>
                    <ComboBox x:Name="RoleComboBox"
                              Margin="0,0,0,16"
                              Style="{StaticResource AppComboBoxStyle}"
                              SelectionChanged="RoleComboBox_SelectionChanged"/>

                    <TextBlock Text="الوحدة" Style="{StaticResource FilterLabelStyle}"/>
                    <ComboBox x:Name="ModuleComboBox"
                              Margin="0,0,0,16"
                              Style="{StaticResource AppComboBoxStyle}"
                              SelectionChanged="ModuleComboBox_SelectionChanged"/>

                    <TextBlock Text="بحث" Style="{StaticResource FilterLabelStyle}"/>
                    <TextBox x:Name="SearchTextBox"
                             Margin="0,0,0,20"
                             Style="{StaticResource ReportSearchTextBoxStyle}"
                             TextChanged="SearchTextBox_TextChanged"/>

                    <Border Background="#F6FAFD" BorderBrush="#DCE7EF" BorderThickness="1" CornerRadius="18" Padding="16" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="ملخص سريع" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                            <TextBlock x:Name="VisibleRowsText"
                                       Margin="0,10,0,4"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBlock x:Name="VisibleActionsText"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                    </Border>

                    <Button Margin="0,0,0,10"
                            Style="{StaticResource ReportSecondaryButtonStyle}"
                            Click="SelectAllModuleBtn_Click"
                            Content="تحديد كل الإجراءات المعروضة"/>
                    <Button Margin="0,0,0,10"
                            Style="{StaticResource ReportSecondaryButtonStyle}"
                            Click="ClearModuleBtn_Click"
                            Content="إلغاء كل الإجراءات المعروضة"/>
                    <Button Margin="0,8,0,10"
                            Style="{StaticResource ReportPrimaryButtonStyle}"
                            Click="SaveBtn_Click"
                            Content="حفظ الصلاحيات"/>
                    <Button Style="{StaticResource ReportSecondaryButtonStyle}"
                            Click="CloseBtn_Click"
                            Content="إغلاق"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource ReportCardBorderStyle}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,14">
                        <TextBlock Text="قائمة الموارد والصلاحيات"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   DockPanel.Dock="Right"/>
                        <TextBlock Text="كل مورد يعرض إجراءاته بشكل واضح داخل نفس البطاقة."
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   DockPanel.Dock="Left"/>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PermissionsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PermissionRowBorderStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                                <Border Background="#EDF6FB" BorderBrush="#CFE3EF" BorderThickness="1" CornerRadius="12" Padding="12,6" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding Module}" FontWeight="SemiBold" Foreground="#2A617E"/>
                                                </Border>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Margin="0,14,0,8"
                                                           FontSize="18"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Resource}"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"/>
                                                <Button Margin="0,14,0,0"
                                                        Padding="12,8"
                                                        HorizontalAlignment="Right"
                                                        Style="{StaticResource ReportSecondaryButtonStyle}"
                                                        Click="SelectAllRow_Click"
                                                        Content="تحديد كل إجراءات هذا المورد"/>
                                            </StackPanel>

                                            <Border Grid.Column="1" Background="#FBFDFE" BorderBrush="#E4EBF1" BorderThickness="1" CornerRadius="18" Padding="16">
                                                <ItemsControl ItemsSource="{Binding Actions}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Style="{StaticResource ActionCheckBoxStyle}"
                                                                      IsChecked="{Binding IsAllowed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                                <TextBlock Text="{Binding DisplayName}"/>
                                                            </CheckBox>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
