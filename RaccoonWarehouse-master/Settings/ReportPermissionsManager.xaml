<Window xmlns:security="clr-namespace:RaccoonWarehouse.Security" x:Class="RaccoonWarehouse.Settings.ReportPermissionsManager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إدارة الأدوار والصلاحيات" Width="1180" Height="800" MinWidth="850"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen" Background="#F3F6FA">
    <Window.Resources>
        <DataTemplate x:Key="PermissionCell">
            <Grid>
                <TextBlock Text="—" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Supported}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" Background="White"
                          IsEnabled="{Binding Editable}" IsThreeState="False" IsChecked="{Binding IsAllowed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers><DataTrigger Binding="{Binding Supported}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="إدارة الأدوار والصلاحيات" FontSize="25" FontWeight="Bold" Margin="0,0,0,12"/>
            <TextBlock Text="الحالة المختلطة تحفظ القيود الحالية. لا تتغير الصلاحيات إلا عند تعديلها صراحةً." TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBlock Text="الإضافة والتعديل والحذف تتطلب العرض. الصلاحيات المتقدمة مستقلة." TextWrapping="Wrap" Margin="0,0,0,12"/>
            <WrapPanel Margin="0,0,0,15">
                <TextBlock Text="الدور" VerticalAlignment="Center" Margin="8"/>
                <ComboBox x:Name="RoleComboBox" Width="160" SelectionChanged="RoleChanged"/>
                <TextBlock Text="الوحدة" VerticalAlignment="Center" Margin="8"/>
                <ComboBox x:Name="ModuleComboBox" Width="180" SelectionChanged="FilterChanged"/>
                <TextBlock Text="بحث" VerticalAlignment="Center" Margin="8"/>
                <TextBox x:Name="SearchTextBox" Width="220" TextChanged="FilterTextChanged"/>
            </WrapPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="SaveButton" Content="حفظ الصلاحيات" Click="Save" Padding="20,10" Margin="0,0,0,0" security:PermissionWindowGuard.Keys="Permissions.ManageRoles"/>
            <Button Content="تحديد الصلاحيات الأساسية المعروضة" Click="SelectAll" Padding="15,10" Margin="8,0"/>
            <Button Content="إلغاء الصلاحيات الأساسية المعروضة" Click="ClearAll" Padding="15,10"/>
            <Button Content="إغلاق" Click="CloseWindow" Padding="15,10" Margin="8,0"/>
        </StackPanel>
        <TabControl>
            <TabItem Header="الصلاحيات الأساسية">
                <DataGrid x:Name="PermissionsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True" HeadersVisibility="Column" Background="White">
                    <DataGrid.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="17" Margin="12"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></DataGrid.GroupStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الشاشة / القسم" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="عرض" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Content="{Binding View}" ContentTemplate="{StaticResource PermissionCell}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="إضافة وتعديل" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Content="{Binding CreateEdit}" ContentTemplate="{StaticResource PermissionCell}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="حذف" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Content="{Binding Delete}" ContentTemplate="{StaticResource PermissionCell}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="صلاحيات متقدمة">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="الاعتماد والترحيل والدفع وإدارة الأمان مستقلة عن الإضافة والتعديل." TextWrapping="Wrap" Margin="12"/>
                    <DataGrid x:Name="AdvancedGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الوحدة" Binding="{Binding Module}" Width="150" IsReadOnly="True"/>
                            <DataGridTextColumn Header="الشاشة / القسم" Binding="{Binding Screen}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="العملية" Binding="{Binding Label}" Width="*" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="السماح" Width="95"><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Content="{Binding}" ContentTemplate="{StaticResource PermissionCell}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
