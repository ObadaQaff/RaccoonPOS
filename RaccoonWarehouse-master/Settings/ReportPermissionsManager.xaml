<Window x:Class="RaccoonWarehouse.Settings.ReportPermissionsManager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مدير صلاحيات النظام"
        Height="840"
        Width="1480"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{StaticResource AppPageBackgroundBrush}">
    <Grid Background="{StaticResource AppPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="210"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="0,0,34,34" Background="{StaticResource AppDashboardHeroBrush}">
            <Grid Margin="34,24,34,34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="مدير صلاحيات النظام" FontSize="34" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="إدارة الصلاحيات حسب الدور والوحدة والإجراء من شاشة واحدة موحدة."
                               Margin="0,10,0,0"
                               FontSize="14"
                               Foreground="#D7F1FF"/>
                </StackPanel>
                <Border Grid.Column="1" Padding="18,12" CornerRadius="20" Background="#1FFFFFFF" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="عدد الصلاحيات المحددة" FontSize="12" Foreground="#CFE8E3" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="SelectedCountText" Margin="0,4,0,0" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,-52,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource AppCardBorderStyle}" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="الدور" Margin="0,0,0,6"/>
                        <ComboBox x:Name="RoleComboBox" Style="{StaticResource AppComboBoxStyle}" SelectionChanged="RoleComboBox_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="الوحدة" Margin="0,0,0,6"/>
                        <ComboBox x:Name="ModuleComboBox" Style="{StaticResource AppComboBoxStyle}" SelectionChanged="ModuleComboBox_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="بحث" Margin="0,0,0,6"/>
                        <TextBox x:Name="SearchTextBox" Style="{StaticResource AppSearchTextBoxStyle}" TextChanged="SearchTextBox_TextChanged"/>
                    </StackPanel>

                    <TextBlock x:Name="SummaryTextBlock"
                               Grid.Column="3"
                               VerticalAlignment="Bottom"
                               Margin="10,0"
                               Foreground="{StaticResource AppMutedTextBrush}"
                               FontSize="13"/>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Width="130" Margin="0,0,10,0" Style="{StaticResource AppSecondaryButtonStyle}" Click="SelectAllModuleBtn_Click" Content="تحديد الكل"/>
                        <Button Width="130" Margin="0,0,10,0" Style="{StaticResource AppSecondaryButtonStyle}" Click="ClearModuleBtn_Click" Content="إلغاء الكل"/>
                        <Button Width="130" Margin="0,0,10,0" Style="{StaticResource AppHeroButtonStyle}" Click="SaveBtn_Click" Content="حفظ"/>
                        <Button Width="120" Style="{StaticResource AppSecondaryButtonStyle}" Click="CloseBtn_Click" Content="إغلاق"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="0,18,0,0" Style="{StaticResource AppCardBorderStyle}" Padding="16">
                <DataGrid x:Name="PermissionsGrid"
                          AutoGenerateColumns="False"
                          Style="{StaticResource AppModernDataGridStyle}"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"/>
            </Border>
        </Grid>
    </Grid>
</Window>
