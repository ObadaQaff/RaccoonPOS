<Window
        x:Class="RaccoonWarehouse.Settings.JordanEInvoiceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JoFotara Settings"
        Height="700"
        Width="760"
        WindowStartupLocation="CenterScreen"
        FlowDirection="{DynamicResource CurrentFlowDirection}"
        Background="{StaticResource AppPageBackgroundBrush}">
    <Grid Margin="24">
        <Border Style="{StaticResource AppCardBorderStyle}" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TitleTextBlock"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{StaticResource AppTextBrush}"/>
                <TextBlock x:Name="DescriptionTextBlock"
                           Grid.Row="1"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource AppMutedTextBrush}"/>

                <StackPanel Grid.Row="2" Margin="0,24,0,0">
                    <CheckBox x:Name="EnabledCheckBox"
                              Content="Enable JoFotara for POS sales"/>

                    <TextBlock x:Name="ClientIdLabelTextBlock" Style="{StaticResource AppFieldLabelStyle}" Margin="0,18,0,0"/>
                    <TextBox x:Name="ClientIdTextBox" Style="{StaticResource AppTextInputStyle}"/>

                    <TextBlock x:Name="SecretKeyLabelTextBlock" Style="{StaticResource AppFieldLabelStyle}" Margin="0,14,0,0"/>
                    <PasswordBox x:Name="SecretKeyBox" MinHeight="42" Padding="12,8"/>

                    <TextBlock x:Name="IncomeSourceLabelTextBlock" Style="{StaticResource AppFieldLabelStyle}" Margin="0,14,0,0"/>
                    <TextBox x:Name="IncomeSourceSequenceTextBox" Style="{StaticResource AppTextInputStyle}"/>

                    <TextBlock x:Name="TaxRegistrationLabelTextBlock" Style="{StaticResource AppFieldLabelStyle}" Margin="0,14,0,0"/>
                    <TextBox x:Name="TaxRegistrationTypeTextBox" Style="{StaticResource AppTextInputStyle}"/>

                    <TextBlock x:Name="StatusTextBlock"
                               Margin="0,16,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource AppMutedTextBrush}"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,24,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton"
                            Width="120"
                            Margin="0,0,12,0"
                            Style="{StaticResource AppSecondaryButtonStyle}"
                            Click="CancelButton_Click"/>
                    <Button x:Name="SaveButton"
                            Width="140"
                            Style="{StaticResource AppHeroButtonStyle}"
                            Click="SaveButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
