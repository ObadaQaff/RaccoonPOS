<Window x:Class="RaccoonWarehouse.Invoices.PurchaseProductSearchWindow"
        PreviewKeyDown="PurchaseProductSearchWindow_PreviewKeyDown" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RaccoonWarehouse.Helpers.Converters"
        Title="بحث عن مادة للمشتريات" Height="720" Width="1420" MinWidth="1100" WindowStartupLocation="CenterOwner" Background="#F2F6FA" Loaded="Window_Loaded">
    <Window.Resources>
        <local:FlexibleDecimalConverter x:Key="FlexibleDecimalConverter"/>
        <Style x:Key="ProductInputStyle" TargetType="Control"><Setter Property="Height" Value="42"/><Setter Property="FontSize" Value="15"/><Setter Property="Padding" Value="10,6"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#B8C9D8"/><Setter Property="BorderThickness" Value="1"/></Style>
        <Style x:Key="ProductPrimaryButtonStyle" TargetType="Button"><Setter Property="Height" Value="42"/><Setter Property="Padding" Value="18,7"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#3396D3"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style x:Key="ProductSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ProductPrimaryButtonStyle}"><Setter Property="Foreground" Value="#23658D"/><Setter Property="Background" Value="#E4EEF5"/></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#E8F1F7"/><Setter Property="Foreground" Value="#1F526F"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="10,8"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style>
        <Style TargetType="DataGridRow"><Setter Property="MinHeight" Value="42"/><Setter Property="Background" Value="White"/><Style.Triggers><Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="#F7FAFC"/></Trigger></Style.Triggers></Style>
        <Style x:Key="ProductValueTextStyle" TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="TextAlignment" Value="Left"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    </Window.Resources>
    <Grid Margin="26,22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#3396D3" CornerRadius="12" Padding="22,16" Margin="0,0,0,16"><StackPanel><TextBlock Text="بحث عن مادة للمشتريات" Foreground="White" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="ابحث باسم الصنف أو الكود أو الباركود" Foreground="#EAF6FD" FontSize="14" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Border>
        <Border Grid.Row="1" Background="White" CornerRadius="12" BorderBrush="#D3E0EA" BorderThickness="1" Padding="16" Margin="0,0,0,14">
            <Grid FlowDirection="RightToLeft"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="6"><TextBlock Text="اسم المادة / Product name" Foreground="#31566E" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBox x:Name="SearchTextBox" Style="{StaticResource ProductInputStyle}" HorizontalContentAlignment="Right" TextChanged="SearchTextBox_TextChanged" PreviewKeyDown="SearchTextBox_PreviewKeyDown"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="6"><TextBlock Text="المورد / Supplier" Foreground="#31566E" FontWeight="SemiBold" Margin="0,0,0,6"/><ComboBox x:Name="SupplierFilter" Style="{StaticResource ProductInputStyle}" IsEditable="True" IsTextSearchEnabled="False" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="SupplierFilter_SelectionChanged"/></StackPanel>
                <StackPanel Grid.Column="2" Margin="6"><TextBlock Text="الباركود / Barcode" Foreground="#31566E" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBox x:Name="BarcodeSearchTextBox" Style="{StaticResource ProductInputStyle}" TextChanged="BarcodeSearchTextBox_TextChanged" PreviewKeyDown="BarcodeSearchTextBox_PreviewKeyDown"/></StackPanel>
                <Button Grid.Column="3" Content="مسح" Style="{StaticResource ProductSecondaryButtonStyle}" Margin="8,23,0,0" Click="ClearBtn_Click"/><Button Grid.Column="4" Content="إغلاق" Style="{StaticResource ProductPrimaryButtonStyle}" Margin="8,23,0,0" Click="CloseBtn_Click"/>
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="White" CornerRadius="12" BorderBrush="#D3E0EA" BorderThickness="1" Padding="10">
            <DataGrid x:Name="ProductsGrid" AutoGenerateColumns="False" IsReadOnly="False" AlternationCount="2" SelectionMode="Single" SelectionUnit="CellOrRowHeader" FlowDirection="RightToLeft" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E1EAF0" RowHeaderWidth="0" PreviewKeyDown="ProductsGrid_PreviewKeyDown">
                <DataGrid.Columns><DataGridTextColumn Header="الكود" Binding="{Binding ItemCode}" ElementStyle="{StaticResource ProductValueTextStyle}" IsReadOnly="True" Width="150"/><DataGridTextColumn Header="اسم الصنف" Binding="{Binding ProductName}" ElementStyle="{StaticResource ProductValueTextStyle}" IsReadOnly="True" Width="2.2*"/><DataGridTemplateColumn Header="الوحدة" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Unit.Name"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, UpdateSourceTrigger=LostFocus}" Width="100"/><DataGridTextColumn Header="سعر الشراء" Binding="{Binding PurchasePrice, Converter={StaticResource FlexibleDecimalConverter}, UpdateSourceTrigger=LostFocus}" Width="135"/><DataGridTemplateColumn Header="سعر البيع" Width="135"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SalePrice, Converter={StaticResource FlexibleDecimalConverter}}" Style="{StaticResource ProductValueTextStyle}"/></DataTemplate></DataGridTemplateColumn.CellTemplate><DataGridTemplateColumn.CellEditingTemplate><DataTemplate><TextBox Text="{Binding SalePrice, Mode=TwoWay, Converter={StaticResource FlexibleDecimalConverter}, UpdateSourceTrigger=LostFocus}" FlowDirection="LeftToRight" HorizontalContentAlignment="Left" Loaded="SalePriceTextBox_Loaded" GotFocus="SalePriceTextBox_GotFocus"/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="تاريخ الانتهاء" Width="155"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ExpiryDate, StringFormat=dd/MM/yyyy}" FlowDirection="LeftToRight"/></DataTemplate></DataGridTemplateColumn.CellTemplate><DataGridTemplateColumn.CellEditingTemplate><DataTemplate><DatePicker SelectedDate="{Binding ExpiryDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Language="en-GB" SelectedDateFormat="Short" Loaded="ExpiryDatePicker_Loaded" GotFocus="ExpiryDatePicker_GotFocus"/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="إضافة" Width="105"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="إضافة" Style="{StaticResource ProductPrimaryButtonStyle}" Height="32" Padding="10,3" Click="SelectProductBtn_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
            </DataGrid>
        </Border>
        <Grid Grid.Row="3" Margin="0,12,0,0"><TextBlock Text="اكتب اسم الصنف أو الكود، ثم اضغط Enter للإضافة" HorizontalAlignment="Center" Foreground="#2D8DCF" FontSize="14" FontWeight="SemiBold"/><Button x:Name="CreateProductBtn" Content="إضافة منتج جديد" Visibility="Collapsed" HorizontalAlignment="Right" Padding="14,7" Click="CreateProductBtn_Click"/></Grid>
    </Grid>
</Window>
