<Window x:Class="RaccoonWarehouse.Invoices.PurchaseProductSearchWindow" PreviewKeyDown="PurchaseProductSearchWindow_PreviewKeyDown" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RaccoonWarehouse.Helpers.Converters" Title="بحث عن مادة للمشتريات" Height="650" Width="1100" WindowStartupLocation="CenterOwner" Background="#F2F6FA">
   <Window.Resources><local:FlexibleDecimalConverter x:Key="FlexibleDecimalConverter"/></Window.Resources>
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="White" CornerRadius="12" Padding="12" BorderBrush="#D0D7DD" BorderThickness="1"><Grid FlowDirection="RightToLeft"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchTextBox" Height="40" FontSize="16" Padding="8" VerticalContentAlignment="Center" TextChanged="SearchTextBox_TextChanged" PreviewKeyDown="SearchTextBox_PreviewKeyDown" Grid.Column="0"/><Button Grid.Column="1" Content="مسح" Width="110" Margin="10,0,0,0" Click="ClearBtn_Click"/><Button Grid.Column="2" Content="إغلاق" Width="110" Margin="10,0,0,0" Click="CloseBtn_Click"/></Grid></Border>
  <Border Grid.Row="1" Margin="0,15,0,10" Background="White" CornerRadius="12" Padding="10" BorderBrush="#D0D7DD" BorderThickness="1"><DataGrid x:Name="ProductsGrid" AutoGenerateColumns="False" IsReadOnly="False" SelectionMode="Single" SelectionUnit="CellOrRowHeader" FlowDirection="RightToLeft" CanUserAddRows="False" PreviewKeyDown="ProductsGrid_PreviewKeyDown"><DataGrid.Columns><DataGridTextColumn Header="الكود" Binding="{Binding ItemCode}" IsReadOnly="True" Width="140"/><DataGridTextColumn Header="اسم الصنف" Binding="{Binding ProductName}" IsReadOnly="True" Width="*"/><DataGridTemplateColumn Header="الوحدة" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Unit.Name"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, UpdateSourceTrigger=LostFocus}" Width="100"/><DataGridTextColumn Header="سعر الشراء" Binding="{Binding PurchasePrice, Converter={StaticResource FlexibleDecimalConverter}, UpdateSourceTrigger=LostFocus}" Width="130"/><DataGridTemplateColumn Header="تاريخ الانتهاء" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ExpiryDate, StringFormat=yyyy-MM-dd}"/></DataTemplate></DataGridTemplateColumn.CellTemplate><DataGridTemplateColumn.CellEditingTemplate><DataTemplate><DatePicker SelectedDate="{Binding ExpiryDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellEditingTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="إضافة" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="إضافة" Padding="8,4" Click="SelectProductBtn_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Border>
  <TextBlock Grid.Row="2" Text="اكتب اسم الصنف أو الكود، عدّل الخلايا بالأسهم ثم اضغط Enter للإضافة." HorizontalAlignment="Center" Foreground="#2D8DCF" FontWeight="SemiBold" Margin="0,8,0,0"/>
  <Button x:Name="CreateProductBtn" Grid.Row="2" Content="Add Product / إضافة منتج" Visibility="Collapsed" HorizontalAlignment="Right" Margin="0,8,8,0" Padding="12,5" Click="CreateProductBtn_Click"/>
 </Grid>
</Window>
