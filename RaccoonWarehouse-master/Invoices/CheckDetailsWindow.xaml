<Window x:Class="RaccoonWarehouse.Invoices.CheckDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="شيكات الفاتورة"
        Height="620"
        Width="980"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F6F8FB">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#EAF3FB" CornerRadius="14" Padding="14" Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="TitleText"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#1F3B58"
                           DockPanel.Dock="Right"/>
                <TextBlock x:Name="ExpectedAmountText"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="#334155"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="14" Padding="14" Margin="0,0,0,12" BorderBrush="#D9E2EC" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.0*"/>
                    <ColumnDefinition Width="1.0*"/>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="6,0">
                    <TextBlock x:Name="CheckNumberLabel" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="CheckNumberBox" Height="32"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="6,0">
                    <TextBlock x:Name="BankNameLabel" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="BankNameBox" Height="32"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="6,0">
                    <TextBlock x:Name="DueDateLabel" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <DatePicker x:Name="CheckDueDatePicker" Height="32"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="6,0">
                    <TextBlock x:Name="AmountLabel" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="CheckAmountBox" Height="32"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Margin="6,0">
                    <TextBlock x:Name="NotesLabel" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="CheckNotesBox" Height="32"/>
                </StackPanel>

                <Button Grid.Column="5"
                        x:Name="AddCheckButton"
                        Content="إضافة"
                        Width="110"
                        Height="34"
                        Margin="12,22,0,0"
                        Click="AddCheck_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="14" Padding="10" BorderBrush="#D9E2EC" BorderThickness="1">
            <DataGrid x:Name="ChecksGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="False"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      ItemsSource="{Binding Checks}"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="CheckNumberColumn" Binding="{Binding CheckNumber}" Width="140"/>
                    <DataGridTextColumn x:Name="BankNameColumn" Binding="{Binding BankName}" Width="150"/>
                    <DataGridTextColumn x:Name="DueDateColumn" Binding="{Binding DueDate, StringFormat=yyyy/MM/dd}" Width="120"/>
                    <DataGridTextColumn x:Name="AmountColumn" Binding="{Binding Amount}" Width="110"/>
                    <DataGridTextColumn x:Name="NotesColumn" Binding="{Binding Notes}" Width="*"/>
                    <DataGridTemplateColumn x:Name="DeleteColumn" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Click="DeleteCheck_Click"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        ToolTip="حذف">
                                    <iconPacks:PackIconMaterial Kind="Delete" Width="18" Height="18" Foreground="#D32F2F"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button x:Name="OkButton"
                    Content="موافق"
                    Width="130"
                    Height="36"
                    Margin="6,0"
                    Click="OkButton_Click"/>
            <Button x:Name="CancelButton"
                    Content="إلغاء"
                    Width="130"
                    Height="36"
                    Margin="6,0"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
