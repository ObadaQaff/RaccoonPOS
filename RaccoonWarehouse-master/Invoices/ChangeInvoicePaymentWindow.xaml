<Window x:Class="RaccoonWarehouse.Invoices.ChangeInvoicePaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change payment method"
        Width="620"
        Height="680"
        MinWidth="560"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        ResizeMode="CanResize"
        Background="{StaticResource PageBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="PaymentLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="PaymentInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C9D8E3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
        <Style x:Key="PaymentComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C9D8E3"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,0,8">
        <Grid MinHeight="520">
        <Grid.RowDefinitions>
            <RowDefinition Height="92"/>
            <RowDefinition Height="112"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeroBrush}" CornerRadius="18" Padding="24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="TitleText" Foreground="White" FontSize="22" FontWeight="Bold"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="Select one or more payment methods before completing the invoice."
                               Foreground="#DCECF7" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="#26FFFFFF" CornerRadius="12" Padding="12,7">
                    <TextBlock Text="PAYMENT" Foreground="White" FontSize="11" FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="0,14,0,0" Padding="18"
                Style="{StaticResource ReportCardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="Invoice total" Style="{StaticResource PaymentLabelStyle}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="InvoiceTotalTextBlock" Text="0.000" FontSize="24" FontWeight="Bold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#E8F6EF" CornerRadius="12" Padding="10" MinHeight="78">
                    <Grid VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="RemainingAmountLabelTextBlock" Text="Remaining amount"
                                   Style="{StaticResource PaymentLabelStyle}"
                                   Margin="0" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock x:Name="RemainingAmountTextBlock" Grid.Row="1" FontSize="24" FontWeight="Bold"
                                   Foreground="#0F765D"
                                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,14,0,0" Padding="16" Style="{StaticResource ReportCardBorderStyle}">
            <StackPanel>
                <TextBlock Text="Payment method" Style="{StaticResource PaymentLabelStyle}"/>
                <ComboBox x:Name="PaymentMethodComboBox" Style="{StaticResource PaymentComboStyle}">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
                            <Setter Property="Padding" Value="10,8"/>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
            </StackPanel>
        </Border>

        <StackPanel x:Name="CustomerPanel" Grid.Row="3" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock x:Name="CustomerLabel" Style="{StaticResource PaymentLabelStyle}"/>
            <ComboBox x:Name="CustomerComboBox"
                      Style="{StaticResource PaymentComboStyle}"
                      DisplayMemberPath="Name"
                      IsEditable="True"
                      IsTextSearchEnabled="False"
                      StaysOpenOnEdit="True"
                      Loaded="CustomerComboBox_Loaded"
                      PreviewKeyDown="CustomerComboBox_PreviewKeyDown"
                      PreviewTextInput="CustomerComboBox_PreviewTextInput"
                      KeyUp="CustomerComboBox_KeyUp"/>
        </StackPanel>

        <Border Grid.Row="4" Margin="0,12,0,0" Padding="16" Style="{StaticResource ReportCardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Amount to add" Style="{StaticResource PaymentLabelStyle}"/>
                    <TextBox x:Name="PaymentAmountTextBox" Style="{StaticResource PaymentInputStyle}"
                             PreviewKeyDown="PaymentAmountTextBox_PreviewKeyDown"/>
                </StackPanel>
                <Button x:Name="AddPaymentButton" Grid.Column="1" Width="118" Height="46" Margin="12,21,0,0"
                        Style="{StaticResource ReportPrimaryButtonStyle}" Click="AddPaymentButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="5" Margin="0,14,0,0" Padding="8" Style="{StaticResource ReportCardBorderStyle}">
            <DataGrid x:Name="PaymentsGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="38"
                      FontSize="14"
                      BorderThickness="0"
                      Background="White">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#EAF2F7"/>
                        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,8"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="PaymentColumn" Header="Payment" Binding="{Binding DisplayName}" Width="*"/>
                    <DataGridTextColumn x:Name="AmountColumn" Header="Amount" Binding="{Binding Amount, StringFormat=0.000}" Width="150"/>
                    <DataGridTemplateColumn Header="" Width="85">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{Binding RemoveText}" Padding="8,4"
                                        Style="{StaticResource ReportSecondaryButtonStyle}"
                                        Click="RemovePaymentButton_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
            <Button x:Name="SaveButton" Width="150" Height="44" Margin="6"
                    Style="{StaticResource ReportPrimaryButtonStyle}" Click="SaveButton_Click"/>
            <Button x:Name="CancelButton" Width="150" Height="44" Margin="6"
                    Style="{StaticResource ReportSecondaryButtonStyle}" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
