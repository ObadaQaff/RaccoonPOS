<Window x:Class="RaccoonWarehouse.Invoices.ChangeInvoicePaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change payment method"
        Width="520"
        Height="560"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,18"/>
        <ComboBox x:Name="PaymentMethodComboBox" Grid.Row="1" Height="38" FontSize="16"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBox x:Name="PaymentAmountTextBox" Width="150" Height="36" Margin="0,0,8,0"
                     VerticalContentAlignment="Center" FontSize="15"/>
            <Button x:Name="AddPaymentButton" Width="100" Height="36" Click="AddPaymentButton_Click"/>
        </StackPanel>
        <StackPanel x:Name="CustomerPanel" Grid.Row="2" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock x:Name="CustomerLabel" Margin="0,0,0,5"/>
            <ComboBox x:Name="CustomerComboBox"
                      Height="36"
                      FontSize="15"
                      DisplayMemberPath="Name"
                      IsEditable="True"
                      IsTextSearchEnabled="False"
                      StaysOpenOnEdit="True"
                      Loaded="CustomerComboBox_Loaded"
                      PreviewKeyDown="CustomerComboBox_PreviewKeyDown"
                      PreviewTextInput="CustomerComboBox_PreviewTextInput"
                      KeyUp="CustomerComboBox_KeyUp"
                      />
        </StackPanel>
        <DataGrid x:Name="PaymentsGrid" Grid.Row="4" Margin="0,12,0,0"
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Height="170">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="PaymentColumn" Header="Payment" Binding="{Binding DisplayName}" Width="*"/>
                <DataGridTextColumn x:Name="AmountColumn" Header="Amount" Binding="{Binding Amount, StringFormat=0.000}" Width="120"/>
                <DataGridTemplateColumn Header="" Width="75">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{Binding RemoveText}" Click="RemovePaymentButton_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button x:Name="SaveButton" Width="120" Height="36" Margin="6" Click="SaveButton_Click"/>
            <Button x:Name="CancelButton" Width="120" Height="36" Margin="6" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
