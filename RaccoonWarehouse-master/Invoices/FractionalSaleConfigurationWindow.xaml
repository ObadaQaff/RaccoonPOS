<Window xmlns:security="clr-namespace:RaccoonWarehouse.Security" x:Class="RaccoonWarehouse.Invoices.FractionalSaleConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إعداد البيع الجزئي" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F4F8FB">
    <Border Margin="18" Padding="22" Background="White" BorderBrush="#C7D9E5" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="إعداد البيع الجزئي" FontSize="24" FontWeight="SemiBold" Foreground="#173E63"/>
            <TextBlock x:Name="PackageTextBlock" Margin="0,8,0,18" TextWrapping="Wrap" Foreground="#425466"/>
            <TextBlock Text="عدد الأشرطة في العبوة" Foreground="#173E63"/>
            <TextBox x:Name="PartsTextBox" Margin="0,6,0,14" Height="38" FontSize="18" Padding="8"
                     FlowDirection="LeftToRight" TextChanged="PartsTextBox_TextChanged"/>
            <TextBlock Text="سعر الشريط" Foreground="#173E63"/>
            <TextBox x:Name="PartialSalePriceTextBox" Margin="0,6,0,14" Height="38" FontSize="18" Padding="8"
                     FlowDirection="LeftToRight"/>
            <TextBlock Text="ÙƒÙ„ÙØ© Ø§Ù„Ø¬Ø²Ø¡" Foreground="#173E63"/>
            <TextBox x:Name="PartialSaleCostTextBox" Margin="0,6,0,8" Height="38" FontSize="18" Padding="8"
                     FlowDirection="LeftToRight"/>
            <TextBlock Text="يُحسب سعر الشريط تلقائياً، ويمكنك تعديله قبل الحفظ."
                       TextWrapping="Wrap" Foreground="#0C6B63"/>
            <TextBlock x:Name="ValidationTextBlock" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#C93F4D"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="إلغاء" Width="110" Height="38" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click"/>
                <Button Content="حفظ" Width="110" Height="38" Background="#0C6B63" Foreground="White"
                        IsDefault="True" Click="Save_Click" security:PermissionWindowGuard.Keys="Products.Create|Products.Edit"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
