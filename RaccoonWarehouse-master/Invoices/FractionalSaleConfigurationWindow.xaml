<Window x:Class="RaccoonWarehouse.Invoices.FractionalSaleConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configure fractional sale" Width="520" Height="390"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F4F8FB">
    <Border Margin="18" Padding="22" Background="White" BorderBrush="#C7D9E5" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Fractional sale setup" FontSize="24" FontWeight="SemiBold" Foreground="#173E63"/>
            <TextBlock Grid.Row="1" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#425466" Text="Enter the number of tapes or pieces contained in one full package. This setting will be saved for this product unit."/>
            <StackPanel Grid.Row="2" Margin="0,18,0,0">
                <TextBlock Text="Tapes / pieces per package" Foreground="#173E63"/>
                <TextBox x:Name="PartsTextBox" Margin="0,6,0,0" Height="38" FontSize="18" Padding="8"/>
                <TextBlock x:Name="PreviewTextBlock" Margin="0,10,0,0" Foreground="#0C6B63" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancel" Width="110" Height="38" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button Content="Save" Width="110" Height="38" Background="#0C6B63" Foreground="White" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
