<Window xmlns:security="clr-namespace:RaccoonWarehouse.Security" x:Class="RaccoonWarehouse.Invoices.ProductUnitSaleConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configure sale unit | إعداد وحدة البيع"
        Width="560" Height="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F8FB">
    <Border Margin="18" Padding="22" Background="White" BorderBrush="#C7D9E5" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleTextBlock"
                       Grid.Row="0"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#173E63"
                       Text="Sale unit setup | إعداد وحدة البيع" />

            <TextBlock x:Name="DescriptionTextBlock"
                       Grid.Row="1"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Foreground="#425466" />

            <StackPanel Grid.Row="2" Margin="0,18,0,0">
                <TextBlock Text="Sale price | سعر البيع" Foreground="#173E63" />
                <TextBox x:Name="SalePriceTextBox" Margin="0,6,0,0" Height="38" FontSize="18" Padding="8" />
                <TextBlock x:Name="SalePriceHintTextBlock" Margin="0,4,0,0" Foreground="#0C6B63" />
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,14,0,0">
                <TextBlock Text="Quantity per unit | الكمية لكل وحدة" Foreground="#173E63" />
                <TextBox x:Name="QuantityPerUnitTextBox" Margin="0,6,0,0" Height="38" FontSize="18" Padding="8" />
                <TextBlock Text="Base units represented by one selected sale unit. | عدد الوحدات الأساسية داخل وحدة البيع." Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#0C6B63" />
            </StackPanel>

            <TextBlock x:Name="ValidationTextBlock"
                       Grid.Row="4"
                       Margin="0,14,0,0"
                       TextWrapping="Wrap"
                       Foreground="#B3261E" />

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancel | إلغاء" Width="120" Height="40" Margin="0,0,10,0" Click="Cancel_Click" />
                <Button Content="Save | حفظ" Width="120" Height="40" Background="#0C6B63" Foreground="White" Click="Save_Click" security:PermissionWindowGuard.Keys="Products.Create|Products.Edit"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
