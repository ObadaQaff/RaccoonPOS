<Window x:Class="RaccoonWarehouse.Invoices.StockLotSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="اختيار الدفعة"
        Width="720"
        Height="430"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock x:Name="ProductNameTextBlock"
                       FontSize="22"
                       FontWeight="Bold"/>
            <TextBlock Text="اختر الدفعة التي تريد البيع منها باستخدام الأسهم ثم اضغط Enter."
                       Margin="0,6,0,0"
                       Foreground="#52606D"/>
        </StackPanel>

        <DataGrid x:Name="LotsGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  PreviewKeyDown="LotsGrid_PreviewKeyDown">
            <DataGrid.Columns>
                <DataGridTextColumn Header="تاريخ الانتهاء"
                                    Binding="{Binding ExpiryDate, StringFormat=dd-MM-yyyy}"
                                    Width="*"/>
                <DataGridTextColumn Header="الكمية الحالية"
                                    Binding="{Binding AvailableQuantity, StringFormat=N3}"
                                    Width="*"/>
                <DataGridTextColumn Header="سعر البيع"
                                    Binding="{Binding SalePrice, StringFormat=N3}"
                                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    Margin="0,14,0,0">
            <Button Content="اختيار"
                    Width="110"
                    Margin="0,0,8,0"
                    Click="SelectButton_Click"/>
            <Button Content="إلغاء"
                    Width="110"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
