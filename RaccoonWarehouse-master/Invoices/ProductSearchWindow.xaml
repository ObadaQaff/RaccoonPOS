<Window x:Class="RaccoonWarehouse.Invoices.ProductSearchWindow" PreviewKeyDown="ProductSearchWindow_PreviewKeyDown"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RaccoonWarehouse.Invoices"
        Title="بحث عن مادة"
        Height="650"
        Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="#F2F6FA">
    <Window.Resources><local:FlexibleDecimalConverter x:Key="FlexibleDecimalConverter"/></Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP SEARCH BAR -->
        <Border Background="White"
                CornerRadius="12"
                Padding="12"
                BorderBrush="#D0D7DD"
                BorderThickness="1">
            <Grid FlowDirection="RightToLeft">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search box -->
                <TextBox x:Name="SearchTextBox"
                         Height="40"
                         FontSize="16"
                         Padding="8"
                         BorderBrush="#AFC2D3"
                         BorderThickness="2"                         
                         Background="White"
                         HorizontalContentAlignment="Right"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchTextBox_TextChanged"
                         PreviewKeyDown="SearchTextBox_PreviewKeyDown"
                         Grid.Column="0"/>

                <!-- Clear -->
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Content="مسح"
                        Width="110"
                        Margin="10,0,0,0"
                        Grid.Column="1"
                        Click="ClearBtn_Click"/>

                <!-- Close -->
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Content="إغلاق"
                        Width="110"
                        Margin="10,0,0,0"
                        Grid.Column="2"
                        Click="CloseBtn_Click"/>
            </Grid>
        </Border>

        <!-- RESULTS -->
        <Border Grid.Row="1"
                Margin="0,15,0,10"
                Background="White"
                CornerRadius="12"
                Padding="10"
                BorderBrush="#D0D7DD"
                BorderThickness="1">

            <DataGrid x:Name="ProductsGrid" AutoGenerateColumns="False" IsReadOnly="False" SelectionMode="Single" SelectionUnit="CellOrRowHeader" FlowDirection="RightToLeft" CanUserAddRows="False" PreviewKeyDown="ProductsGrid_PreviewKeyDown">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الكود" Binding="{Binding ItemCode}" IsReadOnly="True" Width="150"/>
                    <DataGridTextColumn Header="اسم الصنف" Binding="{Binding ProductName}" IsReadOnly="True" Width="*"/>
                    <DataGridTemplateColumn Header="الوحدة" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Unit.Name"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, UpdateSourceTrigger=LostFocus}" Width="100"/>
                    <DataGridTextColumn Header="سعر البيع" Binding="{Binding SalePrice, Converter={StaticResource FlexibleDecimalConverter}, UpdateSourceTrigger=LostFocus}" Width="130"/>
                    <DataGridTemplateColumn Header="إضافة" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Width="38" Height="38" FontSize="20" FontWeight="Bold" Background="#16A34A" Foreground="White" BorderBrush="#15803D" BorderThickness="1" Cursor="Hand" Click="AddProductBtn_Click" IsEnabled="{Binding CanAdd}"><TextBlock Text="+" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- FOOTER HINT -->
        <TextBlock Grid.Row="2"
                   Text="اضغط + لإضافة الصنف إلى الفاتورة، وستبقى النافذة مفتوحة حتى تغلقها يدويًا"
                   Foreground="#2D8DCF"
                   FontSize="15"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,0"/>
    </Grid>
</Window>
