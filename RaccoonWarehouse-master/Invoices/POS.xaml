<Window x:Class="RaccoonWarehouse.Invoices.POS"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:converters="clr-namespace:RaccoonWarehouse.Helpers.Converters"
        Title="نقطة البيع"
        Width="1600"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource AppPageBackgroundBrush}"
        FlowDirection="RightToLeft"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>

        <converters:AbsoluteQuantityConverter x:Key="AbsoluteQuantityConverter"/>

        <!-- ═══════════════════════════════════════════════
             SIDEBAR ACTION BUTTON  (icon + label)
        ═══════════════════════════════════════════════ -->
        <Style x:Key="SidebarActionBtn" TargetType="Button" BasedOn="{StaticResource AppFormButtonStyle}">
            <Setter Property="MinHeight" Value="56"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#2C3E50"/>
            <Setter Property="Foreground" Value="#BDC8D4"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3D5166"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarDangerBtn" TargetType="Button" BasedOn="{StaticResource SidebarActionBtn}">
            <Setter Property="Background" Value="#5C2430"/>
            <Setter Property="Foreground" Value="#E8A0A8"/>
        </Style>

        <Style x:Key="SidebarWarningBtn" TargetType="Button" BasedOn="{StaticResource SidebarActionBtn}">
            <Setter Property="Background" Value="#4A3820"/>
            <Setter Property="Foreground" Value="#D4A855"/>
        </Style>

        <Style x:Key="SidebarSuccessBtn" TargetType="Button" BasedOn="{StaticResource SidebarActionBtn}">
            <Setter Property="Background" Value="{StaticResource AppPrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="SidebarButtonText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Style.Triggers>
                <Trigger Property="FlowDirection" Value="LeftToRight">
                    <Setter Property="TextAlignment" Value="Left"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══════════════════════════════════════════════
             CATEGORY TAB BUTTON
        ═══════════════════════════════════════════════ -->
        <Style x:Key="CategoryTabBtn" TargetType="ToggleButton">
            <Setter Property="Height"  Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin"  Value="0,0,6,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppPrimaryBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF7EF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════
             PRODUCT CARD BUTTON
        ═══════════════════════════════════════════════ -->
        <Style x:Key="ProductCardBtn" TargetType="Button">
            <Setter Property="Width"   Value="130"/>
            <Setter Property="Height"  Value="100"/>
            <Setter Property="Margin"  Value="5"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment"   Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F9F2"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AppPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D8EFD9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════
             PAYMENT BUTTON
        ═══════════════════════════════════════════════ -->
        <Style x:Key="PaymentBtn" TargetType="Button" BasedOn="{StaticResource AppFormButtonStyle}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <!-- ═══════════════════════════════════════════════
             MISC
        ═══════════════════════════════════════════════ -->
        <Style x:Key="SummaryLabel" TargetType="TextBlock">
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="Foreground"  Value="{StaticResource AppMutedTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SummaryValue" TargetType="TextBlock">
            <Setter Property="FontSize"    Value="14"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Foreground"  Value="{StaticResource AppTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ProductComboBoxWithGridStyle" TargetType="ComboBox">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility"   Value="Auto"/>
            <Setter Property="IsEditable" Value="False"/>
            <Setter Property="IsTextSearchEnabled" Value="False"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="34"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Border" Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12"/>
                            <TextBox x:Name="PART_EditableTextBox" Grid.Column="0"
                                     Margin="8,5,4,5" Padding="0" Focusable="False"
                                     Visibility="Hidden" Background="Transparent"
                                     BorderThickness="0"
                                     HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                     VerticalContentAlignment="Center"
                                     IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ToggleButton x:Name="ToggleButton" Grid.Column="1" Width="34"
                                          Focusable="False" Background="Transparent"
                                          BorderThickness="0" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <Path x:Name="Arrow" Fill="#667784" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z"/>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite" Grid.Column="0"
                                              Margin="10,0,0,0" VerticalAlignment="Center"
                                              HorizontalAlignment="Stretch" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                            <Popup x:Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Slide" VerticalOffset="2">
                                <Border x:Name="DropDownBorder" MaxHeight="460"
                                        MinWidth="{TemplateBinding ActualWidth}" Width="1080"
                                        Background="White"
                                        BorderBrush="{StaticResource AppBorderBrush}"
                                        BorderThickness="1" CornerRadius="14"
                                        Margin="0,6,0,0" Padding="6">
                                    <ScrollViewer SnapsToDevicePixels="True"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Auto">
                                        <DataGrid x:Name="ProductGrid"
                                                  ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource TemplatedParent}}"
                                                  AutoGenerateColumns="False" HeadersVisibility="Column"
                                                  SelectionMode="Single" SelectionUnit="FullRow"
                                                  IsReadOnly="True" GridLinesVisibility="Horizontal"
                                                  RowHeight="40" FontSize="14" FlowDirection="RightToLeft"
                                                  AlternatingRowBackground="#F7F9FB" Background="White" BorderThickness="0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="الاسم"           Width="220" Binding="{Binding Name, TargetNullValue=---}"/>
                                                <DataGridTextColumn Header="الباركود"        Width="130" Binding="{Binding ITEMCODE, TargetNullValue=---}"/>
                                                <DataGridTextColumn Header="الفئة"           Width="160" Binding="{Binding SubCategory.Name, TargetNullValue=---}"/>
                                                <DataGridTextColumn Header="العلامة التجارية" Width="160" Binding="{Binding Brand.Name, TargetNullValue=---}"/>
                                                <DataGridTextColumn Header="الوصف"           Width="320" Binding="{Binding Description, TargetNullValue=---}"/>
                                                <DataGridTextColumn Header="الكمية المتوفرة"  Width="130" Binding="{Binding CurrentStockQuantity, StringFormat={}{0:N5}, TargetNullValue=---}"/>
                                                <DataGridTextColumn Header="سعر المخزون الحالي" Width="150" Binding="{Binding CurrentSalePrice, StringFormat={}{0:N5}, FallbackValue=0.00000}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AppBlueBrush}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AppBlueBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter Property="IsTabStop" Value="False"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ══════════════════════════════════════════════════════════════════
         ROOT  – 3 columns:  [sidebar] [main-area] [invoice+payment panel]
     ══════════════════════════════════════════════════════════════════ -->
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="148"/>
            <!-- col 0: action sidebar   -->
            <ColumnDefinition Width="0.9*"/>
            <!-- col 1: browse + barcode -->
            <ColumnDefinition Width="700"/>
            <!-- col 2: invoice + totals -->
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════
             COL 0 – VERTICAL SIDEBAR
        ══════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="#1E2D3D"
                CornerRadius="0,0,0,0">
            <DockPanel>
                <!-- Logo / app mark -->
                <Border DockPanel.Dock="Top" Height="94" Background="#17222E">
                    <Image Source="pack://application:,,,/Assets/Logo/Logo newfinal.png"
                           Width="74"
                           Height="74"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Border>

                <!-- Session controls at top -->
                <StackPanel DockPanel.Dock="Top" Margin="10,10,10,4">
                    <Button x:Name="OpenSessionBtn" Style="{StaticResource SidebarSuccessBtn}"
                            Click="OpenSessionBtn_Click"
                            ToolTip="فتح جلسة">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Kind="PlayCircle" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="فتح جلسة" Style="{StaticResource SidebarButtonText}"/>
                        </Grid>
                    </Button>
                    <Button x:Name="CloseSessionBtn" Style="{StaticResource SidebarDangerBtn}"
                            Click="CloseSessionBtn_Click"
                            ToolTip="إغلاق جلسة">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Kind="StopCircle" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="إغلاق جلسة" Style="{StaticResource SidebarButtonText}"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Separator -->
                <Border DockPanel.Dock="Top" Height="1" Background="#2C3E50" Margin="8,4"/>

                <!-- Main actions (scrollable) -->
                <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10,4,10,4">

                        <!-- Invoice actions group -->
                        <Button Style="{StaticResource SidebarActionBtn}"
                                Click="NewInvoiceBtn_Click" ToolTip="فاتورة جديدة">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <iconPacks:PackIconMaterial Kind="FileDocumentPlusOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="فاتورة جديدة" Style="{StaticResource SidebarButtonText}"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource SidebarActionBtn}"
                                Click="SearchProductBtn_Click" ToolTip="بحث عن مادة (F2)">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <iconPacks:PackIconMaterial Kind="Magnify" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="بحث عن مادة" Style="{StaticResource SidebarButtonText}"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource SidebarDangerBtn}"
                                Click="DeleteItemBtn_Click" ToolTip="حذف مادة (F3 / Del)">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <iconPacks:PackIconMaterial Kind="Delete" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="حذف مادة" Style="{StaticResource SidebarButtonText}"/>
                            </Grid>
                        </Button>
                        <Button x:Name="FinishSaleBtn" Style="{StaticResource SidebarSuccessBtn}"
                                Click="FinishSaleBtn_Click" ToolTip="إنهاء كاش (F1)">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <iconPacks:PackIconMaterial Kind="CheckBold" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="إنهاء كاش" Style="{StaticResource SidebarButtonText}"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource SidebarWarningBtn}"
                                Click="HoldSaleBtn_Click" ToolTip="انتظار (F5)">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <iconPacks:PackIconMaterial Kind="PauseCircle" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="انتظار" Style="{StaticResource SidebarButtonText}"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource SidebarActionBtn}"
                                Click="ResumeHoldBtn_Click" ToolTip="استئناف (F6)">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <iconPacks:PackIconMaterial Kind="PlayCircle" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="استئناف" Style="{StaticResource SidebarButtonText}"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource SidebarActionBtn}"
                                Click="PrintBtn_Click" ToolTip="طباعة (F9)">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <iconPacks:PackIconMaterial Kind="Printer" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="طباعة" Style="{StaticResource SidebarButtonText}"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource SidebarWarningBtn}"
                                Click="ExchangeItemBtn_Click" ToolTip="استبدال (Shift+F2)">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <iconPacks:PackIconMaterial Kind="SwapHorizontal" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="استبدال" Style="{StaticResource SidebarButtonText}"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource SidebarDangerBtn}"
                                Click="ReturnItemBtn_Click" ToolTip="مرتجع">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <iconPacks:PackIconMaterial Kind="Undo" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="مرتجع" Style="{StaticResource SidebarButtonText}"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource SidebarWarningBtn}"
                                Click="DiscountBtn_Click" ToolTip="خصم (F11)">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <iconPacks:PackIconMaterial Kind="Sale" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="خصم" Style="{StaticResource SidebarButtonText}"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource SidebarActionBtn}"
                                Click="OpenReceipt_Click" ToolTip="مقبوضات (F7)">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <iconPacks:PackIconMaterial Kind="CashPlus" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="مقبوضات" Style="{StaticResource SidebarButtonText}"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource SidebarDangerBtn}"
                                Click="OpenPayment_Click" ToolTip="مدفوعات (F8)">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <iconPacks:PackIconMaterial Kind="CashMinus" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="مدفوعات" Style="{StaticResource SidebarButtonText}"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource SidebarActionBtn}"
                                Click="DailyReportBtn_Click" ToolTip="ملخص الشفت (F10)">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <iconPacks:PackIconMaterial Kind="ChartBar" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="ملخص الشفت" Style="{StaticResource SidebarButtonText}"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource SidebarDangerBtn}"
                                Click="CancelInvoiceBtn_Click" ToolTip="إلغاء (Esc)">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <iconPacks:PackIconMaterial Kind="Cancel" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="إلغاء" Style="{StaticResource SidebarButtonText}"/>
                            </Grid>
                        </Button>

                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <Border DockPanel.Dock="Bottom" Height="48" Background="#17222E">
                    <TextBlock Text="RW" FontSize="13" FontWeight="Bold"
                               Foreground="#445A68"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════════
             COL 1 – BROWSE AREA
        ══════════════════════════════════════════════ -->
        <Grid Grid.Column="1" Margin="12,10,6,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- top bar: cashier / date / customer / barcode -->
                <RowDefinition Height="Auto"/>
                <!-- category tabs -->
                <RowDefinition Height="*"/>
                <!-- product card grid -->
                <RowDefinition Height="Auto"/>
                <!-- status bar -->
            </Grid.RowDefinitions>

            <!-- ── Top info bar ── -->
            <Border Grid.Row="0" Padding="14,10" Margin="0,0,0,10"
                    Style="{StaticResource AppCardBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cashier -->
                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="الكاشير" FontSize="11" Foreground="{StaticResource AppMutedTextBrush}" Margin="0,0,0,2"/>
                        <TextBlock x:Name="CashierName" Text="{Binding CurrentCasherName}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextBrush}"/>
                    </StackPanel>

                    <!-- Separator -->
                    <Border Grid.Column="0" Width="1" Background="{StaticResource AppBorderBrush}"
                            Margin="0,4,16,4" HorizontalAlignment="Right"/>

                    <!-- Date -->
                    <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="التاريخ" FontSize="11" Foreground="{StaticResource AppMutedTextBrush}" Margin="0,0,0,2"/>
                        <TextBlock x:Name="CurrentDateTextBlock" Text="{Binding CurrentDate}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextBrush}"/>
                    </StackPanel>

                    <!-- Customer -->
                    <StackPanel Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="العميل" FontSize="11" Foreground="{StaticResource AppMutedTextBrush}" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CustomerComboBox"
                                      Height="34" DisplayMemberPath="Name"
                                      Style="{StaticResource AppComboBoxStyle}"
                                      IsEditable="True"
                                      PreviewKeyDown="CustomerComboBox_PreviewKeyDown"
                                      GotKeyboardFocus="CustomerComboBox_GotKeyboardFocus"/>
                            <Button Grid.Column="1"
                                    Width="34"
                                    Height="34"
                                    Margin="4,0,0,0"
                                    ToolTip="إضافة عميل جديد"
                                    Click="AddCustomerBtn_Click">
                                <iconPacks:PackIconMaterial Kind="Plus" Width="16" Height="16"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Barcode -->
                    <StackPanel x:Name="TopBarcodePanel" Grid.Column="3" Visibility="Collapsed" VerticalAlignment="Center">
                        <TextBlock Text="بحث بالباركود" FontSize="11" Foreground="{StaticResource AppMutedTextBrush}" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BarcodeTextBox"
                                     Height="34" FontSize="13" Padding="10,0"
                                     VerticalContentAlignment="Center"
                                     Background="White"
                                     BorderBrush="{StaticResource AppBorderBrush}"
                                     BorderThickness="1"
                                     FlowDirection="LeftToRight"
                                     ToolTip="Scan or enter barcode"
                                     PreviewKeyDown="BarcodeTextBox_PreviewKeyDown"
                                     TextChanged="BarcodeTextBox_TextChanged"/>
                            <Border Grid.Column="1" Width="34" Height="34" Margin="4,0,0,0"
                                    Background="#EEF7EF" CornerRadius="8"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="Barcode"
                                                            Width="18" Height="18"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Foreground="{StaticResource AppPrimaryDarkBrush}"/>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- Invoice # badge -->
                    <Border Grid.Column="4" Margin="16,0,0,0" Padding="12,6"
                            CornerRadius="10" Background="#EEF7EF"
                            VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="رقم الفاتورة" FontSize="10"
                                       Foreground="{StaticResource AppMutedTextBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="InvoiceNumberText" Text="---"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource AppPrimaryDarkBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ── Category tabs ── -->
            <Border Grid.Row="1" Padding="12,10" Margin="0,0,0,10"
                    Style="{StaticResource AppCardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="الفئات" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource AppMutedTextBrush}"
                               Margin="0,0,0,8"/>
                    <!-- ItemsControl bound to SubCategories collection in code-behind -->
                    <ItemsControl x:Name="CategoryTabsControl"
                                  ItemsSource="{Binding SubCategories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!--
                                    Each category becomes a ToggleButton.
                                    The Click handler is wired in code-behind via
                                    CategoryTabButton_Click which filters ProductCards.
                                    Tag carries the SubCategory object for filtering.
                                -->
                                <ToggleButton Content="{Binding Name}"
                                              Tag="{Binding}"
                                              Style="{StaticResource CategoryTabBtn}"
                                              Click="CategoryTabButton_Click"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ── Product card grid ── -->
            <Border Grid.Row="2" Padding="12" Style="{StaticResource AppCardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Mini search inside the browse area -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ProductSearchBox"
                                 Height="36" FontSize="13" Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 Background="White"
                                 BorderBrush="{StaticResource AppBorderBrush}"
                                 BorderThickness="1"
                                 FlowDirection="RightToLeft"
                                 Tag="ابحث عن منتج..."
                                 TextChanged="ProductSearchBox_TextChanged"/>
                        <Border Grid.Column="1" Width="36" Height="36" Margin="6,0,0,0"
                                Background="#EEF7EF" CornerRadius="8"
                                HorizontalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="Magnify"
                                                        Width="16" Height="16"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Foreground="{StaticResource AppPrimaryDarkBrush}"/>
                        </Border>
                    </Grid>

                    <!-- Product cards  (ItemsSource = FilteredProducts, set in code-behind) -->
                    <ScrollViewer x:Name="ProductCardsScrollViewer"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  ScrollChanged="ProductCardsScrollViewer_ScrollChanged">
                        <ItemsControl x:Name="ProductCardsControl"
                                      ItemsSource="{Binding FilteredProducts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!--
                                        Tag carries the product object so the
                                        ProductCard_Click handler can read it.
                                    -->
                                    <Button Style="{StaticResource ProductCardBtn}"
                                            Tag="{Binding}"
                                            Click="ProductCard_Click">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- icon placeholder -->
                                            <Border Grid.Row="0"
                                                    Background="#F0F9F2" CornerRadius="8"
                                                    Margin="0,0,0,4">
                                                <iconPacks:PackIconMaterial Kind="PackageVariant"
                                                                            Width="28" Height="28"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            Foreground="{StaticResource AppPrimaryBrush}"/>
                                            </Border>

                                            <!-- Product name -->
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding Name}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AppTextBrush}"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       MaxHeight="30"/>

                                            <!-- Price -->
                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding CurrentSalePrice, StringFormat={}{0:N5}}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource AppPrimaryDarkBrush}"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ── Status bar ── -->
            <Border Grid.Row="3" Margin="0,10,0,0" Padding="14,10"
                    Style="{StaticResource AppCardBorderStyle}">
                <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <iconPacks:PackIconMaterial Kind="ShoppingOutline" Width="14" Height="14"
                                                    VerticalAlignment="Center"
                                                    Foreground="{StaticResource AppMutedTextBrush}"
                                                    Margin="0,0,5,0"/>
                        <TextBlock x:Name="StatusItemCount" Text="العدد: 0"
                                   FontSize="13" Foreground="{StaticResource AppTextBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <iconPacks:PackIconMaterial Kind="Counter" Width="14" Height="14"
                                                    VerticalAlignment="Center"
                                                    Foreground="{StaticResource AppMutedTextBrush}"
                                                    Margin="0,0,5,0"/>
                        <TextBlock x:Name="StatusQtyCount" Text="الكمية: 0"
                                   FontSize="13" Foreground="{StaticResource AppTextBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="CurrencyUsd" Width="14" Height="14"
                                                    VerticalAlignment="Center"
                                                    Foreground="{StaticResource AppMutedTextBrush}"
                                                    Margin="0,0,5,0"/>
                        <TextBlock x:Name="StatusTotal" Text="الإجمالي: 0.00000"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource AppPrimaryDarkBrush}"/>
                    </StackPanel>
                </WrapPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════
             COL 2 – INVOICE  +  TOTALS  +  PAYMENT
        ══════════════════════════════════════════════ -->
        <Grid Grid.Column="2" Margin="6,10,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <!-- invoice grid -->
                <RowDefinition Height="Auto"/>
                <!-- total card  -->
                <RowDefinition Height="Auto"/>
                <!-- payment buttons -->
            </Grid.RowDefinitions>

            <!-- ── Invoice DataGrid ── -->
            <Border Grid.Row="0" Padding="14" Style="{StaticResource AppCardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,10">
                        <Border DockPanel.Dock="Right"
                                Style="{StaticResource AppBadgeBorderStyle}"
                                Background="#EEF7EF">
                            <TextBlock x:Name="InvoiceItemBadge"
                                       Text="0 صنف"
                                       Foreground="{StaticResource AppPrimaryDarkBrush}"
                                       FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="تفاصيل الفاتورة"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource AppTextBrush}"
                                   FontSize="17" FontWeight="Bold"/>
                    </DockPanel>

                    <DataGrid x:Name="InvoiceGrid" Grid.Row="1"
                              AutoGenerateColumns="False" FontSize="13"
                              FlowDirection="RightToLeft"
                              Background="White" RowHeight="38"
                              HeadersVisibility="Column"
                              SelectionUnit="CellOrRowHeader" SelectionMode="Single"
                              IsReadOnly="False" CanUserAddRows="False"
                              CanUserDeleteRows="True"
                              KeyboardNavigation.TabNavigation="Continue"
                              PreviewKeyDown="InvoiceGrid_PreviewKeyDown"
                              PreparingCellForEdit="InvoiceGrid_PreparingCellForEdit"
                              CellEditEnding="InvoiceGrid_CellEditEnding"
                              CurrentCellChanged="InvoiceGrid_CurrentCellChanged">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="رمز المادة / Barcode" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SelectedProduct.ITEMCODE, TargetNullValue=---}"
                                                   VerticalAlignment="Center"
                                                   Padding="4,0"
                                                   FlowDirection="LeftToRight"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding SelectedProduct.ITEMCODE, Mode=OneWay}"
                                                 Padding="4,2"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 VerticalContentAlignment="Center"
                                                 FlowDirection="LeftToRight"
                                                 PreviewKeyDown="ProductBarcodeTextBox_PreviewKeyDown"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="الصنف" Width="*" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ProductName, TargetNullValue='---'}"
                                                   VerticalAlignment="Center" Padding="6,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox x:Name="ProductComboBox"
                                                  DisplayMemberPath="Name"
                                                  Style="{StaticResource ProductComboBoxWithGridStyle}"
                                                  SelectedItem="{Binding SelectedProduct, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemsSource="{Binding DataContext.ProductSuggestions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectionChanged="ProductCombo_SelectionChanged"
                                                  Loaded="ProductCombo_Loaded"
                                                  DropDownOpened="ProductCombo_DropDownOpened"
                                                  LostFocus="ProductCombo_LostFocus"
                                                  PreviewKeyDown="ProductCombo_PreviewKeyDown"
                                                  PreviewTextInput="ProductCombo_PreviewTextInput"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="الكمية" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Quantity, Converter={StaticResource AbsoluteQuantityConverter}}"
                                                   Padding="4,0" VerticalAlignment="Center"
                                                   FlowDirection="LeftToRight" TextAlignment="Left"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource AbsoluteQuantityConverter}}"
                                                 Padding="4,2" BorderThickness="0" Background="Transparent"
                                                 VerticalContentAlignment="Center" FlowDirection="LeftToRight"
                                                 Language="en-US"
                                                 PreviewKeyDown="NumericEditor_PreviewKeyDown"
                                                 PreviewTextInput="NumericEditor_PreviewTextInput"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Returned Quantity / Return Qty" Width="95" Visibility="Collapsed">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ReturnedQuantity, Converter={StaticResource AbsoluteQuantityConverter}}"
                                                   Padding="4,0" VerticalAlignment="Center"
                                                   FlowDirection="LeftToRight" TextAlignment="Left"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding ReturnedQuantity, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource AbsoluteQuantityConverter}}"
                                                 Padding="4,2" BorderThickness="0" Background="Transparent"
                                                 VerticalContentAlignment="Center" FlowDirection="LeftToRight"
                                                 Language="en-US"
                                                 PreviewKeyDown="NumericEditor_PreviewKeyDown"
                                                 PreviewTextInput="NumericEditor_PreviewTextInput"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="السعر" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding UnitPrice}"
                                                   Padding="4,0" VerticalAlignment="Center"
                                                   FlowDirection="LeftToRight" TextAlignment="Left"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding UnitPrice, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 Padding="4,2" BorderThickness="0" Background="Transparent"
                                                 VerticalContentAlignment="Center" FlowDirection="LeftToRight"
                                                 Language="en-US"
                                                 PreviewKeyDown="NumericEditor_PreviewKeyDown"
                                                 PreviewTextInput="NumericEditor_PreviewTextInput"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="المتوفر" Width="75"
                                                IsReadOnly="True" Binding="{Binding AvailableQuantitySnapshot, StringFormat={}{0:0.00000}}"/>
                            <DataGridTemplateColumn Header="الوحدة" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding UnitNameSnapshot, TargetNullValue=---}"
                                                   Padding="4,0"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox x:Name="InvoiceUnitComboBox"
                                                  Padding="4,2"
                                                  BorderThickness="0"
                                                  Background="Transparent"
                                                  VerticalContentAlignment="Center"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding ProductUnitId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Loaded="InvoiceUnitCombo_Loaded"
                                                  SelectionChanged="InvoiceUnitCombo_SelectionChanged"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="الإجمالي" Width="70"
                                                IsReadOnly="True" Binding="{Binding LineTotal}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ── Grand total card ── -->
            <Border Grid.Row="1" Margin="0,8,0,0" Padding="16,12"
                    CornerRadius="18"
                    Background="#FBF7F3"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="المبلغ الإجمالي" Style="{StaticResource SummaryLabel}"/>
                        <TextBlock x:Name="TotalTextBlock" Text="0.00000"
                                   FontSize="32" FontWeight="Bold"
                                   Foreground="#C93F4D"/>
                    </StackPanel>
                    <!-- Discount / tax summary pill -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBox x:Name="DiscountTextBox"
                                 Text="0"
                                 Width="110"
                                 Margin="0,0,0,4"
                                 HorizontalContentAlignment="Center"
                                 TextChanged="DiscountTextBox_TextChanged"/>
                        <Border Background="#FDE8EA" CornerRadius="8" Padding="10,6" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="خصم: " Style="{StaticResource SummaryLabel}" FontSize="11"/>
                                <TextBlock x:Name="DiscountSummaryText" Text="0.00000"
                                           Style="{StaticResource SummaryValue}" FontSize="11"
                                           Foreground="#C93F4D"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#EEF7EF" CornerRadius="8" Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="صافي: " Style="{StaticResource SummaryLabel}" FontSize="11"/>
                                <TextBlock x:Name="NetTotalText" Text="0.00000"
                                           Style="{StaticResource SummaryValue}" FontSize="11"
                                           Foreground="{StaticResource AppPrimaryDarkBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Payment methods ── -->
            <Border Grid.Row="2" Margin="0,8,0,0" Padding="14,12"
                    CornerRadius="18"
                    Background="#F7FAFE"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="طريقة الدفع" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource AppMutedTextBrush}"
                               Margin="0,0,0,8"/>
                    <UniformGrid Columns="4" Rows="2">
                        <Button Style="{StaticResource PaymentBtn}"
                                Background="{StaticResource AppPrimaryBrush}"
                                Click="CashPaymentBtn_Click"
                                ToolTip="Ctrl+1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="Cash" Width="15" Height="15"/>
                                <TextBlock Text="كاش" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PaymentBtn}"
                                Background="#445A68"
                                Click="VisaPaymentBtn_Click"
                                ToolTip="Ctrl+2">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="CreditCard" Width="15" Height="15"/>
                                <TextBlock Text="Visa" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PaymentBtn}"
                                Background="#445A68"
                                Click="MasterCardPaymentBtn_Click"
                                ToolTip="Ctrl+3">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="CreditCardOutline" Width="15" Height="15"/>
                                <TextBlock Text="Master" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PaymentBtn}"
                                Background="#445A68"
                                Click="DebitPaymentBtn_Click"
                                ToolTip="Ctrl+4">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="BankTransfer" Width="15" Height="15"/>
                                <TextBlock Text="Debit" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PaymentBtn}"
                                Background="#445A68"
                                Click="CheckPaymentBtn_Click"
                                ToolTip="Ctrl+5">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="FileDocumentCheckOutline" Width="15" Height="15"/>
                                <TextBlock Text="Check" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PaymentBtn}"
                                Background="#445A68"
                                Click="MobilePaymentBtn_Click"
                                ToolTip="Ctrl+6">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="CellphoneNfc" Width="15" Height="15"/>
                                <TextBlock Text="Mobile" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PaymentBtn}"
                                Background="#D98A1F"
                                Click="CreditPaymentBtn_Click"
                                ToolTip="Ctrl+7 / F12">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="AccountClock" Width="15" Height="15"/>
                                <TextBlock Text="آجل" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <!-- spare slot can hold a future method -->
                        <Border/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
