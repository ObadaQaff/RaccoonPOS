<Window x:Class="RaccoonWarehouse.UsersTable"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        mc:Ignorable="d"
        Title="إدارة حسابات المستخدمين"
        Height="800"
        Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        Background="{StaticResource AppPageBackgroundBrush}">
    <Grid Background="{StaticResource AppPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="220"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="0,0,34,34" Background="{StaticResource AppDashboardHeroBrush}">
            <Grid Margin="34,24,34,34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="إدارة حسابات المستخدمين"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="White"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Padding="18,12"
                        CornerRadius="20"
                        Background="#1FFFFFFF"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="إنشاء المستخدم"
                                   FontSize="12"
                                   Foreground="#CFE8E3"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,-52,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource AppCardBorderStyle}"
                    Padding="24">
                <StackPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,0,12,12">
                            <TextBlock Text="بحث عن مستخدم / Search users"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AppTextBrush}"/>
                            <TextBox x:Name="SearchBox"
                                     Margin="0,8,0,0"
                                     Style="{StaticResource AppSearchTextBoxStyle}"
                                     TextChanged="SearchBox_TextChanged"
                                     ToolTip="ابحث بالاسم أو الهاتف أو الدور"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="1"
                                    Width="260"
                                    Margin="0,0,0,12">
                            <TextBlock Text="تصفية حسب الدور / Filter by role"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AppTextBrush}"/>
                            <ComboBox x:Name="RoleFilterComboBox"
                                      Height="40"
                                      Margin="0,8,0,0"
                                      SelectedValuePath="Tag"
                                      SelectedValue="all"
                                      SelectionChanged="RoleFilterComboBox_SelectionChanged">
                                <ComboBoxItem Content="All roles / كل الأدوار" Tag="all" />
                                <ComboBoxItem Content="Admin / مدير" Tag="Admin" />
                                <ComboBoxItem Content="Casher / كاشير" Tag="Casher" />
                                <ComboBoxItem Content="Customer / عميل" Tag="Customer" />
                                <ComboBoxItem Content="Supplier / مورد" Tag="Supplier" />
                                <ComboBoxItem Content="Manager / مدير مستودع" Tag="Manager" />
                                <ComboBoxItem Content="HR / موارد بشرية" Tag="HR" />
                                <ComboBoxItem Content="Doctor / طبيب" Tag="Doctor" />
                                <ComboBoxItem Content="Pharmacy / صيدلية" Tag="Pharmacy" />
                                <ComboBoxItem Content="Pharmaceutical warehouse / مستودع أدوية" Tag="PharmaceuticalWarehouse" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left">
                            <Border Style="{StaticResource AppBadgeBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="إجمالي المستخدمين"
                                               FontSize="12"
                                               Foreground="{StaticResource AppMutedTextBrush}"/>
                                    <TextBlock x:Name="TotalUsersText"
                                               Margin="0,4,0,0"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AppTextBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource AppBadgeBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="النتائج المعروضة"
                                               FontSize="12"
                                               Foreground="{StaticResource AppMutedTextBrush}"/>
                                    <TextBlock x:Name="VisibleUsersText"
                                               Margin="0,4,0,0"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AppTextBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button x:Name="ViewStatementBtn"
                                    Width="150"
                                    Margin="0,0,12,0"
                                    Style="{StaticResource AppSecondaryButtonStyle}"
                                    Click="ViewStatement_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <fa:ImageAwesome Icon="Book" Width="16" Height="16"
                                                     Margin="0,0,8,0"
                                                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Text="كشف الحساب" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="CreateUserBtn"
                                    Width="150"
                                    Margin="0,0,12,0"
                                    Style="{StaticResource AppHeroButtonStyle}"
                                    Click="CreateUserBtn_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <fa:ImageAwesome Icon="Plus" Width="16" Height="16"
                                                     Margin="0,0,8,0"
                                                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Text="مستخدم جديد" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BackBtn"
                                    Width="100"
                                    Style="{StaticResource AppSecondaryButtonStyle}"
                                    Click="BackBtn_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <fa:ImageAwesome Icon="ArrowRight" Width="16" Height="16"
                                                     Margin="0,0,8,0"
                                                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Text="عودة" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Margin="0,18,0,0"
                    Style="{StaticResource AppCardBorderStyle}"
                    Padding="16">
                <DataGrid x:Name="UsersTable1"
                          Style="{StaticResource AppModernDataGridStyle}"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          MouseDoubleClick="UsersTable1_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رقم المستخدم" Binding="{Binding UserNumber}" Width="110"/>
                        <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="الهاتف" Binding="{Binding PhoneNumber}" Width="1.6*"/>
                        <DataGridTextColumn Header="الدور" Binding="{Binding Role}" Width="1.1*"/>
                        <DataGridTextColumn Header="آخر تحديث" Binding="{Binding UpdatedDate, StringFormat={}{0:yyyy-MM-dd hh:mm tt}}" Width="1.5*"/>
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="كشف الحساب" Click="ViewStatement_Click"/>
                            <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="تعديل" Click="Update_User"/>
                            <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="حذف" Click="Delete_User"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</Window>
