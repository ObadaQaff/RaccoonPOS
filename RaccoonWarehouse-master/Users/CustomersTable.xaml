<Window x:Class="RaccoonWarehouse.CustomersTable"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        mc:Ignorable="d"
        Title="إدارة العملاء والموردين"
        Height="800"
        Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        Background="{StaticResource AppPageBackgroundBrush}">
    <Grid Background="{StaticResource AppPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="220"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="0,0,34,34" Background="{StaticResource AppDashboardHeroBrush}">
            <Grid Margin="34,24,34,34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="إدارة العملاء والموردين"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock x:Name="FeatureStateText"
                               Margin="0,10,0,0"
                               FontSize="14"
                               Foreground="#D7F1FF"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Padding="18,12"
                        CornerRadius="20"
                        Background="#1FFFFFFF"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="إجمالي العملاء والموردين"
                                   FontSize="12"
                                   Foreground="#CFE8E3"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TotalCustomersText"
                                   Margin="0,4,0,0"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="النتائج المعروضة"
                                   Margin="0,8,0,0"
                                   FontSize="12"
                                   Foreground="#CFE8E3"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="VisibleCustomersText"
                                   Margin="0,4,0,0"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,-52,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource AppCardBorderStyle}"
                    Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchBox"
                             Grid.Column="0"
                             Margin="0,0,10,0"
                             Style="{StaticResource AppSearchTextBoxStyle}"
                             TextChanged="SearchBox_TextChanged"
                             ToolTip="ابحث بالاسم أو الهاتف أو بيانات البنك أو المعرف"/>

                    <ComboBox x:Name="CreditStatusFilter"
                              Grid.Column="1"
                              Margin="0,0,10,0"
                              Style="{StaticResource AppComboBoxStyle}"
                              SelectionChanged="FilterChanged"/>

                    <ComboBox x:Name="BalanceFilter"
                              Grid.Column="2"
                              Margin="0,0,10,0"
                              Style="{StaticResource AppComboBoxStyle}"
                              SelectionChanged="FilterChanged"/>

                    <TextBlock x:Name="HintText"
                               Grid.Column="3"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource AppMutedTextBrush}"/>

                    <StackPanel Grid.Column="4"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left">
                        <Button x:Name="ViewStatementBtn"
                                Width="150"
                                Margin="0,0,12,0"
                                Style="{StaticResource AppSecondaryButtonStyle}"
                                Click="ViewStatement_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <fa:ImageAwesome Icon="Book" Width="16" Height="16"
                                                 Margin="0,0,8,0"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="كشف الحساب" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="CreateCustomerBtn"
                                Width="170"
                                Margin="0,0,12,0"
                                Style="{StaticResource AppHeroButtonStyle}"
                                Click="CreateCustomerBtn_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <fa:ImageAwesome Icon="Plus" Width="16" Height="16"
                                                 Margin="0,0,8,0"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="زبون جديد" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="CreateSupplierBtn"
                                Width="170"
                                Margin="0,0,12,0"
                                Style="{StaticResource AppHeroButtonStyle}"
                                Click="CreateSupplierBtn_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <fa:ImageAwesome Icon="Plus" Width="16" Height="16"
                                                 Margin="0,0,8,0"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="مورد جديد" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BackBtn"
                                Width="120"
                                Style="{StaticResource AppSecondaryButtonStyle}"
                                Click="BackBtn_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <fa:ImageAwesome Icon="ArrowRight" Width="16" Height="16"
                                                 Margin="0,0,8,0"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="عودة" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <UniformGrid Grid.Row="1" Columns="4" Margin="0,18,0,0">
                <Border Background="White"
                        CornerRadius="16"
                        Padding="16"
                        Margin="0,0,10,0"
                        BorderBrush="#D9E2EC"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="إجمالي العملاء" Foreground="#67727D" FontSize="12"/>
                        <TextBlock x:Name="TotalCustomersCardText" FontSize="26" FontWeight="Bold" Foreground="#2D8DCF"/>
                    </StackPanel>
                </Border>
                <Border Background="White"
                        CornerRadius="16"
                        Padding="16"
                        Margin="0,0,10,0"
                        BorderBrush="#D9E2EC"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="نشط" Foreground="#67727D" FontSize="12"/>
                        <TextBlock x:Name="ActiveCustomersCardText" FontSize="26" FontWeight="Bold" Foreground="#27AE60"/>
                    </StackPanel>
                </Border>
                <Border Background="White"
                        CornerRadius="16"
                        Padding="16"
                        Margin="0,0,10,0"
                        BorderBrush="#D9E2EC"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="مدين" Foreground="#67727D" FontSize="12"/>
                        <TextBlock x:Name="DebtCustomersCardText" FontSize="26" FontWeight="Bold" Foreground="#C93F4D"/>
                    </StackPanel>
                </Border>
                <Border Background="White"
                        CornerRadius="16"
                        Padding="16"
                        BorderBrush="#D9E2EC"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="رصيد دائن" Foreground="#67727D" FontSize="12"/>
                        <TextBlock x:Name="CreditCustomersCardText" FontSize="26" FontWeight="Bold" Foreground="#2D8DCF"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,18,0,0"
                    Style="{StaticResource AppCardBorderStyle}"
                    Padding="16">
                <DataGrid x:Name="CustomersGrid"
                          Style="{StaticResource AppModernDataGridStyle}"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          SelectionChanged="CustomersGrid_SelectionChanged"
                          MouseDoubleClick="CustomersGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المعرف" Binding="{Binding Id}" Width="90"/>
                        <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="الدور" Binding="{Binding Role}" Width="1.1*"/>
                        <DataGridTextColumn Header="الهاتف" Binding="{Binding PhoneNumber}" Width="1.2*"/>
                        <DataGridTextColumn Header="الحد الائتماني" Binding="{Binding CreditLimit, StringFormat={}{0:N2}}" Width="1.2*"/>
                        <DataGridTextColumn Header="الرصيد الحالي" Binding="{Binding CurrentBalance, StringFormat={}{0:N2}}" Width="1.2*"/>
                        <DataGridTextColumn Header="حالة الائتمان" Binding="{Binding CreditStatus}" Width="1.1*"/>
                        <DataGridTextColumn Header="آخر سداد" Binding="{Binding LastPaymentDate, StringFormat={}{0:yyyy-MM-dd hh:mm tt}}" Width="1.3*"/>
                        <DataGridTextColumn Header="آخر تحديث" Binding="{Binding UpdatedDate, StringFormat={}{0:yyyy-MM-dd hh:mm tt}}" Width="1.4*"/>
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="كشف الحساب" Click="ViewStatement_Click"/>
                            <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="تعديل" Click="UpdateCustomer_Click"/>
                            <MenuItem Style="{StaticResource AppMenuItemStyle}" Header="حذف" Click="DeleteCustomer_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </Border>

                <Border Grid.Column="1"
                        Margin="16,18,0,0"
                        Style="{StaticResource AppCardBorderStyle}"
                        Padding="18">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="تفاصيل العميل أو المورد" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,12"/>
                            <Border Background="#F8FAFC" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="الاسم" Foreground="#67727D" FontSize="12"/>
                                    <TextBlock x:Name="SelectedNameText" FontSize="18" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#F8FAFC" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="الحالة" Foreground="#67727D" FontSize="12"/>
                                    <TextBlock x:Name="SelectedStatusText" FontSize="18" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#F8FAFC" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="الرصيد الحالي" Foreground="#67727D" FontSize="12"/>
                                    <TextBlock x:Name="SelectedBalanceText" FontSize="18" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#F8FAFC" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="الحد الائتماني" Foreground="#67727D" FontSize="12"/>
                                    <TextBlock x:Name="SelectedLimitText" FontSize="18" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#F8FAFC" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="آخر سداد" Foreground="#67727D" FontSize="12"/>
                                    <TextBlock x:Name="SelectedPaymentText" FontSize="18" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#F8FAFC" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="البنك" Foreground="#67727D" FontSize="12"/>
                                    <TextBlock x:Name="SelectedBankText" FontSize="18" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Vertical" Margin="0,8,0,0">
                                <Button x:Name="DetailsStatementBtn"
                                        Content="كشف الحساب"
                                        Style="{StaticResource AppSecondaryButtonStyle}"
                                        Click="ViewStatement_Click"
                                        Margin="0,0,0,10"/>
                                <Button x:Name="DetailsUpdateBtn"
                                        Content="تعديل"
                                        Style="{StaticResource AppHeroButtonStyle}"
                                        Click="UpdateCustomer_Click"
                                        Margin="0,0,0,10"/>
                                <Button x:Name="DetailsDeleteBtn"
                                        Content="حذف"
                                        Style="{StaticResource CancelButtonStyle}"
                                        Click="DeleteCustomer_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
