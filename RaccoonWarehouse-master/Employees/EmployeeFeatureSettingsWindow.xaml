<Window x:Class="RaccoonWarehouse.Employees.EmployeeFeatureSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إعدادات نظام الموظفين"
        FlowDirection="RightToLeft"
        Background="{StaticResource AppPageBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="تفعيل نظام الموظفين" FontSize="26" FontWeight="Bold"/>
            <TextBlock Margin="0,8,0,18"
                       Foreground="{StaticResource AppMutedTextBrush}"
                       Text="عند الإيقاف يتم إخفاء واجهات وإدارة الموظفين مع الحفاظ على البيانات الحالية بدون حذف."/>
            <CheckBox x:Name="EnabledCheckBox" Content="النظام مفعل" FontSize="18"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
            <Button Content="حفظ" Width="120" Margin="6" Style="{StaticResource AppHeroButtonStyle}" Click="Save_Click"/>
            <Button Content="إغلاق" Width="120" Margin="6" Style="{StaticResource AppSecondaryButtonStyle}" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
