<Window x:Class="RaccoonWarehouse.Employees.EmployeeFeatureSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="إعدادات الموظفين" Width="520" Height="300" WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft" Background="{StaticResource AppPageBackgroundBrush}">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="إعدادات نظام الموظفين" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AppTextBrush}"/><StackPanel Grid.Row="1" Margin="0,24"><CheckBox x:Name="Enabled" Content="تفعيل نظام الموظفين والورديات" FontSize="17"/><TextBlock Text="عند التعطيل تختفي القوائم ولا يتم حذف أي بيانات." Foreground="{StaticResource AppMutedTextBrush}" Margin="0,12,0,0"/></StackPanel><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left"><Button Content="حفظ" Width="100" Style="{StaticResource AppHeroButtonStyle}" Click="Save_Click"/><Button Content="إغلاق" Width="100" Margin="8,0,0,0" Style="{StaticResource AppSecondaryButtonStyle}" Click="Close_Click"/></StackPanel></Grid>
</Window>
