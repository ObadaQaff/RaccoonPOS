<Window x:Class="RaccoonWarehouse.Employees.EmployeesTable" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="إدارة الموظفين" Width="1200" Height="760" WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft" Background="{StaticResource AppPageBackgroundBrush}">
    <Grid Margin="24" Loaded="Window_Loaded">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="إضافة موظف" Width="130" Margin="8,0,0,0" Style="{StaticResource AppHeroButtonStyle}" Click="Add_Click"/>
                <Button Content="إدارة الورديات" Width="140" Style="{StaticResource AppSecondaryButtonStyle}" Click="Shifts_Click"/>
            </StackPanel>
            <TextBlock Text="الموظفون" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AppTextBrush}" VerticalAlignment="Center"/>
        </DockPanel>
        <Border Grid.Row="1" Style="{StaticResource AppCardBorderStyle}" Padding="16" Margin="0,0,0,14">
            <DockPanel>
                <CheckBox x:Name="IncludeInactive" Content="عرض غير النشطين" Margin="16,0,0,0" VerticalAlignment="Center" Checked="FilterChanged" Unchecked="FilterChanged"/>
                <Button DockPanel.Dock="Left" Content="بحث" Width="90" Style="{StaticResource AppSecondaryButtonStyle}" Click="Search_Click"/>
                <TextBox x:Name="SearchBox" Height="40" Style="{StaticResource AppSearchTextBoxStyle}" TextChanged="SearchBox_TextChanged" ToolTip="الاسم أو الهاتف أو الرقم الوطني"/>
            </DockPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource AppCardBorderStyle}" Padding="12">
            <DataGrid x:Name="EmployeesGrid" Style="{StaticResource AppModernDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="Grid_DoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الاسم الكامل" Binding="{Binding FullName}" Width="2*"/>
                    <DataGridTextColumn Header="الهاتف" Binding="{Binding PhoneNumber}" Width="1.2*"/>
                    <DataGridTextColumn Header="الرقم الوطني" Binding="{Binding NationalId}" Width="1.2*"/>
                    <DataGridTextColumn Header="المسمى الوظيفي" Binding="{Binding JobTitle}" Width="1.4*"/>
                    <DataGridTextColumn Header="الفرع الرئيسي" Binding="{Binding PrimaryBranchName}" Width="1.2*"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width=".8*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
