<Window x:Class="RaccoonWarehouse.Employees.EmployeeProfileWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ملف الموظف" Width="1200" Height="820" WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft" Background="{StaticResource AppPageBackgroundBrush}">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="0,0,0,16"><TextBlock Text="ملف الموظف" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AppTextBrush}"/><TextBlock x:Name="StatusText" DockPanel.Dock="Left" Margin="20,8,0,0" Foreground="{StaticResource AppMutedTextBrush}"/></DockPanel>
  <TabControl x:Name="ProfileTabs" Grid.Row="1">
   <TabItem Header="المعلومات الشخصية"><ScrollViewer><Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Grid.Column="0" Margin="8"><TextBlock Text="الاسم الكامل" Style="{StaticResource AppFieldLabelStyle}"/><TextBox x:Name="FullName" Style="{StaticResource AppTextInputStyle}"/></StackPanel><StackPanel Grid.Row="0" Grid.Column="1" Margin="8"><TextBlock Text="رقم الهاتف" Style="{StaticResource AppFieldLabelStyle}"/><TextBox x:Name="PhoneNumber" Style="{StaticResource AppTextInputStyle}"/></StackPanel>
    <StackPanel Grid.Row="1" Grid.Column="0" Margin="8"><TextBlock Text="الرقم الوطني" Style="{StaticResource AppFieldLabelStyle}"/><TextBox x:Name="NationalId" Style="{StaticResource AppTextInputStyle}"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="1" Margin="8"><TextBlock Text="البريد الإلكتروني" Style="{StaticResource AppFieldLabelStyle}"/><TextBox x:Name="Email" Style="{StaticResource AppTextInputStyle}"/></StackPanel>
    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="8"><TextBlock Text="العنوان" Style="{StaticResource AppFieldLabelStyle}"/><TextBox x:Name="Address" Style="{StaticResource AppTextInputStyle}"/></StackPanel>
    <StackPanel Grid.Row="3" Grid.Column="0" Margin="8"><TextBlock Text="الفرع الرئيسي" Style="{StaticResource AppFieldLabelStyle}"/><ComboBox x:Name="PrimaryBranch" DisplayMemberPath="Name" SelectedValuePath="Id" Style="{StaticResource AppComboBoxStyle}"/></StackPanel><StackPanel Grid.Row="3" Grid.Column="1" Margin="8"><TextBlock Text="المسمى الوظيفي" Style="{StaticResource AppFieldLabelStyle}"/><TextBox x:Name="JobTitle" Style="{StaticResource AppTextInputStyle}"/></StackPanel>
    <StackPanel Grid.Row="4" Grid.Column="0" Margin="8"><TextBlock Text="تاريخ التوظيف" Style="{StaticResource AppFieldLabelStyle}"/><DatePicker x:Name="EmploymentDate"/></StackPanel><StackPanel Grid.Row="4" Grid.Column="1" Margin="8"><TextBlock Text="الحالة" Style="{StaticResource AppFieldLabelStyle}"/><ComboBox x:Name="Status" Style="{StaticResource AppComboBoxStyle}"/></StackPanel>
   </Grid></ScrollViewer></TabItem>
   <TabItem Header="التوظيف والعقد"><Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Grid.Column="0" Margin="8"><TextBlock Text="نوع العقد" Style="{StaticResource AppFieldLabelStyle}"/><ComboBox x:Name="ContractType" Style="{StaticResource AppComboBoxStyle}"/></StackPanel><StackPanel Grid.Row="0" Grid.Column="1" Margin="8"><TextBlock Text="تاريخ بداية العقد" Style="{StaticResource AppFieldLabelStyle}"/><DatePicker x:Name="ContractStartDate"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="0" Margin="8"><TextBlock Text="تاريخ نهاية العقد (اختياري)" Style="{StaticResource AppFieldLabelStyle}"/><DatePicker x:Name="ContractEndDate"/></StackPanel>
   </Grid></TabItem>
   <TabItem Header="الفروع الإضافية"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><ComboBox x:Name="AdditionalBranch" Width="260" DisplayMemberPath="Name" SelectedValuePath="Id" Style="{StaticResource AppComboBoxStyle}"/><Button Content="إضافة فرع" Width="110" Margin="8,0" Style="{StaticResource AppSecondaryButtonStyle}" Click="AssignBranch_Click"/></StackPanel><DataGrid Grid.Row="1" x:Name="BranchesGrid" Margin="0,16,0,0" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource AppModernDataGridStyle}"><DataGrid.Columns><DataGridTextColumn Header="الفرع" Binding="{Binding BranchName}" Width="2*"/><DataGridTextColumn Header="من تاريخ" Binding="{Binding StartDate, StringFormat=d}" Width="*"/><DataGridTextColumn Header="إلى تاريخ" Binding="{Binding EndDate, StringFormat=d}" Width="*"/><DataGridCheckBoxColumn Header="نشط" Binding="{Binding IsActive}" Width="*"/></DataGrid.Columns></DataGrid></Grid></TabItem>
   <TabItem Header="الورديات"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><ComboBox x:Name="ShiftTemplate" Width="240" DisplayMemberPath="Name" SelectedValuePath="Id" Style="{StaticResource AppComboBoxStyle}"/><ComboBox x:Name="ShiftDay" Width="140" Margin="8,0" Style="{StaticResource AppComboBoxStyle}"/><Button Content="إسناد وردية" Width="120" Style="{StaticResource AppSecondaryButtonStyle}" Click="AssignShift_Click"/></StackPanel><DataGrid Grid.Row="1" x:Name="ShiftsGrid" Margin="0,16,0,0" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource AppModernDataGridStyle}"><DataGrid.Columns><DataGridTextColumn Header="الوردية" Binding="{Binding ShiftName}" Width="2*"/><DataGridTextColumn Header="اليوم" Binding="{Binding DayOfWeek}" Width="*"/><DataGridTextColumn Header="من" Binding="{Binding StartTime}" Width="*"/><DataGridTextColumn Header="إلى" Binding="{Binding EndTime}" Width="*"/><DataGridTextColumn Header="من تاريخ" Binding="{Binding StartDate, StringFormat=d}" Width="*"/></DataGrid.Columns></DataGrid></Grid></TabItem>
   <TabItem Header="الراتب والضمان الاجتماعي"><Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="8"><TextBlock Text="الراتب الأساسي الشهري" Style="{StaticResource AppFieldLabelStyle}"/><TextBox x:Name="MonthlySalary" Style="{StaticResource AppTextInputStyle}"/></StackPanel><StackPanel Grid.Column="1" Margin="8"><CheckBox x:Name="SocialSecurityEnrolled" Content="مشترك في الضمان الاجتماعي" Margin="0,28,0,0"/><TextBlock Text="رقم الضمان" Style="{StaticResource AppFieldLabelStyle}" Margin="0,18,0,0"/><TextBox x:Name="SocialSecurityNumber" Style="{StaticResource AppTextInputStyle}"/></StackPanel></Grid></TabItem>
   <TabItem Header="حساب النظام"><StackPanel Margin="18"><TextBlock Text="ربط حساب مستخدم اختياري" Style="{StaticResource AppFieldLabelStyle}"/><ComboBox x:Name="UserAccount" DisplayMemberPath="Name" SelectedValuePath="Id" Style="{StaticResource AppComboBoxStyle}"/></StackPanel></TabItem>
   <TabItem Header="الصلاحيات"><StackPanel Margin="18"><TextBlock x:Name="PermissionSummary" Text="لا يوجد حساب مستخدم مرتبط بهذا الموظف." TextWrapping="Wrap" Foreground="{StaticResource AppTextBrush}"/><Button Content="إدارة مجموعات الصلاحيات" Width="190" Margin="0,18,0,0" HorizontalAlignment="Right" Style="{StaticResource AppSecondaryButtonStyle}" Click="ManagePermissions_Click"/></StackPanel></TabItem>
  </TabControl>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0"><Button Content="حفظ" Width="120" Style="{StaticResource AppHeroButtonStyle}" Click="Save_Click"/><Button Content="تعطيل الموظف" Width="140" Margin="8,0,0,0" Style="{StaticResource AppSecondaryButtonStyle}" Click="Deactivate_Click"/><Button Content="إغلاق" Width="100" Margin="8,0,0,0" Style="{StaticResource AppSecondaryButtonStyle}" Click="Close_Click"/></StackPanel>
 </Grid>
</Window>
