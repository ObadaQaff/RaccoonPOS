<Window x:Class="RaccoonWarehouse.Employees.CreateBranchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إنشاء فرع" Width="480" Height="330" WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft" Background="{StaticResource AppPageBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="إنشاء فرع جديد" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AppTextBrush}" Margin="0,0,0,18"/>
        <StackPanel Grid.Row="1">
            <TextBlock Text="رمز الفرع" Style="{StaticResource AppFieldLabelStyle}"/>
            <TextBox x:Name="Code" Style="{StaticResource AppTextInputStyle}" Margin="0,4,0,12"/>
            <TextBlock Text="اسم الفرع" Style="{StaticResource AppFieldLabelStyle}"/>
            <TextBox x:Name="Name" Style="{StaticResource AppTextInputStyle}" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,18,0,0">
            <Button Content="حفظ" Width="110" Style="{StaticResource AppHeroButtonStyle}" Click="Save_Click"/>
            <Button Content="إلغاء" Width="110" Margin="8,0,0,0" Style="{StaticResource AppSecondaryButtonStyle}" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
