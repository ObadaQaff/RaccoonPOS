<Window x:Class="RaccoonWarehouse.Employees.HrDashboardWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="الموارد البشرية" Width="1250" Height="820" WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft" Background="{StaticResource AppPageBackgroundBrush}">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="الموارد البشرية" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AppTextBrush}" Margin="0,0,0,16"/>
 <TabControl Grid.Row="1">
  <TabItem Header="الحضور والانصراف"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBox x:Name="AttendanceEmployeeId" Width="100" Style="{StaticResource AppTextInputStyle}" ToolTip="رقم الموظف"/><DatePicker x:Name="AttendanceFrom" Margin="8,0"/><DatePicker x:Name="AttendanceTo" Margin="8,0"/><Button Content="تحديث" Width="90" Style="{StaticResource AppSecondaryButtonStyle}" Click="LoadAttendance_Click"/></StackPanel><DataGrid Grid.Row="1" x:Name="AttendanceGrid" Margin="0,16,0,0" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource AppModernDataGridStyle}"><DataGrid.Columns><DataGridTextColumn Header="الموظف" Binding="{Binding EmployeeName}" Width="2*"/><DataGridTextColumn Header="التاريخ" Binding="{Binding WorkDate, StringFormat=d}" Width="*"/><DataGridTextColumn Header="الحضور" Binding="{Binding CheckIn}" Width="*"/><DataGridTextColumn Header="الانصراف" Binding="{Binding CheckOut}" Width="*"/><DataGridTextColumn Header="الساعات" Binding="{Binding WorkedHours}" Width="*"/><DataGridTextColumn Header="التأخير" Binding="{Binding LateMinutes}" Width="*"/></DataGrid.Columns></DataGrid></Grid></TabItem>
  <TabItem Header="الإجازات"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBox x:Name="LeaveEmployeeId" Width="100" Style="{StaticResource AppTextInputStyle}" ToolTip="رقم الموظف"/><TextBox x:Name="LeaveTypeId" Width="100" Margin="8,0" Style="{StaticResource AppTextInputStyle}" ToolTip="نوع الإجازة"/><DatePicker x:Name="LeaveStart" Margin="8,0"/><DatePicker x:Name="LeaveEnd" Margin="8,0"/><Button Content="طلب إجازة" Width="100" Style="{StaticResource AppHeroButtonStyle}" Click="RequestLeave_Click"/><Button Content="تحديث" Width="90" Margin="8,0" Style="{StaticResource AppSecondaryButtonStyle}" Click="LoadLeaves_Click"/></StackPanel><DataGrid Grid.Row="1" x:Name="LeavesGrid" Margin="0,16,0,0" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource AppModernDataGridStyle}"><DataGrid.Columns><DataGridTextColumn Header="الموظف" Binding="{Binding Employee.FullName}" Width="2*"/><DataGridTextColumn Header="من" Binding="{Binding StartDate, StringFormat=d}" Width="*"/><DataGridTextColumn Header="إلى" Binding="{Binding EndDate, StringFormat=d}" Width="*"/><DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="*"/></DataGrid.Columns></DataGrid></Grid></TabItem>
  <TabItem Header="الرواتب الشهرية"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><DatePicker x:Name="PayrollMonth"/><Button Content="إنشاء مسودة" Width="110" Margin="8,0" Style="{StaticResource AppHeroButtonStyle}" Click="GeneratePayroll_Click"/><Button Content="تحديث" Width="90" Style="{StaticResource AppSecondaryButtonStyle}" Click="LoadPayroll_Click"/></StackPanel><DataGrid Grid.Row="1" x:Name="PayrollGrid" Margin="0,16,0,0" AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource AppModernDataGridStyle}"><DataGrid.Columns><DataGridTextColumn Header="الموظف" Binding="{Binding EmployeeName}" Width="2*"/><DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="*"/><DataGridTextColumn Header="الإجمالي" Binding="{Binding GrossAmount}" Width="*"/><DataGridTextColumn Header="الصافي" Binding="{Binding NetAmount}" Width="*"/></DataGrid.Columns></DataGrid></Grid></TabItem>
  <TabItem Header="التقارير"><TextBlock Margin="20" Text="تتوفر تقارير الحضور والإجازات والرواتب عبر الفلاتر في التبويبات السابقة، ويمكن إضافة تصديرها إلى منظومة التقارير الحالية لاحقاً." TextWrapping="Wrap" FontSize="18"/></TabItem>
 </TabControl></Grid>
</Window>
