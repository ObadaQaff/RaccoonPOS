<Window x:Class="RaccoonWarehouse.Employees.UpdateEmployee"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تعديل موظف"
        Width="980"
        Height="760"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{StaticResource AppPageBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <StackPanel Margin="0,0,0,12"><TextBlock Text="الكود"/><TextBox x:Name="CodeTextBox"/></StackPanel>
                    <StackPanel Margin="0,0,0,12"><TextBlock Text="الهاتف"/><TextBox x:Name="PhoneTextBox"/></StackPanel>
                    <StackPanel Margin="0,0,0,12"><TextBlock Text="البريد الإلكتروني"/><TextBox x:Name="EmailTextBox"/></StackPanel>
                    <StackPanel Margin="0,0,0,12"><TextBlock Text="الحالة"/><ComboBox x:Name="StatusComboBox" Style="{StaticResource AppComboBoxStyle}"/></StackPanel>
                    <StackPanel Margin="0,0,0,12"><TextBlock Text="الوظيفة"/><TextBox x:Name="JobTitleTextBox"/></StackPanel>
                    <StackPanel Margin="0,0,0,12"><TextBlock Text="القسم"/><TextBox x:Name="DepartmentTextBox"/></StackPanel>
                    <StackPanel Margin="0,0,0,12"><TextBlock Text="المستخدم المرتبط"/><ComboBox x:Name="UserComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Style="{StaticResource AppComboBoxStyle}"/></StackPanel>
                    <StackPanel Margin="0,0,0,12"><TextBlock Text="تاريخ التعيين"/><DatePicker x:Name="HireDatePicker"/></StackPanel>
                    <StackPanel Margin="0,0,0,12"><TextBlock Text="تاريخ الميلاد"/><DatePicker x:Name="BirthDatePicker"/></StackPanel>
                    <StackPanel Margin="0,0,0,12"><TextBlock Text="ملاحظات"/><TextBox x:Name="NotesTextBox" Height="70" TextWrapping="Wrap" AcceptsReturn="True"/></StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <StackPanel Margin="0,0,0,12"><TextBlock Text="الاسم الكامل"/><TextBox x:Name="FullNameTextBox"/></StackPanel>
                    <StackPanel Margin="0,0,0,12"><TextBlock Text="هاتف إضافي"/><TextBox x:Name="AltPhoneTextBox"/></StackPanel>
                    <StackPanel Margin="0,0,0,12"><TextBlock Text="رقم الهوية"/><TextBox x:Name="NationalIdTextBox"/></StackPanel>
                    <StackPanel Margin="0,0,0,12"><TextBlock Text="الجنس"/><ComboBox x:Name="GenderComboBox" Style="{StaticResource AppComboBoxStyle}"/></StackPanel>
                    <StackPanel Margin="0,0,0,12"><TextBlock Text="الفرع"/><TextBox x:Name="BranchTextBox"/></StackPanel>
                    <StackPanel Margin="0,0,0,12"><TextBlock Text="المدير المباشر"/><ComboBox x:Name="ManagerComboBox" DisplayMemberPath="FullName" SelectedValuePath="Id" Style="{StaticResource AppComboBoxStyle}"/></StackPanel>
                    <StackPanel Margin="0,0,0,12"><TextBlock Text="الراتب الأساسي"/><TextBox x:Name="BasicSalaryTextBox"/></StackPanel>
                    <StackPanel Margin="0,0,0,12"><TextBlock Text="تاريخ إنهاء الخدمة"/><DatePicker x:Name="TerminationDatePicker"/></StackPanel>
                    <StackPanel Margin="0,0,0,12"><TextBlock Text="العنوان"/><TextBox x:Name="AddressTextBox" Height="70" TextWrapping="Wrap" AcceptsReturn="True"/></StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
            <Button Content="حفظ" Width="120" Margin="6" Style="{StaticResource AppHeroButtonStyle}" Click="Save_Click"/>
            <Button Content="إغلاق" Width="120" Margin="6" Style="{StaticResource AppSecondaryButtonStyle}" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
