<Window x:Class="RaccoonWarehouse.Employees.HrFeatureSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="إعدادات الموارد البشرية" Width="540" Height="320" WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft" Background="{StaticResource AppPageBackgroundBrush}"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="إعدادات الموارد البشرية" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AppTextBrush}"/><StackPanel Grid.Row="1" Margin="0,24"><CheckBox x:Name="Enabled" Content="تفعيل نظام الموارد البشرية" FontSize="17"/><TextBlock Text="يتطلب تفعيل نظام الموظفين أولاً." Margin="0,12" Foreground="{StaticResource AppMutedTextBrush}"/></StackPanel><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left"><Button Content="حفظ" Width="100" Style="{StaticResource AppHeroButtonStyle}" Click="Save_Click"/><Button Content="إغلاق" Width="100" Margin="8,0" Style="{StaticResource AppSecondaryButtonStyle}" Click="Close_Click"/></StackPanel></Grid></Window>
