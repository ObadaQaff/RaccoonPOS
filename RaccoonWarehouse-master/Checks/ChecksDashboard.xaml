<Window x:Class="RaccoonWarehouse.ChecksDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        mc:Ignorable="d"
        Title="متابعة الشيكات"
        Height="800"
        Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        Background="{StaticResource AppPageBackgroundBrush}">
    <Grid Background="{StaticResource AppPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="220"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="0,0,34,34" Background="{StaticResource AppDashboardHeroBrush}">
            <Grid Margin="34,24,34,34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="متابعة الشيكات"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock x:Name="FeatureStateText"
                               Margin="0,10,0,0"
                               FontSize="14"
                               Foreground="#D7F1FF"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Padding="18,12"
                        CornerRadius="20"
                        Background="#1FFFFFFF"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="إجمالي الشيكات"
                                   FontSize="12"
                                   Foreground="#CFE8E3"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TotalChecksText"
                                   Margin="0,4,0,0"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="النتائج المعروضة"
                                   Margin="0,8,0,0"
                                   FontSize="12"
                                   Foreground="#CFE8E3"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="VisibleChecksText"
                                   Margin="0,4,0,0"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="الشيكات المفتوحة"
                                   Margin="0,8,0,0"
                                   FontSize="12"
                                   Foreground="#CFE8E3"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="DueChecksText"
                                   Margin="0,4,0,0"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,-52,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource AppCardBorderStyle}"
                    Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="125"/>
                        <ColumnDefinition Width="125"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="135"/>
                        <ColumnDefinition Width="135"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchBox"
                             Grid.Column="0"
                             Margin="0,0,10,0"
                             Style="{StaticResource AppSearchTextBoxStyle}"
                             TextChanged="SearchBox_TextChanged"
                             ToolTip="ابحث برقم الشيك أو البنك أو مصدره أو الملاحظات"/>

                    <ComboBox x:Name="StatusFilter"
                              Grid.Column="1"
                              Margin="0,0,10,0"
                              Style="{StaticResource AppComboBoxStyle}"
                              SelectionChanged="FilterChanged"/>

                    <ComboBox x:Name="SourceFilter"
                              Grid.Column="2"
                              Margin="0,0,10,0"
                              Style="{StaticResource AppComboBoxStyle}"
                              SelectionChanged="FilterChanged"/>

                    <ComboBox x:Name="PartyTypeFilter"
                              Grid.Column="3"
                              Margin="0,0,10,0"
                              Style="{StaticResource AppComboBoxStyle}"
                              SelectionChanged="PartyTypeFilter_SelectionChanged"/>

                    <ComboBox x:Name="PartyFilter"
                              Grid.Column="4"
                              Margin="0,0,10,0"
                              Style="{StaticResource AppComboBoxStyle}"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              StaysOpenOnEdit="True"
                              SelectionChanged="FilterChanged"/>

                    <DatePicker x:Name="DueFromPicker"
                                Grid.Column="5"
                                Margin="0,0,10,0"
                                SelectedDateChanged="FilterChanged"/>

                    <DatePicker x:Name="DueToPicker"
                                Grid.Column="6"
                                Margin="0,0,10,0"
                                SelectedDateChanged="FilterChanged"/>

                    <StackPanel Grid.Column="8"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left">
                        <Button x:Name="OpenSourceBtn"
                                Width="150"
                                Margin="0,0,12,0"
                                Style="{StaticResource AppSecondaryButtonStyle}"
                                Click="OpenSourceBtn_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <fa:ImageAwesome Icon="ExternalLink" Width="16" Height="16"
                                                 Margin="0,0,8,0"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="فتح المصدر" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="RefreshBtn"
                                Width="120"
                                Margin="0,0,12,0"
                                Style="{StaticResource AppHeroButtonStyle}"
                                Click="RefreshBtn_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <fa:ImageAwesome Icon="Refresh" Width="16" Height="16"
                                                 Margin="0,0,8,0"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="تحديث" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BackBtn"
                                Width="120"
                                Style="{StaticResource AppSecondaryButtonStyle}"
                                Click="BackBtn_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <fa:ImageAwesome Icon="ArrowRight" Width="16" Height="16"
                                                 Margin="0,0,8,0"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="عودة" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="0,18,0,0"
                    Style="{StaticResource AppCardBorderStyle}"
                    Padding="16">
                <DataGrid x:Name="ChecksGrid"
                          Style="{StaticResource AppModernDataGridStyle}"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          MouseDoubleClick="ChecksGrid_MouseDoubleClick">
                    <DataGrid.Resources>
                        <ContextMenu x:Key="CheckRowContextMenu">
                            <MenuItem Style="{StaticResource AppMenuItemStyle}"
                                      Header="فتح المصدر"
                                      Click="OpenSourceMenuItem_Click"/>
                            <MenuItem Style="{StaticResource AppMenuItemStyle}"
                                      Header="تعديل"
                                      Click="EditCheckMenuItem_Click"/>
                            <Separator/>
                            <MenuItem Style="{StaticResource AppMenuItemStyle}"
                                      Header="إيداع"
                                      Click="MarkDepositedMenuItem_Click"/>
                            <MenuItem Style="{StaticResource AppMenuItemStyle}"
                                      Header="تصفية"
                                      Click="MarkClearedMenuItem_Click"/>
                            <MenuItem Style="{StaticResource AppMenuItemStyle}"
                                      Header="راجع"
                                      Click="MarkBouncedMenuItem_Click"/>
                            <MenuItem Style="{StaticResource AppMenuItemStyle}"
                                      Header="إلغاء"
                                      Click="MarkCancelledMenuItem_Click"/>
                        </ContextMenu>
                    </DataGrid.Resources>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="ContextMenu" Value="{StaticResource CheckRowContextMenu}"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الرقم" Binding="{Binding CheckNumber}" Width="1.2*"/>
                        <DataGridTextColumn Header="البنك" Binding="{Binding BankName}" Width="1.2*"/>
                        <DataGridTextColumn Header="تاريخ الاستحقاق" Binding="{Binding DueDate, StringFormat={}{0:yyyy-MM-dd}}" Width="1.1*"/>
                        <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="1*"/>
                        <DataGridTextColumn Header="المصدر" Binding="{Binding SourceTypeText}" Width="1*"/>
                        <DataGridTextColumn Header="رقم المصدر" Binding="{Binding SourceNumber}" Width="1.2*"/>
                        <DataGridTextColumn x:Name="PartyTypeColumn" Header="نوع الجهة" Binding="{Binding PartyTypeText}" Width="1*"/>
                        <DataGridTextColumn x:Name="PartyNameColumn" Header="المستخدم" Binding="{Binding PartyName}" Width="1.4*"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding StatusText}" Width="1*"/>
                        <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="1.6*"/>
                        <DataGridTextColumn Header="تاريخ الإنشاء" Binding="{Binding CreatedDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="1.3*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</Window>
