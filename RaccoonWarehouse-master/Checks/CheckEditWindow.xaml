<Window x:Class="RaccoonWarehouse.Invoices.CheckEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="تعديل الشيك"
        Height="360"
        Width="920"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F6F8FB">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#EAF3FB" CornerRadius="14" Padding="14" Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="TitleText"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#1F3B58"
                           DockPanel.Dock="Right"/>
                <TextBlock x:Name="SubtitleText"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="#334155"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="14" Padding="14" BorderBrush="#D9E2EC" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.0*"/>
                    <ColumnDefinition Width="1.0*"/>
                    <ColumnDefinition Width="1.3*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="6,0">
                    <TextBlock x:Name="CheckNumberLabel" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="CheckNumberBox" Height="32"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="6,0">
                    <TextBlock x:Name="BankNameLabel" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="BankNameBox" Height="32"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="6,0">
                    <TextBlock x:Name="DueDateLabel" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <DatePicker x:Name="CheckDueDatePicker" Height="32"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="6,0">
                    <TextBlock x:Name="AmountLabel" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="CheckAmountBox" Height="32"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Margin="6,0">
                    <TextBlock x:Name="NotesLabel" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="CheckNotesBox" Height="32"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button x:Name="SaveButton"
                    Width="130"
                    Height="36"
                    Margin="6,0"
                    Click="SaveButton_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="ContentSave" Width="18" Height="18" Margin="0,0,8,0"/>
                    <TextBlock Text="حفظ" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="CancelButton"
                    Width="130"
                    Height="36"
                    Margin="6,0"
                    Click="CancelButton_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="ArrowLeft" Width="18" Height="18" Margin="0,0,8,0"/>
                    <TextBlock Text="إلغاء" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
