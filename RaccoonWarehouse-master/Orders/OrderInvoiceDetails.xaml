<Window x:Class="RaccoonWarehouse.Orders.OrderInvoiceDetails"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="&#x62A;&#x641;&#x627;&#x635;&#x64A;&#x644; &#x627;&#x644;&#x641;&#x627;&#x62A;&#x648;&#x631;&#x629;"
        Height="800"
        Width="1400"
        WindowStartupLocation="CenterScreen"
        FlowDirection="{DynamicResource CurrentFlowDirection}"
        Background="{StaticResource AppPageBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource AppDashboardHeroBrush}"
                CornerRadius="24"
                Padding="24"
                Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="&#x62A;&#x641;&#x627;&#x635;&#x64A;&#x644; &#x627;&#x644;&#x641;&#x627;&#x62A;&#x648;&#x631;&#x629;"
                           Foreground="White"
                           FontSize="30"
                           FontWeight="Bold"/>
                <TextBlock x:Name="InvoiceTitleText"
                           Foreground="#E7F1F4"
                           FontSize="15"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <UniformGrid Grid.Row="1"
                     Columns="4"
                     Margin="0,0,0,14">
            <Border Style="{StaticResource AppCardBorderStyle}" Padding="14" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="&#x631;&#x642;&#x645; &#x627;&#x644;&#x641;&#x627;&#x62A;&#x648;&#x631;&#x629;" FontSize="13" Foreground="#657078"/>
                    <TextBlock x:Name="InvoiceNumberText" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource AppCardBorderStyle}" Padding="14" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="&#x627;&#x644;&#x639;&#x645;&#x64A;&#x644;" FontSize="13" Foreground="#657078"/>
                    <TextBlock x:Name="CustomerText" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource AppCardBorderStyle}" Padding="14" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="&#x627;&#x644;&#x62D;&#x627;&#x644;&#x629;" FontSize="13" Foreground="#657078"/>
                    <ComboBox x:Name="StatusComboBox"
                              Height="36"
                              Margin="0,4,0,0"
                              FontSize="16"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource AppCardBorderStyle}" Padding="14">
                <StackPanel>
                    <TextBlock Text="&#x627;&#x644;&#x625;&#x62C;&#x645;&#x627;&#x644;&#x64A;" FontSize="13" Foreground="#657078"/>
                    <TextBlock x:Name="TotalAmountText" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2"
                Style="{StaticResource AppCardBorderStyle}"
                Padding="14"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="&#x627;&#x644;&#x635;&#x646;&#x641;" Margin="0,0,0,5"/>
                    <ComboBox x:Name="ProductComboBox"
                              Height="38"
                              DisplayMemberPath="Name"
                              SelectionChanged="ProductComboBox_SelectionChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="&#x627;&#x644;&#x648;&#x62D;&#x62F;&#x629;" Margin="0,0,0,5"/>
                    <ComboBox x:Name="UnitComboBox"
                              Height="38"
                              DisplayMemberPath="Name"
                              SelectionChanged="UnitComboBox_SelectionChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="&#x627;&#x644;&#x643;&#x645;&#x64A;&#x629;" Margin="0,0,0,5"/>
                    <TextBox x:Name="QuantityTextBox" Height="38" Padding="8,5"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                    <TextBlock Text="&#x627;&#x644;&#x633;&#x639;&#x631;" Margin="0,0,0,5"/>
                    <TextBox x:Name="UnitPriceTextBox" Height="38" Padding="8,5"/>
                </StackPanel>
                <Button Grid.Column="4"
                        x:Name="AddReplaceLineButton"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="135"
                        Height="38"
                        Margin="0,22,10,0"
                        Click="AddReplaceLine_Click"
                        Content="&#x625;&#x636;&#x627;&#x641;&#x629; / &#x627;&#x633;&#x62A;&#x628;&#x62F;&#x627;&#x644;"/>
                <Button Grid.Column="5"
                        x:Name="DeleteLineButton"
                        Style="{StaticResource SecondaryButtonStyle}"
                        MinWidth="105"
                        Height="38"
                        Margin="0,22,0,0"
                        Click="DeleteLine_Click"
                        Content="&#x62D;&#x630;&#x641;"/>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Style="{StaticResource AppCardBorderStyle}"
                Padding="14">
            <DataGrid x:Name="LinesGrid"
                       AutoGenerateColumns="False"
                       CanUserAddRows="False"
                       IsReadOnly="False"
                       FontSize="15"
                       HeadersVisibility="Column"
                       GridLinesVisibility="Horizontal"
                       SelectionChanged="LinesGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="&#x631;&#x642;&#x645; &#x627;&#x644;&#x635;&#x646;&#x641;" Binding="{Binding ProductId}" IsReadOnly="True" Width="120"/>
                    <DataGridTextColumn Header="&#x627;&#x644;&#x635;&#x646;&#x641;" Binding="{Binding ProductName}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn Header="&#x627;&#x644;&#x648;&#x62D;&#x62F;&#x629;" Binding="{Binding UnitName}" IsReadOnly="True" Width="150"/>
                    <DataGridTextColumn Header="&#x627;&#x644;&#x643;&#x645;&#x64A;&#x629;" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                    <DataGridTextColumn Header="&#x627;&#x644;&#x633;&#x639;&#x631;" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                    <DataGridTextColumn Header="&#x627;&#x644;&#x636;&#x631;&#x64A;&#x628;&#x629;" Binding="{Binding TaxAmount, StringFormat={}{0:N2}}" IsReadOnly="True" Width="130"/>
                    <DataGridTextColumn Header="&#x627;&#x644;&#x625;&#x62C;&#x645;&#x627;&#x644;&#x64A;" Binding="{Binding LineTotal, StringFormat={}{0:N2}}" IsReadOnly="True" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button x:Name="SaveDetailsButton"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="170"
                    Height="42"
                    Margin="0,0,10,0"
                    Click="SaveDetails_Click"
                    Content="&#x62D;&#x641;&#x638; &#x627;&#x644;&#x62A;&#x641;&#x627;&#x635;&#x64A;&#x644;"/>
            <Button Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="150"
                    Height="42"
                    Margin="0,0,10,0"
                    Click="SaveStatus_Click"
                    Content="&#x62D;&#x641;&#x638; &#x627;&#x644;&#x62D;&#x627;&#x644;&#x629;"/>
            <Button Style="{StaticResource SecondaryButtonStyle}"
                    MinWidth="120"
                    Height="42"
                    Click="Close_Click"
                    Content="&#x625;&#x63A;&#x644;&#x627;&#x642;"/>
        </StackPanel>
    </Grid>
</Window>
