<Window x:Class="RaccoonWarehouse.Orders.ImportOrder"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Title="&#x637;&#x644;&#x628;&#x627;&#x62A; &#x627;&#x644;&#x627;&#x633;&#x62A;&#x64A;&#x631;&#x627;&#x62F;"
        Height="800"
        Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="{DynamicResource CurrentFlowDirection}"
        Background="{StaticResource AppPageBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource AppDashboardHeroBrush}"
                CornerRadius="24"
                Padding="24"
                Margin="0,0,0,14">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="&#x637;&#x644;&#x628;&#x627;&#x62A; &#x627;&#x644;&#x627;&#x633;&#x62A;&#x64A;&#x631;&#x627;&#x62F;"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold"/>
                    <TextBlock Text="&#x631;&#x627;&#x62C;&#x639; &#x637;&#x644;&#x628;&#x627;&#x62A; Box &#x627;&#x644;&#x645;&#x639;&#x644;&#x642;&#x629; &#x648;&#x627;&#x633;&#x62A;&#x64A;&#x631;&#x62F;&#x647;&#x627; &#x643;&#x637;&#x644;&#x628;&#x627;&#x62A; &#x645;&#x62D;&#x644;&#x64A;&#x629;"
                               Foreground="#E7F1F4"
                               FontSize="15"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="RefreshButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="150"
                            Height="42"
                            Margin="0,0,10,0"
                            Click="RefreshPending_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <fa:ImageAwesome Icon="Refresh" Width="16" Height="16"
                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text=" &#x62A;&#x62D;&#x62F;&#x64A;&#x62B; &#x627;&#x644;&#x637;&#x644;&#x628;&#x627;&#x62A;" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ImportButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="150"
                            Height="42"
                            Click="ImportPending_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <fa:ImageAwesome Icon="Download" Width="16" Height="16"
                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text=" &#x627;&#x633;&#x62A;&#x64A;&#x631;&#x627;&#x62F;" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource AppCardBorderStyle}"
                Padding="16"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="&#x627;&#x644;&#x637;&#x644;&#x628;&#x627;&#x62A; &#x627;&#x644;&#x645;&#x639;&#x644;&#x642;&#x629;"
                               FontWeight="SemiBold"
                               Foreground="#657078"/>
                    <TextBlock x:Name="PendingCountText"
                               Text="0"
                               FontSize="28"
                               FontWeight="Bold"
                                Foreground="{StaticResource AppPrimaryDarkBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="&#x627;&#x644;&#x645;&#x633;&#x62A;&#x644;&#x645;&#x629;"
                               FontWeight="SemiBold"
                               Foreground="#657078"/>
                    <TextBlock x:Name="ReceivedCountText"
                               Text="0"
                               FontSize="28"
                               FontWeight="Bold"
                                Foreground="{StaticResource AppPrimaryDarkBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="&#x627;&#x644;&#x645;&#x633;&#x62A;&#x648;&#x631;&#x62F;&#x629;"
                               FontWeight="SemiBold"
                               Foreground="#657078"/>
                    <TextBlock x:Name="ImportedCountText"
                               Text="0"
                               FontSize="28"
                               FontWeight="Bold"
                                Foreground="{StaticResource AppPrimaryDarkBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="&#x627;&#x644;&#x645;&#x62A;&#x62C;&#x627;&#x648;&#x632;&#x629;"
                               FontWeight="SemiBold"
                               Foreground="#657078"/>
                    <TextBlock x:Name="SkippedCountText"
                               Text="0"
                               FontSize="28"
                               FontWeight="Bold"
                                Foreground="{StaticResource AppPrimaryDarkBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource AppCardBorderStyle}"
                    Padding="14"
                    Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="&#x642;&#x627;&#x626;&#x645;&#x629; &#x637;&#x644;&#x628;&#x627;&#x62A; Box &#x627;&#x644;&#x645;&#x639;&#x644;&#x642;&#x629;"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <DataGrid x:Name="PendingOrdersGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              FontSize="15"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="&#x631;&#x642;&#x645; &#x627;&#x644;&#x637;&#x644;&#x628;" Binding="{Binding CartId}" Width="110"/>
                            <DataGridTextColumn Header="&#x627;&#x644;&#x639;&#x645;&#x64A;&#x644;" Binding="{Binding CustomerName}" Width="*"/>
                            <DataGridTextColumn Header="&#x627;&#x644;&#x647;&#x627;&#x62A;&#x641;" Binding="{Binding CustomerPhone}" Width="140"/>
                            <DataGridTextColumn Header="&#x627;&#x644;&#x645;&#x62A;&#x62C;&#x631;" Binding="{Binding ShopName}" Width="*"/>
                            <DataGridTextColumn Header="&#x627;&#x644;&#x623;&#x635;&#x646;&#x627;&#x641;" Binding="{Binding ItemsCount}" Width="100"/>
                            <DataGridTextColumn Header="&#x627;&#x644;&#x625;&#x62C;&#x645;&#x627;&#x644;&#x64A;" Binding="{Binding TotalPrice, StringFormat={}{0:N2}}" Width="120"/>
                            <DataGridTextColumn Header="&#x627;&#x644;&#x62A;&#x627;&#x631;&#x64A;&#x62E;" Binding="{Binding CreatedDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="StatusText"
                               Grid.Row="2"
                               Margin="4,12,4,0"
                               Foreground="#657078"
                               FontSize="15"/>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource AppCardBorderStyle}"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="&#x645;&#x644;&#x62E;&#x635; &#x627;&#x644;&#x627;&#x633;&#x62A;&#x64A;&#x631;&#x627;&#x62F;"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,12"/>

                    <TextBlock x:Name="ResultSummaryText"
                               Grid.Row="1"
                               TextWrapping="Wrap"
                               FontSize="15"
                               Foreground="#334155"
                               Margin="0,0,0,12"/>

                    <ListBox x:Name="ErrorsList"
                             Grid.Row="2"
                             FontSize="14"/>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button x:Name="OpenOrdersButton"
                    MinWidth="150"
                    Height="42"
                    Margin="0,0,10,0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="OpenOrders_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <fa:ImageAwesome Icon="List" Width="16" Height="16"
                                     Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    <TextBlock Text=" &#x639;&#x631;&#x636; &#x627;&#x644;&#x637;&#x644;&#x628;&#x627;&#x62A;" Margin="8,0,0,0"/>
                </StackPanel>
            </Button>

            <Button MinWidth="120"
                    Height="42"
                    Click="BackBtn_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <fa:ImageAwesome Icon="ArrowLeft" Width="16" Height="16"/>
                    <TextBlock Text=" &#x631;&#x62C;&#x648;&#x639;" Margin="8,0,0,0"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
