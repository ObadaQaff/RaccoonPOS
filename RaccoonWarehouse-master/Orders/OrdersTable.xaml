<Window x:Class="RaccoonWarehouse.Orders.OrdersTable"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Title="&#x627;&#x644;&#x637;&#x644;&#x628;&#x64A;&#x627;&#x62A;"
        Height="800"
        Width="1400"
        WindowStartupLocation="CenterScreen"
        FlowDirection="{DynamicResource CurrentFlowDirection}"
        Background="{StaticResource AppPageBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource AppDashboardHeroBrush}"
                CornerRadius="24"
                Padding="24"
                Margin="0,0,0,14">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="&#x627;&#x644;&#x637;&#x644;&#x628;&#x64A;&#x627;&#x62A;"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold"/>
                    <TextBlock Text="&#x639;&#x631;&#x636; &#x627;&#x644;&#x641;&#x648;&#x627;&#x62A;&#x64A;&#x631; &#x627;&#x644;&#x645;&#x646;&#x634;&#x623;&#x629; &#x645;&#x646; &#x627;&#x644;&#x640; API"
                               Foreground="#E7F1F4"
                               FontSize="15"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <Button DockPanel.Dock="Right"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="130"
                        Height="42"
                        Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <fa:ImageAwesome Icon="Refresh" Width="16" Height="16"
                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <TextBlock Text=" &#x62A;&#x62D;&#x62F;&#x64A;&#x62B;" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <TextBlock x:Name="StatusText"
                   Grid.Row="1"
                   Margin="4,0,4,12"
                   FontSize="15"
                   Foreground="#657078"/>

        <Border Grid.Row="2"
                Style="{StaticResource AppCardBorderStyle}"
                Padding="14">
            <DataGrid x:Name="OrdersGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      FontSize="15"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      MouseDoubleClick="OrdersGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="&#x627;&#x644;&#x645;&#x639;&#x631;&#x641;" Binding="{Binding Id}" Width="90"/>
                    <DataGridTextColumn Header="&#x631;&#x642;&#x645; &#x627;&#x644;&#x641;&#x627;&#x62A;&#x648;&#x631;&#x629;" Binding="{Binding InvoiceNumber}" Width="*"/>
                    <DataGridTextColumn Header="&#x627;&#x644;&#x639;&#x645;&#x64A;&#x644;" Binding="{Binding CustomerName}" Width="*"/>
                    <DataGridTextColumn Header="&#x627;&#x644;&#x62A;&#x627;&#x631;&#x64A;&#x62E;" Binding="{Binding CreatedDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="170"/>
                    <DataGridTextColumn Header="&#x627;&#x644;&#x62D;&#x627;&#x644;&#x629;" Binding="{Binding Status}" Width="130"/>
                    <DataGridTextColumn Header="&#x639;&#x62F;&#x62F; &#x627;&#x644;&#x623;&#x635;&#x646;&#x627;&#x641;" Binding="{Binding DisplayItemsCount}" Width="140"/>
                    <DataGridTextColumn Header="&#x627;&#x644;&#x625;&#x62C;&#x645;&#x627;&#x644;&#x64A;" Binding="{Binding TotalAmount, StringFormat={}{0:N2}}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
