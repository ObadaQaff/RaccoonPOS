<Window x:Class="RaccoonWarehouse.ChatAssistant.ChatAssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ROCCOPOS Assistant" Width="600" Height="650" MinWidth="460" MinHeight="500"
        Background="{StaticResource AppPageBackgroundBrush}" WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{StaticResource AppSidebarBrush}" CornerRadius="16" Padding="18" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="AssistantTitleTextBlock" Foreground="{StaticResource AppSidebarTextBrush}" FontSize="22" FontWeight="Bold"/>
                    <TextBlock x:Name="AssistantDescriptionTextBlock" Foreground="{StaticResource AppAccentBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="ClearButton" Padding="10,6" Margin="6,0,0,0" Click="ClearButton_Click"/>
                    <Button x:Name="SettingsButton" Padding="10,6" Margin="6,0,0,0" Click="SettingsButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource AppCardBorderStyle}" Padding="12" Margin="0,0,0,12">
            <ScrollViewer x:Name="MessagesScrollViewer" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Messages}"><ItemsControl.ItemTemplate><DataTemplate>
                    <Border CornerRadius="14" Padding="12">
                        <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource AppPanelSoftBrush}"/><Setter Property="Margin" Value="0,6,44,6"/>
                            <Style.Triggers><DataTrigger Binding="{Binding IsFromUser}" Value="True"><Setter Property="Background" Value="{StaticResource AppAccentBrush}"/><Setter Property="Margin" Value="44,6,0,6"/><Setter Property="HorizontalAlignment" Value="Left"/></DataTrigger></Style.Triggers>
                        </Style></Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="15"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsThinking}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{StaticResource AppMutedTextBrush}" Margin="0,2,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsThinking}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:HH:mm}}" Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource AppMutedTextBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsThinking}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding ActionLabel}" Tag="{Binding ActionKey}" Click="OpenActionButton_Click" Margin="0,8,8,0" Padding="10,5"><Button.Style><Style TargetType="Button"><Style.Triggers><DataTrigger Binding="{Binding ActionKey}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                <Button x:Name="CopyButton" Content="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CopyButtonContent}" Click="CopyButton_Click" Padding="10,5" Margin="0,8,0,0"><Button.Style><Style TargetType="Button"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsFromUser}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsThinking}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="MessageTextBox" MinHeight="46" Padding="12,8" FontSize="15" VerticalContentAlignment="Center" KeyDown="MessageTextBox_KeyDown"/>
            <Button x:Name="SendButton" Grid.Column="1" MinWidth="92" Margin="10,0,0,0" Click="SendButton_Click"/>
        </Grid>
    </Grid>
</Window>
