<Window x:Class="RaccoonWarehouse.ChatAssistant.ChatAssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ROCCOPOS Assistant" Width="600" Height="650" MinWidth="460" MinHeight="500"
        Background="{StaticResource AppPageBackgroundBrush}" WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource AppSidebarBrush}" CornerRadius="16" Padding="18" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="مساعد ROCCOPOS" Foreground="{StaticResource AppSidebarTextBrush}" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Demo responses only — live data is not connected" Foreground="{StaticResource AppAccentBrush}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
        <Button x:Name="SettingsButton" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,14,0,0" Padding="12,6" Click="SettingsButton_Click"/>
        <Border Grid.Row="1" Style="{StaticResource AppCardBorderStyle}" Padding="12" Margin="0,0,0,12">
            <ScrollViewer x:Name="MessagesScrollViewer" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="14" Padding="12">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource AppPanelSoftBrush}"/>
                                        <Setter Property="Margin" Value="0,6,44,6"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFromUser}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AppAccentBrush}"/>
                                                <Setter Property="Margin" Value="44,6,0,6"/>
                                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="15">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsThinking}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsThinking}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Grid Width="16" Height="16" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                            <Grid.RenderTransform>
                                                <RotateTransform x:Name="SpinnerRotation"/>
                                            </Grid.RenderTransform>
                                            <Grid.Triggers>
                                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetName="SpinnerRotation"
                                                                             Storyboard.TargetProperty="Angle"
                                                                             From="0" To="360" Duration="0:0:0.8"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Grid.Triggers>
                                            <Ellipse Width="14" Height="14"
                                                     Stroke="{StaticResource AppMutedTextBrush}"
                                                     StrokeThickness="2"
                                                     Opacity="0.25"/>
                                            <Path Data="M 8,1 A 7,7 0 0 1 15,8"
                                                  Stroke="{StaticResource AppAccentBrush}"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Text}" Margin="8,0,0,0" FontSize="12" Foreground="{StaticResource AppMutedTextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:HH:mm}}" Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource AppMutedTextBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsThinking}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Content="{Binding ActionLabel}" Tag="{Binding ActionKey}" Click="OpenActionButton_Click"
                                            HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,5">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActionKey}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="MessageTextBox" MinHeight="46" Padding="12,8" FontSize="15" VerticalContentAlignment="Center" KeyDown="MessageTextBox_KeyDown"/>
            <Button x:Name="SendButton" Grid.Column="1" Content="إرسال" MinWidth="92" Margin="10,0,0,0" Click="SendButton_Click"/>
        </Grid>
    </Grid>
</Window>
