<Window x:Class="RaccoonWarehouse.Stocks.Reports.ExpiringStockReport"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Expiry and Near-Expiry Stock" Height="750" Width="1250" WindowStartupLocation="CenterScreen" WindowState="Maximized" FlowDirection="RightToLeft" Background="#EEF3F7">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#0F5B52" CornerRadius="18" Padding="18" Margin="0,0,0,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right"><TextBlock Text="Expiring and Near-Expiry Stock" Foreground="White" FontSize="28" FontWeight="Bold"/><TextBlock Text="Review batches before expiry and prioritize FEFO dispatch." Foreground="#D3E6F3" FontSize="14"/></StackPanel>
                <TextBlock x:Name="TotalCostText" DockPanel.Dock="Left" Text="0.000" Foreground="White" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="White" Padding="12" CornerRadius="12" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Days ahead" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="DaysComboBox" Width="120" SelectedIndex="2" Margin="0,0,16,0"><ComboBoxItem Content="Expired" Tag="0"/><ComboBoxItem Content="30 days" Tag="30"/><ComboBoxItem Content="90 days" Tag="90"/><ComboBoxItem Content="180 days" Tag="180"/></ComboBox>
                    <TextBlock Text="Supplier" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="SupplierComboBox" Width="280" DisplayMemberPath="Name" SelectedValuePath="Id" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True"/>
                    <Button Content="Refresh" Width="110" Margin="16,0,0,0" Click="Refresh_Click"/>
                </StackPanel>
            </Border>
            <DataGrid Grid.Row="1" x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Barcode" Binding="{Binding ITEMCODE}" Width="140"/><DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="280"/><DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="220"/><DataGridTextColumn Header="Unit" Binding="{Binding UnitName}" Width="120"/><DataGridTextColumn Header="Remaining quantity" Binding="{Binding RemainingQuantity, StringFormat=N3}" Width="150"/><DataGridTextColumn Header="Purchase cost" Binding="{Binding PurchasePrice, StringFormat=N3}" Width="140"/><DataGridTextColumn Header="Total cost" Binding="{Binding TotalCost, StringFormat=N3}" Width="140"/><DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryDate, StringFormat=yyyy-MM-dd}" Width="140"/><DataGridTextColumn Header="Days remaining" Binding="{Binding DaysRemaining}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <Button Grid.Row="2" Content="Back" Width="120" HorizontalAlignment="Center" Margin="0,12,0,0" Click="Back_Click"/>
    </Grid>
</Window>
