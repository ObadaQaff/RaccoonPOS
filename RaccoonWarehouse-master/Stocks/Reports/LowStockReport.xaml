<Window x:Class="RaccoonWarehouse.Stocks.Reports.LowStockReport"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Title="تقرير بضائع تحت الحد الأدنى"
        Height="750" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#EEF3F7"
        FlowDirection="RightToLeft">

    <Window.Resources>
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#EEF3F7"/>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F8FBFD"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#D6DEE6"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#C84D4D"/>
        <SolidColorBrush x:Key="SoftDangerBrush" Color="#FCE7E7"/>

        <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#356FA8" Offset="0"/>
            <GradientStop Color="#0F5B52" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="ReportDataGridStyle" TargetType="DataGrid">
            <Setter Property="RowHeight" Value="42"/>
            <Setter Property="ColumnHeaderHeight" Value="46"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E9EEF3"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="BorderBrush" Value="#D6DEE6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FBFD"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F1F6FA"/>
                        <Setter Property="Foreground" Value="#27445D"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="BorderBrush" Value="#DDE5EC"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="22,20,22,14"
                CornerRadius="28"
                Padding="24"
                Background="{StaticResource HeroBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#204B72"
                        CornerRadius="20"
                        Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="عدد الأصناف الحرجة"
                                   Foreground="#D5E7F4"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="CountText"
                                   Foreground="White"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="18,0,0,0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <TextBlock Text="بضائع تحت الحد الأدنى"
                               Foreground="White"
                               FontSize="31"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"/>
                    <TextBlock Text="قائمة الأصناف التي تحتاج إلى تعزيز سريع قبل التأثير على البيع أو التوريد."
                               Foreground="#D3E6F3"
                               FontSize="15"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="22,0,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="22"
                    Padding="18"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="54"
                            Height="54"
                            CornerRadius="18"
                            Background="{StaticResource SoftDangerBrush}">
                        <fa:ImageAwesome Icon="Warning"
                                         Foreground="{StaticResource DangerBrush}"
                                         Width="24"
                                         Height="24"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="مراقبة المخزون الحرج"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#27445D"/>
                        <TextBlock Text="يعرض هذا التقرير كل صنف أصبح أقل من حدّه الأدنى اعتماداً على الرصيد الحالي."
                                   FontSize="14"
                                   Foreground="#687C8F"
                                    Margin="0,4,0,0"/>
                        <WrapPanel Margin="0,12,0,0">
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="المورد" FontWeight="SemiBold" Foreground="#27445D" Margin="0,0,0,5"/>
                                <ComboBox x:Name="SupplierComboBox" Width="250" Height="38" DisplayMemberPath="Name" SelectedValuePath="Id"
                                          IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                                          SelectionChanged="SupplierComboBox_SelectionChanged"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="اسم الصنف" FontWeight="SemiBold" Foreground="#27445D" Margin="0,0,0,5"/>
                                <Grid>
                                    <TextBox x:Name="ProductNameTextBox" Width="280" Height="38" Padding="8,4" VerticalContentAlignment="Center"
                                             TextChanged="ProductNameTextBox_TextChanged" PreviewKeyDown="ProductNameTextBox_PreviewKeyDown"/>
                                    <Popup x:Name="ProductSuggestionsPopup" PlacementTarget="{Binding ElementName=ProductNameTextBox}"
                                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Focusable="False">
                                        <Border Width="280" MaxHeight="230" Background="White" BorderBrush="#B7CAD8"
                                                BorderThickness="1" CornerRadius="4" Padding="2">
                                            <ListBox x:Name="ProductSuggestionsListBox" DisplayMemberPath="." FontSize="15"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     PreviewKeyDown="ProductSuggestionsListBox_PreviewKeyDown"
                                                     PreviewMouseLeftButtonUp="ProductSuggestionsListBox_PreviewMouseLeftButtonUp"/>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,8">
                                <TextBlock Text="رمز الصنف" FontWeight="SemiBold" Foreground="#27445D" Margin="0,0,0,5"/>
                                <TextBox x:Name="BarcodeTextBox" Width="180" Height="38" Padding="8,4" VerticalContentAlignment="Center"
                                         TextChanged="BarcodeTextBox_TextChanged"/>
                            </StackPanel>
                            <Button x:Name="GenerateReportButton" Content="عرض التقرير" Width="150" Height="38"
                                    VerticalAlignment="Bottom" Margin="0,0,0,8" Style="{StaticResource PrimaryButtonStyle}"
                                    Click="GenerateReport_Click"/>
                            <Button x:Name="ExportExcelButton" Content="تصدير Excel / Export Excel" Width="175" Height="38"
                                    IsEnabled="False" VerticalAlignment="Bottom" Margin="12,0,0,8"
                                    Style="{StaticResource PrimaryButtonStyle}" Click="ExportExcel_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="24"
                    Padding="14">
                <DataGrid x:Name="LowStockGrid"
                          MouseDoubleClick="LowStockGrid_MouseDoubleClick"
                          PreviewKeyDown="LowStockGrid_PreviewKeyDown"
                          SelectionUnit="Cell"
                          ClipboardCopyMode="ExcludeHeader"
                          AutoGenerateColumns="False"
                          Style="{StaticResource ReportDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="كود الصنف" Width="210" SortMemberPath="ITEMCODE" ClipboardContentBinding="{Binding ITEMCODE}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding ITEMCODE}" FlowDirection="LeftToRight"
                                                   VerticalAlignment="Center" TextAlignment="Center"/>
                                        <Button Grid.Column="1" Margin="8,0,0,0" Padding="6"
                                                ToolTip="{DynamicResource BarcodeCopyToolTip}"
                                                Background="Transparent" BorderBrush="Transparent" Cursor="Hand"
                                                Click="CopyBarcode_Click">
                                            <fa:ImageAwesome Icon="Copy" Width="14" Height="14" Foreground="#27445D"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="اسم الصنف" Binding="{Binding ProductName}" ElementStyle="{StaticResource ProductValueTextStyle}" Width="300"/>
                        <DataGridTextColumn Header="المورد / Supplier" Binding="{Binding SupplierName}" Width="220"/>
                        <DataGridTextColumn Header="الوحدة" Binding="{Binding UnitName}" Width="130"/>
                        <DataGridTextColumn Header="الكمية الحالية" Binding="{Binding CurrentQuantity}" Width="150"/>
                        <DataGridTextColumn Header="أقرب انتهاء" Binding="{Binding NearestExpiryDate, StringFormat=yyyy-MM-dd, TargetNullValue=-}" Width="160"/>
                        <DataGridTextColumn Header="الحد الأدنى" Binding="{Binding MinimumQuantity}" Width="150"/>
                        <DataGridTextColumn Header="النقص" Binding="{Binding Shortage}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Margin="22,0,22,20"
                Background="#E8EEF3"
                CornerRadius="18"
                Padding="12">
            <TextBlock Text="© 2026 Raccoon Warehouse"
                       HorizontalAlignment="Center"
                       Foreground="#416784"
                       FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
