<Window x:Class="RaccoonWarehouse.Stocks.StockLotsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lot Management / إدارة دفعات المخزون"
        Width="1500" Height="820" MinWidth="1100" MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppPageBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource AppCardBorderStyle}" Padding="20" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="Lot Management / إدارة دفعات المخزون"
                           FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
                <TextBlock x:Name="DescriptionText" Margin="0,6,0,0"
                           Text="Review quantities, costs, expiry dates, and safely open stock adjustments."
                           Foreground="{DynamicResource AppMutedTextBrush}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{DynamicResource AppCardBorderStyle}" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock x:Name="SearchLabel" Text="Search" Style="{DynamicResource AppFieldLabelStyle}" />
                    <TextBox x:Name="SearchTextBox" Style="{DynamicResource AppTextInputStyle}"
                             TextChanged="FiltersChanged" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                    <TextBlock x:Name="StatusLabel" Text="Status" Style="{DynamicResource AppFieldLabelStyle}" />
                    <ComboBox x:Name="StatusComboBox" Style="{DynamicResource AppComboBoxStyle}"
                              SelectedValuePath="Value" SelectionChanged="FiltersChanged" />
                </StackPanel>
                <Button Grid.Column="2" x:Name="RefreshButton" Content="Refresh / تحديث"
                        Style="{DynamicResource AppSecondaryButtonStyle}" Click="RefreshButton_Click"
                        VerticalAlignment="Bottom" Padding="22,9" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{DynamicResource AppCardBorderStyle}" Padding="10">
            <DataGrid x:Name="LotsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionChanged="LotsGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="LotColumn" Header="Lot" Binding="{Binding StockLotId}" />
                    <DataGridTextColumn x:Name="ProductColumn" Header="Product" Binding="{Binding ProductName}" ElementStyle="{StaticResource ProductValueTextStyle}" Width="2*" />
                    <DataGridTextColumn x:Name="UnitColumn" Header="Unit" Binding="{Binding UnitName}" />
                    <DataGridTextColumn x:Name="OriginalColumn" Header="Original" Binding="{Binding OriginalQuantity, StringFormat=N3}" />
                    <DataGridTextColumn x:Name="RemainingColumn" Header="Remaining" Binding="{Binding RemainingQuantity, StringFormat=N3}" />
                    <DataGridTextColumn x:Name="PurchaseCostColumn" Header="Purchase cost" Binding="{Binding PurchasePrice, StringFormat=N4}" />
                    <DataGridTextColumn x:Name="SalePriceColumn" Header="Sale price" Binding="{Binding SalePrice, StringFormat=N4}" />
                    <DataGridTextColumn x:Name="ExpiryColumn" Header="Expiry" Binding="{Binding ExpiryDate, StringFormat=d}" />
                    <DataGridTextColumn x:Name="StatusColumn" Header="Status" Binding="{Binding Status}" />
                    <DataGridCheckBoxColumn x:Name="UsedColumn" Header="Used" Binding="{Binding IsUsed}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="CountText" DockPanel.Dock="Left" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppMutedTextBrush}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="DetailsButton" Content="View details / التفاصيل"
                        Style="{DynamicResource AppSecondaryButtonStyle}" Click="DetailsButton_Click"
                        Padding="18,9" Margin="0,0,8,0" />
                <Button x:Name="AdjustmentButton" Content="Open adjustment / تعديل المخزون"
                        Style="{DynamicResource AppHeroButtonStyle}" Click="AdjustmentButton_Click"
                        Padding="18,9" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
