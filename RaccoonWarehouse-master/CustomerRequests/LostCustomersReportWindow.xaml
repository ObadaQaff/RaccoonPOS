<Window x:Class="RaccoonWarehouse.LostCustomers.LostCustomersReportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="تقرير العملاء المفقودين" Width="1400" Height="820" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" Background="#F2F6FA">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="#0E594C" CornerRadius="10" Padding="16" Margin="0,0,0,12"><TextBlock Text="تقرير العملاء المفقودين" Foreground="White" FontSize="24" FontWeight="Bold"/></Border><WrapPanel Grid.Row="1" Margin="0,0,0,10"><StackPanel Margin="5"><TextBlock Text="من تاريخ"/><DatePicker x:Name="FromDate" Width="150"/></StackPanel><StackPanel Margin="5"><TextBlock Text="إلى تاريخ"/><DatePicker x:Name="ToDate" Width="150"/></StackPanel><StackPanel Margin="5"><TextBlock Text="النوع"/><ComboBox x:Name="TypeFilter" Width="170"><ComboBoxItem Content="الكل" Tag="-1"/><ComboBoxItem Content="منتج غير متوفر" Tag="0"/><ComboBoxItem Content="سبب آخر" Tag="1"/></ComboBox></StackPanel><StackPanel Margin="5"><TextBlock Text="السبب"/><ComboBox x:Name="ReasonFilter" Width="190"><ComboBoxItem Content="الكل" Tag="-1"/><ComboBoxItem Content="غير متوفر بالمخزون" Tag="0"/><ComboBoxItem Content="غير مسجل بالنظام" Tag="1"/><ComboBoxItem Content="سبب آخر" Tag="2"/></ComboBox></StackPanel><StackPanel Margin="5"><TextBlock Text="بحث عن منتج أو موظف"/><TextBox x:Name="SearchBox" Width="220" Height="32"/></StackPanel><Button Content="تطبيق" Width="90" Height="32" Margin="5,20" Click="Apply_Click"/><Button Content="طباعة" Width="90" Height="32" Margin="5,20" Click="Print_Click"/></WrapPanel><Border Grid.Row="2" Background="White" Padding="12" Margin="0,0,0,10"><TextBlock x:Name="SummaryText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/></Border><DataGrid x:Name="Grid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="النوع" Binding="{Binding TypeLabel}" Width="150"/><DataGridTextColumn Header="السبب" Binding="{Binding ReasonLabel}" Width="220"/><DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="*"/><DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="100"/><DataGridTextColumn Header="الرسالة" Binding="{Binding Message}" Width="*"/><DataGridTextColumn Header="الملاحظات" Binding="{Binding Notes}" Width="*"/><DataGridTextColumn Header="الموظف" Binding="{Binding CreatedByName}" Width="150"/><DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedDate, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/></DataGrid.Columns></DataGrid></Grid>
</Window>
