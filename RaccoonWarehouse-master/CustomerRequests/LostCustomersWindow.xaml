<Window x:Class="RaccoonWarehouse.LostCustomers.LostCustomersWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="العملاء المفقودون" Width="1350" Height="820" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" Background="#F2F6FA">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="#0E594C" CornerRadius="10" Padding="16"><TextBlock Text="إدارة العملاء المفقودين" Foreground="White" FontSize="24" FontWeight="Bold"/></Border>
  <UniformGrid Grid.Row="1" Columns="5" Margin="0,12"><Border Background="#E4F2EE" Padding="10" Margin="4"><StackPanel><TextBlock Text="إجمالي السجلات"/><TextBlock x:Name="TotalCountText" FontSize="22" FontWeight="Bold" Foreground="#0E594C"/></StackPanel></Border><Border Background="#FFF7E1" Padding="10" Margin="4"><StackPanel><TextBlock Text="منتجات غير متوفرة"/><TextBlock x:Name="MissingProductCountText" FontSize="22" FontWeight="Bold"/></StackPanel></Border><Border Background="#F3EDF7" Padding="10" Margin="4"><StackPanel><TextBlock Text="أسباب أخرى"/><TextBlock x:Name="OtherReasonCountText" FontSize="22" FontWeight="Bold"/></StackPanel></Border><Border Background="#EEF4FA" Padding="10" Margin="4"><StackPanel><TextBlock Text="إجمالي الكميات"/><TextBlock x:Name="TotalQuantityText" FontSize="22" FontWeight="Bold"/></StackPanel></Border><Border Background="#EAF6EC" Padding="10" Margin="4"><StackPanel><TextBlock Text="اليوم"/><TextBlock x:Name="TodayCountText" FontSize="22" FontWeight="Bold" Foreground="#227A42"/></StackPanel></Border></UniformGrid>
  <Grid Grid.Row="2" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="بحث" VerticalAlignment="Center" Margin="5"/><TextBox x:Name="SearchBox" Width="260" Height="34" TextChanged="SearchBox_TextChanged" Margin="5"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0"><TextBlock Text="من" VerticalAlignment="Center" Margin="0,0,5,0"/><DatePicker x:Name="FromDate" Width="135" SelectedDateChanged="DateFilter_Changed"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0"><TextBlock Text="إلى" VerticalAlignment="Center" Margin="0,0,5,0"/><DatePicker x:Name="ToDate" Width="135" SelectedDateChanged="DateFilter_Changed"/></StackPanel><StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Left"><Button Content="إضافة سجل" Width="110" Height="34" Margin="5" Click="Add_Click"/><Button Content="تقرير" Width="90" Height="34" Margin="5" Click="Report_Click"/></StackPanel></Grid>
  <DataGrid x:Name="Grid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" MouseDoubleClick="Grid_MouseDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="النوع" Binding="{Binding TypeLabel}" Width="150"/><DataGridTextColumn Header="السبب" Binding="{Binding ReasonLabel}" Width="220"/><DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="*"/><DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="90"/><DataGridTextColumn Header="الملاحظات" Binding="{Binding Notes}" Width="*"/><DataGridTextColumn Header="الموظف" Binding="{Binding CreatedByName}" Width="150"/><DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedDate, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left"><Button Content="تعديل" Width="100" Margin="5" Click="Edit_Click"/><Button Content="حذف" Width="100" Margin="5" Click="Delete_Click" Background="#B3261E" Foreground="White"/></StackPanel>
 </Grid>
</Window>
