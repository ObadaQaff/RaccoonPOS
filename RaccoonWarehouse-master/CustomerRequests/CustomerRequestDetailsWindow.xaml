<Window x:Class="RaccoonWarehouse.CustomerRequests.CustomerRequestDetailsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="تفاصيل طلب العميل" Height="700" Width="1000" WindowStartupLocation="CenterOwner"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Padding="18" Background="{StaticResource AppPrimaryDarkBrush}" CornerRadius="12"><StackPanel><TextBlock Text="تفاصيل طلب العميل" Foreground="White" FontSize="24" FontWeight="Bold"/><TextBlock x:Name="SummaryText" Foreground="#D5EEE7" FontSize="14" Margin="0,6,0,0"/></StackPanel></Border><Grid Grid.Row="1" Margin="0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="العميل"/><TextBlock x:Name="CustomerText" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="الهاتف"/><TextBlock x:Name="PhoneText" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="الدفع"/><TextBlock x:Name="PaymentText" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="الملاحظات"/><TextBlock x:Name="NotesText" FontWeight="SemiBold"/></StackPanel></Grid><DataGrid Grid.Row="2" x:Name="LinesGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="المادة" Binding="{Binding ItemName}" Width="2*"/><DataGridTextColumn Header="الوحدة" Binding="{Binding UnitName}" Width="120"/><DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, StringFormat=N3}" Width="110"/><DataGridTextColumn Header="السعر" Binding="{Binding UnitPrice, StringFormat=N3}" Width="120"/><DataGridTextColumn Header="الإجمالي" Binding="{Binding LineTotal, StringFormat=N3}" Width="130"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0"><TextBlock x:Name="TotalText" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/><Button Content="طباعة الطلب" Width="130" Padding="14,8" Click="Print_Click" Style="{StaticResource AppSecondaryButtonStyle}"/><Button Content="إغلاق" Width="100" Padding="14,8" Margin="10,0,0,0" Click="Close_Click" Style="{StaticResource AppSecondaryButtonStyle}"/></StackPanel></Grid></Window>
