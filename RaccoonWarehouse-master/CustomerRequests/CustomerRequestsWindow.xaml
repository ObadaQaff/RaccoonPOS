<Window x:Class="RaccoonWarehouse.CustomerRequests.CustomerRequestsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="متابعة طلبات العملاء" Height="820" Width="1350" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Padding="18" Background="{StaticResource AppPrimaryDarkBrush}" CornerRadius="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="متابعة طلبات العملاء" Foreground="White" FontSize="24" FontWeight="Bold"/><TextBlock x:Name="SelectionSummary" Text="اختر طلباً لعرض الإجراءات المتاحة" Foreground="#D5EEE7" FontSize="13" Margin="0,6,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="إدارة الطلبات والموافقات والاستلام والمبيعات" Foreground="#D5EEE7" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center"/></Grid></Border>
  <UniformGrid Grid.Row="1" Columns="6" Margin="0,12"><Border Background="#E4F2EE" Padding="10" Margin="4"><StackPanel><TextBlock Text="إجمالي الطلبات"/><TextBlock x:Name="TotalCountText" FontSize="22" FontWeight="Bold" Foreground="#0E594C"/></StackPanel></Border><Border Background="#EEF4FA" Padding="10" Margin="4"><StackPanel><TextBlock Text="مرسلة"/><TextBlock x:Name="SubmittedCountText" FontSize="22" FontWeight="Bold"/></StackPanel></Border><Border Background="#EAF6EC" Padding="10" Margin="4"><StackPanel><TextBlock Text="معتمدة"/><TextBlock x:Name="ApprovedCountText" FontSize="22" FontWeight="Bold" Foreground="#227A42"/></StackPanel></Border><Border Background="#FDECEC" Padding="10" Margin="4"><StackPanel><TextBlock Text="ملغاة"/><TextBlock x:Name="CancelledCountText" FontSize="22" FontWeight="Bold" Foreground="#B3261E"/></StackPanel></Border><Border Background="#FFF7E1" Padding="10" Margin="4"><StackPanel><TextBlock Text="مدفوع جزئياً"/><TextBlock x:Name="PartialPaidCountText" FontSize="22" FontWeight="Bold"/></StackPanel></Border><Border Background="#F3EDF7" Padding="10" Margin="4"><StackPanel><TextBlock Text="غير مباع بالكامل"/><TextBlock x:Name="NotSoldCountText" FontSize="22" FontWeight="Bold"/></StackPanel></Border></UniformGrid>
  <Grid Grid.Row="2" Margin="0,4,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="بحث" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="SearchText" Width="250" Height="36" TextChanged="SearchText_TextChanged"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0"><TextBlock Text="من" VerticalAlignment="Center" Margin="0,0,5,0"/><DatePicker x:Name="FromDate" Width="135" SelectedDateChanged="DateFilter_Changed"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0"><TextBlock Text="إلى" VerticalAlignment="Center" Margin="0,0,5,0"/><DatePicker x:Name="ToDate" Width="135" SelectedDateChanged="DateFilter_Changed"/></StackPanel><ComboBox x:Name="StatusFilter" Grid.Column="3" Width="170" Height="36" Margin="8,0" SelectionChanged="Filter_Changed"><ComboBoxItem Content="كل الحالات" Tag="-1" IsSelected="True"/><ComboBoxItem Content="مرسل" Tag="0"/><ComboBoxItem Content="معتمد" Tag="1"/><ComboBoxItem Content="ملغى" Tag="2"/></ComboBox><WrapPanel Grid.Column="4" HorizontalAlignment="Left"><Button Content="إنشاء طلب" Width="125" Click="Create_Click" Padding="12,8" Margin="8,0,0,0" Style="{StaticResource AppHeroButtonStyle}"/><Button x:Name="DetailsButton" Content="عرض التفاصيل" Width="125" Click="Details_Click" Padding="12,8" Margin="8,0,0,0" Style="{StaticResource AppSecondaryButtonStyle}" Visibility="Collapsed"/><Button x:Name="ApproveButton" Content="اعتماد" Width="95" Click="Approve_Click" Padding="12,8" Margin="8,0,0,0" Style="{StaticResource AppHeroButtonStyle}" Visibility="Collapsed"/><Button x:Name="CancelButton" Content="إلغاء" Width="90" Click="Cancel_Click" Padding="12,8" Margin="8,0,0,0" Style="{StaticResource AppSecondaryButtonStyle}" Visibility="Collapsed"/><Button x:Name="ReceiveButton" Content="تحديث الاستلام" Width="150" Click="Receive_Click" Padding="12,8" Margin="8,0,0,0" Style="{StaticResource AppSecondaryButtonStyle}" Visibility="Collapsed"/><Button x:Name="SaleButton" Content="تحويل إلى بيع" Width="135" Click="Sale_Click" Padding="12,8" Margin="8,0,0,0" Style="{StaticResource AppHeroButtonStyle}" Visibility="Collapsed"/></WrapPanel></Grid>
  <DataGrid Grid.Row="3" x:Name="RequestsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="رقم الطلب" Binding="{Binding RequestNumber}" Width="130"/><DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="2*"/><DataGridTextColumn Header="الهاتف" Binding="{Binding CustomerPhone}" Width="140"/><DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalAmount, StringFormat=N3}" Width="130"/><DataGridTextColumn Header="الدفع" Binding="{Binding PaymentStatus}" Width="130"/><DataGridTextColumn Header="الحالة" Binding="{Binding StatusText}" Width="120"/><DataGridTextColumn Header="الاستلام" Binding="{Binding ReceivingStatusText}" Width="130"/><DataGridTextColumn Header="المبيعات" Binding="{Binding SalesStatusText}" Width="120"/></DataGrid.Columns></DataGrid>
 </Grid>
</Window>
