<Window x:Class="RaccoonWarehouse.CustomerRequests.CustomerRequestReceivingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="تحديث استلام طلب العميل" Height="520" Width="900" WindowStartupLocation="CenterOwner"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="TitleText" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/><DataGrid Grid.Row="1" ItemsSource="{Binding Lines}" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="المادة" Binding="{Binding ItemName}" IsReadOnly="True" Width="2*"/><DataGridTextColumn Header="المطلوب" Binding="{Binding Quantity, StringFormat=N3}" IsReadOnly="True" Width="130"/><DataGridTextColumn Header="المستلم" Binding="{Binding ReceivedQuantity, UpdateSourceTrigger=LostFocus}" Width="140"/><DataGridTextColumn Header="الوحدة" Binding="{Binding UnitName}" IsReadOnly="True" Width="130"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0"><TextBlock Text="حالة الاستلام" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="StatusCombo" Width="170" Height="34"><ComboBoxItem Content="قيد الانتظار" Tag="0"/><ComboBoxItem Content="مستلم جزئياً" Tag="1"/><ComboBoxItem Content="مستلم بالكامل" Tag="2"/></ComboBox><Button Content="حفظ" Click="Save_Click" Padding="22,8" Margin="12,0,0,0" Background="{StaticResource AppPrimaryBrush}" Foreground="White"/></StackPanel></Grid></Window>
