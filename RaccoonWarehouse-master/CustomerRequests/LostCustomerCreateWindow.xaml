<Window x:Class="RaccoonWarehouse.LostCustomers.LostCustomerCreateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="تسجيل عميل مفقود" Width="820" Height="700" WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" Background="#F2F6FA">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#0E594C" CornerRadius="10" Padding="18" Margin="0,0,0,16"><TextBlock Text="تسجيل عميل مفقود" Foreground="White" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
    <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="5"><TextBlock Text="نوع السجل" FontWeight="SemiBold"/><ComboBox x:Name="TypeCombo" SelectionChanged="TypeCombo_SelectionChanged" Margin="0,5" Height="34"><ComboBoxItem Content="منتج غير متوفر" Tag="0"/><ComboBoxItem Content="سبب آخر" Tag="1"/></ComboBox></StackPanel><StackPanel Grid.Column="1" Margin="5"><TextBlock Text="سبب عدم توفر المنتج" FontWeight="SemiBold"/><ComboBox x:Name="ReasonCombo" Margin="0,5" Height="34"><ComboBoxItem Content="المنتج موجود لكن غير متوفر" Tag="0"/><ComboBoxItem Content="المنتج غير مسجل في النظام" Tag="1"/></ComboBox></StackPanel></Grid>
    <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel x:Name="ProductPanel"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="5"><TextBlock Text="المنتج" FontWeight="SemiBold"/><TextBox x:Name="ProductNameBox" Height="34" Margin="0,5"/></StackPanel><Button Grid.Column="1" Content="بحث عن منتج" Width="125" Height="34" Margin="8,22,5,0" Click="SearchProduct_Click"/><Button Grid.Column="2" Content="إضافة للصنف" Width="115" Height="34" Margin="5,22,5,0" Click="AddItem_Click"/></Grid><StackPanel Orientation="Horizontal"><TextBlock Text="الكمية" VerticalAlignment="Center" Margin="5"/><TextBox x:Name="QuantityBox" Width="130" Height="34" Margin="5" Text="1"/></StackPanel></StackPanel><DataGrid x:Name="ItemsGrid" Grid.Row="1" Height="150" Margin="5" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="*"/><DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="110"/><DataGridTemplateColumn Header="إزالة" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="حذف" Click="RemoveItem_Click" Padding="8,2"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><StackPanel x:Name="GeneralPanel" Grid.Row="2" Visibility="Collapsed" Margin="5"><TextBlock Text="سبب فقدان العميل" FontWeight="SemiBold"/><TextBox x:Name="MessageTextBox" Height="100" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,5"/></StackPanel></Grid>
    <StackPanel Grid.Row="3"><TextBlock Text="ملاحظات إضافية" FontWeight="SemiBold" Margin="5,8,5,0"/><TextBox x:Name="NotesBox" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Margin="5"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><Button Content="حفظ" Width="120" Height="40" Margin="5" Background="#0E594C" Foreground="White" Click="Save_Click"/><Button Content="إلغاء" Width="100" Height="40" Margin="5" Click="Close_Click"/></StackPanel></StackPanel>
  </Grid>
</Window>
