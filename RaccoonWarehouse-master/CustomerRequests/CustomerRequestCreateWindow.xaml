<Window x:Class="RaccoonWarehouse.CustomerRequests.CustomerRequestCreateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="إنشاء طلب عميل" Height="720" Width="1150" WindowStartupLocation="CenterOwner"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Padding="16" Background="{StaticResource AppPrimaryDarkBrush}" CornerRadius="10"><TextBlock Text="إنشاء طلب عميل" Foreground="White" FontSize="23" FontWeight="Bold"/></Border><Grid Grid.Row="1" Margin="0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="4"><TextBlock Text="العميل"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions><ComboBox x:Name="CustomerCombo" Height="34" DisplayMemberPath="Name" IsEditable="True" IsTextSearchEnabled="False" KeyUp="CustomerCombo_KeyUp"/><Button Grid.Column="1" Content="+" Click="AddCustomer_Click" Margin="4,0,0,0"/></Grid></StackPanel><StackPanel Grid.Column="1" Margin="8,4"><TextBlock Text="المبلغ المدفوع"/><TextBox x:Name="PaidText" Height="34"/></StackPanel><StackPanel Grid.Column="2" Margin="8,4"><TextBlock Text="ملاحظة الدفع"/><TextBox x:Name="PaymentNoteText" Height="34"/></StackPanel></Grid><DataGrid Grid.Row="2" x:Name="LinesGrid" AutoGenerateColumns="False" CanUserAddRows="False" ItemsSource="{Binding Lines}" Margin="0,0,0,12"><DataGrid.Columns><DataGridTextColumn Header="المادة" Binding="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}" Width="2*"/><DataGridTextColumn Header="الوحدة" Binding="{Binding UnitName}" Width="120"/><DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="110"/><DataGridTextColumn Header="السعر" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" Width="120"/><DataGridTextColumn Header="الإجمالي" Binding="{Binding LineTotal, StringFormat=N3}" IsReadOnly="True" Width="130"/><DataGridTemplateColumn Header="حذف"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="حذف" Click="DeleteLine_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left"><Button Content="إضافة من المنتجات" Click="AddProduct_Click" Padding="16,8" Margin="4"/><Button Content="إضافة مادة يدوية" Click="AddManual_Click" Padding="16,8" Margin="4"/><TextBlock x:Name="TotalText" FontSize="17" FontWeight="Bold" Margin="20,10"/><Button Content="حفظ الطلب" Click="Save_Click" Padding="22,8" Margin="4" Background="{StaticResource AppPrimaryBrush}" Foreground="White"/></StackPanel></Grid></Window>
