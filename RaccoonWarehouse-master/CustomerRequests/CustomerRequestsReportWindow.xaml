<Window x:Class="RaccoonWarehouse.CustomerRequests.CustomerRequestsReportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="تقرير طلبات العملاء" Height="650" Width="1200" WindowStartupLocation="CenterOwner"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,14"><TextBlock Text="تقرير طلبات العملاء" FontSize="22" FontWeight="Bold" DockPanel.Dock="Right"/><StackPanel Orientation="Horizontal"><TextBlock Text="البحث برقم الطلب أو اسم/هاتف العميل" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="SearchText" Width="260" Height="34" TextChanged="SearchText_TextChanged" ToolTip="اكتب رقم الطلب أو اسم العميل أو هاتفه"/><ComboBox x:Name="StatusFilter" Width="170" Height="34" Margin="8,0" SelectionChanged="Filter_Changed"><ComboBoxItem Content="كل الحالات" Tag="-1" IsSelected="True"/><ComboBoxItem Content="مُرسل" Tag="0"/><ComboBoxItem Content="معتمد" Tag="1"/><ComboBoxItem Content="ملغى" Tag="2"/></ComboBox><Button Content="طباعة التقرير" Width="125" Height="34" Margin="8,0,0,0" Click="Print_Click" Style="{StaticResource AppSecondaryButtonStyle}"/></StackPanel></DockPanel><DataGrid Grid.Row="1" x:Name="ReportGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="رقم الطلب" Binding="{Binding RequestNumber}" Width="130"/><DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="2*"/><DataGridTextColumn Header="الهاتف" Binding="{Binding CustomerPhone}" Width="140"/><DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalAmount, StringFormat=N3}" Width="130"/><DataGridTextColumn Header="الدفع" Binding="{Binding PaymentStatus}" Width="140"/><DataGridTextColumn Header="الحالة" Binding="{Binding StatusText}" Width="120"/><DataGridTextColumn Header="الاستلام" Binding="{Binding ReceivingStatusText}" Width="140"/><DataGridTextColumn Header="المبيعات" Binding="{Binding SalesStatusText}" Width="140"/><DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="2*"/></DataGrid.Columns></DataGrid></Grid></Window>
