<Window x:Class="RaccoonWarehouse.Auth.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Width="440"
        Height="520"
        ShowInTaskbar="False"
        Loaded="Window_Loaded">
    <Grid>
        <Border
            x:Name="Card"
            Background="White"
            BorderBrush="#DCE6EA"
            BorderThickness="1"
            CornerRadius="24"
            Padding="32"
            Width="360"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Effect="{StaticResource DropShadowSoft}"
            RenderTransformOrigin="0.5,0.5">

            <Border.RenderTransform>
                <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
            </Border.RenderTransform>

            <StackPanel>
                <Image Source="pack://application:,,,/Assets/Logo/TheSystemLogo.png"
                       Width="104"
                       Height="86"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,14"/>

                <TextBlock Text="The System"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AppTextBrush}"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Secure cashier login"
                           FontSize="13"
                           Foreground="{DynamicResource AppMutedTextBrush}"
                           Margin="0,6,0,8"
                           HorizontalAlignment="Center"/>

                <TextBlock x:Name="UserNameHint"
                           Foreground="{DynamicResource AppPrimaryBrush}"
                           FontSize="18"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,22"
                           Visibility="Collapsed"/>

                <TextBlock Text="Username"
                           Foreground="{DynamicResource AppTextBrush}"
                           FontSize="12"/>

                <TextBox x:Name="UsernameTextBox"
                         Height="40"
                         FontSize="14"
                         Background="#F4F8F9"
                         Foreground="{DynamicResource AppTextBrush}"
                         BorderBrush="#D5E1E5"
                         BorderThickness="1"
                         Padding="12"
                         Margin="0,6,0,16"
                         FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}"
                         KeyDown="EnterToLogin"/>

                <TextBlock Text="Password"
                           Foreground="{DynamicResource AppTextBrush}"
                           FontSize="12"/>

                <Grid Margin="0,6,0,22">
                    <PasswordBox x:Name="PasswordBox"
                                 Height="40"
                                 FontSize="14"
                                 Background="#F4F8F9"
                                 Foreground="{DynamicResource AppTextBrush}"
                                 BorderBrush="#D5E1E5"
                                 BorderThickness="1"
                                 Padding="12"
                                 KeyDown="EnterToLogin"/>

                    <TextBox x:Name="PasswordTextBox"
                             Height="40"
                             FontSize="14"
                             Background="#F4F8F9"
                             Foreground="{DynamicResource AppTextBrush}"
                             BorderBrush="#D5E1E5"
                             BorderThickness="1"
                             Padding="12"
                             Visibility="Collapsed"
                             KeyDown="EnterToLogin"/>

                    <Button Content="👁"
                            Width="32"
                            Height="32"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource AppMutedTextBrush}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="TogglePassword"/>
                </Grid>

                <TextBlock x:Name="ErrorText"
                   Foreground="#C62828"
                   FontSize="12"
                   Margin="0,0,0,12"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>

                <Button x:Name="LoginButton"
                        Height="44"
                        FontSize="15"
                        FontWeight="Bold"
                        Background="#5B2BE0"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Login_Click">

                    <Grid>
                        <TextBlock x:Name="LoginText"
                                   Text="LOGIN"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <ProgressBar x:Name="LoginProgress"
                                     IsIndeterminate="True"
                                     Height="4"
                                     VerticalAlignment="Bottom"
                                     Foreground="#A7F3F0"
                                     Background="#FFFFFF55"
                                     Visibility="Collapsed"/>
                    </Grid>

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="12">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#6D3DF2"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#4520B2"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#B9B0D8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Height="40"
                        Margin="0,12,0,0"
                        FontSize="14"
                        Background="#EAF0FA"
                        Foreground="#23405A"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Exit_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#D9E5F7"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#C9D9EE"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="Exit"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
