<Window x:Class="RaccoonWarehouse.Auth.CloseCashierSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إنهاء جلسة الكاشير"
        Height="720" Width="840"
        MinHeight="560" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F5F6FA"
        FlowDirection="RightToLeft"
        Closing="CloseCashierSessionWindow_Closing">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#263238" CornerRadius="12" Padding="18">
            <TextBlock Text="إنهاء جلسة الكاشير"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Body -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="18" Margin="0,14,0,14"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="الكاشير:" Foreground="#7F8C8D"/>
                    <TextBlock Grid.Column="1" x:Name="CashierNameText" FontWeight="SemiBold"/>

                    <TextBlock Grid.Column="2" Text="رقم الجلسة:" Foreground="#7F8C8D"/>
                    <TextBlock Grid.Column="3" x:Name="SessionIdText" FontWeight="SemiBold"/>
                </Grid>

                <Separator Margin="0,14,0,14"/>

                <!-- Summary Cards -->
                <UniformGrid Columns="2" Margin="0,0,0,10">
                    <Border Background="#FAFAFA" CornerRadius="10" Padding="12" Margin="0,0,8,8">
                        <StackPanel>
                            <TextBlock Text="رصيد الافتتاح" Foreground="#7F8C8D"/>
                            <TextBlock x:Name="OpeningText" FontSize="20" FontWeight="Bold" Foreground="#2C3E50"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#FAFAFA" CornerRadius="10" Padding="12" Margin="8,0,0,8">
                        <StackPanel>
                            <TextBlock Text="النقد المتوقع (حسب الحركات)" Foreground="#7F8C8D"/>
                    <TextBlock x:Name="ExpectedText" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Text="—"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Counted amounts -->
                <TextBlock Text="المبالغ الفعلية بعد العد"
                           FontSize="16" FontWeight="Bold" Foreground="#263238"/>
                <UniformGrid Columns="2" Margin="0,10,0,0">
                    <Border Background="#FFF5F5" CornerRadius="10" Padding="12" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="النقد الفعلي" Foreground="#7F8C8D"/>
                            <TextBox x:Name="CountedTextBox" Height="45" FontSize="16" VerticalContentAlignment="Center" FlowDirection="LeftToRight" Padding="10" BorderBrush="#CBD5DF" BorderThickness="1"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#F3F7FF" CornerRadius="10" Padding="12" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Visa الفعلي" Foreground="#7F8C8D"/>
                            <TextBox x:Name="CountedVisaTextBox" Height="45" FontSize="16" VerticalContentAlignment="Center" FlowDirection="LeftToRight" Padding="10" BorderBrush="#CBD5DF" BorderThickness="1"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Results are revealed only after Calculate -->
                <Border x:Name="ResultPanel" Visibility="Collapsed" Background="#FAFAFA" CornerRadius="10" Padding="12" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="النقد المتوقع" Foreground="#7F8C8D"/>
                            <TextBlock x:Name="ExpectedCashResultText" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Text="—"/>
                            <TextBlock Text="فرق النقد" Foreground="#7F8C8D"/>
                            <TextBlock x:Name="DiffText"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#E74C3C"
                                       Text="0.00"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Visa المتوقع" Foreground="#7F8C8D"/>
                            <TextBlock x:Name="ExpectedVisaResultText" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Text="—"/>
                            <TextBlock Text="فرق Visa" Foreground="#7F8C8D"/>
                            <TextBlock x:Name="VisaDiffText" FontSize="22" FontWeight="Bold" Foreground="#E74C3C" Text="0.00"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="NotesPanel" Visibility="Collapsed" Background="#FFF9E8" CornerRadius="10" Padding="12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock x:Name="SettlementStatusText" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="ملاحظات الإغلاق" Foreground="#7F8C8D"/>
                        <TextBox x:Name="NotesTextBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True" BorderBrush="#CBD5DF" BorderThickness="1" Padding="8"/>
                    </StackPanel>
                </Border>

                <Border x:Name="ActionsPanel" Visibility="Collapsed" Background="#F7FAFC" CornerRadius="10" Padding="12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="حركات الجلسة | Session actions"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#263238"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="تشمل المبيعات والمشتريات والمرتجعات والسندات المسجلة خلال هذه الجلسة."
                                   Foreground="#607D8B"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>
                        <ItemsControl x:Name="ActionsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#D9E2EC" BorderThickness="0,0,0,1" Padding="6,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="145"/>
                                                <ColumnDefinition Width="125"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding ActionType}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DocumentNumber}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Notes}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="3" Text="{Binding PaymentMethod}" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding Amount, StringFormat={}{0:N2}}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ErrorText"
                           Visibility="Collapsed"
                           Margin="0,12,0,0"
                           Foreground="#C62828"
                           FontWeight="SemiBold"/>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer Buttons -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="160"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1"
                    x:Name="CalculateButton"
                    Height="44"
                    Margin="0,0,10,0"
                    Background="#1976A8"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand"
                    IsEnabled="False"
                    Content="حساب الفرق"
                    Click="Calculate_Click"/>

            <Button Grid.Column="2"
                    x:Name="CloseSessionButton"
                    Height="44"
                    Background="#C62828"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand"
                    IsEnabled="False"
                    Visibility="Collapsed"
                    Content="حفظ وإنهاء الجلسة"
                    Click="CloseSession_Click"/>
        </Grid>
    </Grid>
</Window>
