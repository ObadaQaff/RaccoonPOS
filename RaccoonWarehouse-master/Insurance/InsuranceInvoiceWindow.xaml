<Window x:Class="RaccoonWarehouse.Insurance.InsuranceInvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="فاتورة تأمين / Insurance Invoice" Width="1240" Height="800" MinWidth="1000" MinHeight="620"
        Background="{StaticResource AppPageBackgroundBrush}" WindowStartupLocation="CenterScreen">
    <Grid Margin="24" FlowDirection="{DynamicResource CurrentFlowDirection}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource AppDashboardHeroBrush}" CornerRadius="0,0,28,28" Padding="26,20" Margin="-24,-24,-24,18">
            <StackPanel><TextBlock Text="فاتورة تأمين" Foreground="White" FontSize="27" FontWeight="Bold"/><TextBlock Text="Insurance Invoice" Foreground="White" Opacity=".88" Margin="0,3,0,0"/><TextBlock Text="فاتورة مستقلة بقواعد تغطية وخصم لكل منتج" Foreground="White" Opacity=".78" Margin="0,10,0,0"/></StackPanel>
        </Border>
        <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Style="{StaticResource AppCardBorderStyle}" Padding="16" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="105"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="105"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="105"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="Customer ID" VerticalAlignment="Center"/><TextBox x:Name="CustomerIdTextBox" Grid.Column="1" Margin="8,0,16,0" Padding="8,6"/>
                <TextBlock Text="Member policy" Grid.Column="2" VerticalAlignment="Center"/><TextBox x:Name="PolicyIdTextBox" Grid.Column="3" Margin="8,0,16,0" Padding="8,6"/>
                <TextBlock Text="Company ID" Grid.Column="4" VerticalAlignment="Center"/><TextBox x:Name="CompanyIdTextBox" Grid.Column="5" Margin="8,0,16,0" Padding="8,6"/>
                <TextBlock Text="Contract ID" Grid.Column="6" VerticalAlignment="Center"/><TextBox x:Name="ContractIdTextBox" Grid.Column="7" Margin="8,0,12,0" Padding="8,6"/>
                <TextBlock Text="Plan ID" Grid.Column="8" VerticalAlignment="Center"/><TextBox x:Name="PlanIdTextBox" Grid.Column="9" Margin="8,0,12,0" Padding="8,6"/>
                <TextBlock Text="Version ID" Grid.Column="10" VerticalAlignment="Center"/><TextBox x:Name="VersionIdTextBox" Grid.Column="11" Margin="8,0,12,0" Padding="8,6"/>
                <TextBlock Text="Invoice no." Grid.Column="12" VerticalAlignment="Center"/><TextBox x:Name="InvoiceNumberTextBox" Grid.Column="13" Margin="8,0,0,0" Padding="8,6"/>
            </Grid></Border>
            <Border Grid.Row="1" Style="{StaticResource AppCardBorderStyle}" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="4,0,4,12"><TextBlock Text="منتجات التغطية / Covered products" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AppTextBrush}"/><Button Content="إضافة منتج / Add product" Margin="20,0,0,0" Padding="16,8" Style="{StaticResource AppFormButtonStyle}" Click="AddProduct_Click"/></StackPanel>
                <DataGrid x:Name="LinesGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Style="{StaticResource AppModernDataGridStyle}"><DataGrid.Columns><DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/><DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="80"/><DataGridTextColumn Header="Price" Binding="{Binding UnitPrice}" Width="100"/><DataGridTextColumn Header="Discount %" Binding="{Binding DiscountPercent}" Width="100"/><DataGridTextColumn Header="Discount amount" Binding="{Binding DiscountAmount}" Width="120"/><DataGridTextColumn Header="Covered" Binding="{Binding CoveredAmount}" Width="100"/><DataGridTextColumn Header="Patient" Binding="{Binding PatientAmount}" Width="100"/><DataGridTextColumn Header="Remove" Binding="{Binding RemoveText}" Width="85"/></DataGrid.Columns></DataGrid>
            </Grid></Border>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource AppCardBorderStyle}" Padding="16" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="الخصم:" FontWeight="Bold"/><TextBlock x:Name="DiscountTotalText" Margin="6,0,18,0"/><TextBlock Text="التأمين:" FontWeight="Bold"/><TextBlock x:Name="InsuranceTotalText" Margin="6,0,18,0"/><TextBlock Text="المريض:" FontWeight="Bold"/><TextBlock x:Name="PatientTotalText" Margin="6,0,0,0"/></StackPanel><Button Content="حساب / Calculate" Grid.Column="1" Margin="12,0,8,0" Padding="18,9" Style="{StaticResource AppSecondaryButtonStyle}" Click="Calculate_Click"/><Button Content="حفظ الفاتورة / Save" Grid.Column="2" Margin="8,0,0,0" Padding="20,9" Style="{StaticResource AppFormButtonStyle}" Click="Save_Click"/><Button Content="إغلاق / Close" Grid.Column="3" Margin="8,0,0,0" Padding="16,9" Click="Close_Click"/></Grid></Border>
    </Grid>
</Window>
