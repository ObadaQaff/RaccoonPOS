<Window xmlns:security="clr-namespace:RaccoonWarehouse.Security" x:Class="RaccoonWarehouse.Insurance.InsuranceCompaniesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="شركات التأمين" Width="1400" Height="800" MinWidth="1000" MinHeight="600"
        Background="{StaticResource AppPageBackgroundBrush}" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource AppGreenHeroBrush}" CornerRadius="0,0,36,36" Padding="30,28" Margin="-24,-24,-24,20">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="شركات التأمين" Foreground="White" FontSize="32" FontWeight="Bold"/>
                    <TextBlock Text="عرض جهات التأمين المسجلة وإضافة جهة جديدة." Foreground="White" Opacity="0.85" FontSize="14" Margin="0,10,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#204F43" CornerRadius="16" Padding="24,12" Margin="20,0,0,0">
                    <StackPanel><TextBlock Text="عدد الشركات المعروضة" Foreground="#D4E9E2"/><TextBlock x:Name="CountText" Text="0" Foreground="White" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel>
                </Border>
            </Grid>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource AppCardBorderStyle}" Padding="16" Margin="0,0,0,16">
            <WrapPanel>
                <StackPanel Margin="0,0,20,0" Width="340">
                    <TextBlock Text="بحث" Style="{StaticResource AppFieldLabelStyle}"/>
                    <TextBox x:Name="SearchTextBox" Style="{StaticResource AppSearchTextBoxStyle}"
                             ToolTip="ابحث بالرمز أو الاسم أو الهاتف." TextChanged="SearchTextBox_TextChanged"/>
                </StackPanel>
                <Button x:Name="AddButton" Content="إضافة جديد" Style="{StaticResource AppFormButtonStyle}" Padding="22,10" Margin="0,20,12,0" VerticalAlignment="Bottom" Click="Add_Click" security:PermissionWindowGuard.Keys="InsuranceCompanies.Create"/>
                <Button x:Name="RefreshButton" Content="تحديث" Style="{StaticResource AppSecondaryButtonStyle}" Padding="22,10" Margin="0,20,12,0" VerticalAlignment="Bottom" Click="Refresh_Click"/>
                <Button Content="عودة" Style="{StaticResource AppSecondaryButtonStyle}" Padding="22,10" Margin="0,20,0,0" VerticalAlignment="Bottom" Click="Back_Click"/>
            </WrapPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource AppCardBorderStyle}" Padding="14">
            <Grid>
                <DataGrid x:Name="CompaniesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          CanUserSortColumns="True" SelectionMode="Single" EnableRowVirtualization="True"
                          Style="{StaticResource AppModernDataGridStyle}"
                          PreviewMouseRightButtonDown="CompaniesGrid_PreviewMouseRightButtonDown"
                          ContextMenuOpening="CompaniesGrid_ContextMenuOpening">
                    <DataGrid.ContextMenu>
                        <ContextMenu x:Name="CompaniesContextMenu">
                            <MenuItem x:Name="CompanyStatementMenuItem" Header="كشف الحساب" Style="{StaticResource AppMenuItemStyle}" Click="Statement_Click" security:PermissionWindowGuard.Keys="Accounting.GeneralLedger.View"/>
                            <MenuItem x:Name="EditCompanyMenuItem" Header="تعديل" Style="{StaticResource AppMenuItemStyle}" Click="Edit_Click" security:PermissionWindowGuard.Keys="InsuranceCompanies.Edit"/>
                            <MenuItem x:Name="DeleteCompanyMenuItem" Header="حذف" Style="{StaticResource AppMenuItemStyle}" Click="Delete_Click" security:PermissionWindowGuard.Keys="InsuranceCompanies.Delete"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الرمز" Binding="{Binding Company.Code}" Width="130"/>
                        <DataGridTextColumn Header="الاسم" Binding="{Binding Company.Name}" Width="2*" MinWidth="200"/>
                        <DataGridTextColumn Header="الخصم التعاقدي (%)" Binding="{Binding Company.ContractualDiscountPercent, StringFormat=N2}" Width="165"/>
                        <DataGridTextColumn Header="الهاتف" Binding="{Binding Company.Phone}" Width="150"/>
                        <DataGridTextColumn Header="البريد الإلكتروني" Binding="{Binding Company.Email}" Width="1.5*" MinWidth="190"/>
                        <DataGridTextColumn Header="نوع جهة التأمين" Binding="{Binding OrganizationTypeName}" Width="180"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding StatusName}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel x:Name="EmptyStatePanel" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed">
                    <TextBlock Text="لا توجد شركات تأمين مطابقة." FontSize="18" FontWeight="Bold" Foreground="{StaticResource AppTextBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="أضف جهة تأمين جديدة أو عدّل كلمات البحث." FontSize="13" Foreground="{StaticResource AppMutedTextBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
