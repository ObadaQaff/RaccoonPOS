<Window x:Class="RaccoonWarehouse.Insurance.InsuranceCompaniesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="شركات التأمين / Insurance Companies"
        Width="1120" Height="720" MinWidth="900" MinHeight="600"
        Background="{StaticResource AppPageBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Margin="24" FlowDirection="{DynamicResource CurrentFlowDirection}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource AppDashboardHeroBrush}" CornerRadius="0,0,28,28" Padding="28,24" Margin="-24,-24,-24,20">
            <Grid>
                <StackPanel>
                    <TextBlock Text="شركات التأمين" Foreground="White" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="Insurance Companies" Foreground="White" Opacity="0.88" FontSize="14" Margin="0,4,0,0"/>
                    <TextBlock Text="إدارة شركات التأمين، المدراء، والجهات المتعاقدة" Foreground="White" Opacity="0.78" FontSize="13" Margin="0,12,0,0"/>
                </StackPanel>
                <Button Content="تحديث / Refresh" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="18,10" Style="{StaticResource AppSecondaryButtonStyle}" Click="Refresh_Click"/>
            </Grid>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource AppCardBorderStyle}" Padding="16">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Margin="4,0,4,14">
                    <TextBlock Text="الجهات المسجلة / Registered organizations" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AppTextBrush}"/>
                    <TextBlock Text="اختر صفاً للمراجعة أو أضف جهة تأمين جديدة من النموذج أدناه." Foreground="{StaticResource AppMutedTextBrush}" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <Grid Grid.Row="1">
                    <DataGrid x:Name="CompaniesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="True" SelectionMode="Single" EnableRowVirtualization="True" Style="{StaticResource AppModernDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الرمز / Code" Binding="{Binding Code}" Width="130"/>
                            <DataGridTextColumn Header="الاسم / Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="الهاتف / Phone" Binding="{Binding Phone}" Width="150"/>
                            <DataGridTextColumn Header="البريد / Email" Binding="{Binding Email}" Width="220"/>
                            <DataGridTextColumn Header="النوع / Role" Binding="{Binding OrganizationType}" Width="170"/>
                            <DataGridTextColumn Header="الحالة / Status" Binding="{Binding Status}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel x:Name="EmptyStatePanel" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed">
                        <TextBlock Text="لا توجد شركات تأمين مسجلة" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AppTextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="No insurance organizations found" FontSize="12" Foreground="{StaticResource AppMutedTextBrush}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource AppCardBorderStyle}" Padding="18" Margin="0,18,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="إضافة جهة تأمين / Add insurance organization" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AppTextBrush}"/>
                    <TextBlock Text="أدخل البيانات الأساسية ثم احفظ الجهة لاستخدامها في العقود والمطالبات." Foreground="{StaticResource AppMutedTextBrush}" FontSize="12" Margin="0,4,0,16"/>
                </StackPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="190"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="الرمز / Code" VerticalAlignment="Center" Foreground="{StaticResource AppTextBrush}"/>
                    <TextBox x:Name="CodeTextBox" Grid.Column="1" Margin="8,0,22,0" Padding="10,7"/>
                    <TextBlock Text="الاسم / Name" Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource AppTextBrush}"/>
                    <TextBox x:Name="NameTextBox" Grid.Column="3" Margin="8,0,22,0" Padding="10,7"/>
                    <TextBlock Text="النوع / Role" Grid.Column="4" VerticalAlignment="Center" Foreground="{StaticResource AppTextBrush}"/>
                    <ComboBox x:Name="OrganizationTypeComboBox" Grid.Column="5" Margin="8,0,18,0" Padding="8,6"/>
                    <Button Content="حفظ / Save" Grid.Column="6" Padding="22,10" Style="{StaticResource AppFormButtonStyle}" Click="Save_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
