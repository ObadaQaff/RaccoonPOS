<Window x:Class="RaccoonWarehouse.Insurance.InsuranceSettlementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تسويات التأمين / Insurance Settlements"
        Width="1240" Height="820" MinWidth="980" MinHeight="650"
        Background="{StaticResource AppPageBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Margin="24" FlowDirection="{DynamicResource CurrentFlowDirection}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource AppDashboardHeroBrush}" CornerRadius="0,0,28,28" Padding="28,24" Margin="-24,-24,-24,20">
            <Grid>
                <StackPanel>
                    <TextBlock Text="تسويات التأمين" Foreground="White" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="Insurance Settlements" Foreground="White" Opacity="0.88" FontSize="14" Margin="0,4,0,0"/>
                    <TextBlock Text="تجميع المطالبات ومتابعة الذمم وتسجيل الدفعات" Foreground="White" Opacity="0.78" FontSize="13" Margin="0,12,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button Content="تحديث / Refresh" Padding="18,10" Margin="0,0,8,0" Style="{StaticResource AppSecondaryButtonStyle}" Click="Refresh_Click"/>
                    <Button Content="أعمار الذمم / Aging" Padding="18,10" Style="{StaticResource AppSecondaryButtonStyle}" Click="Aging_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource AppCardBorderStyle}" Padding="16">
                <DataGrid x:Name="ClaimsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="True" SelectionMode="Single" Style="{StaticResource AppModernDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المطالبة / Claim" Binding="{Binding ClaimNumber}" Width="170"/>
                        <DataGridTextColumn Header="الشركة / Company" Binding="{Binding InsuranceCompanyId}" Width="110"/>
                        <DataGridTextColumn Header="الحالة / Status" Binding="{Binding Status}" Width="160"/>
                        <DataGridTextColumn Header="المعتمد / Approved" Binding="{Binding ApprovedAmount}" Width="130"/>
                        <DataGridTextColumn Header="المدفوع / Paid" Binding="{Binding PaidAmount}" Width="120"/>
                        <DataGridTextColumn Header="المتبقي / Outstanding" Binding="{Binding OutstandingAmount}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource AppCardBorderStyle}" Padding="16" Margin="0,16,0,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="تسجيل دفعة / Record payment" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AppTextBrush}"/>
                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="رقم المطالبة" VerticalAlignment="Center"/>
                        <TextBox x:Name="PaymentClaimIdTextBox" Grid.Column="1" Margin="8,0,18,0" Padding="8,6"/>
                        <TextBlock Text="رقم الإيصال" Grid.Column="2" VerticalAlignment="Center"/>
                        <TextBox x:Name="ReceiptNumberTextBox" Grid.Column="3" Margin="8,0,18,0" Padding="8,6"/>
                        <TextBlock Text="المبلغ" Grid.Column="4" VerticalAlignment="Center"/>
                        <TextBox x:Name="PaymentAmountTextBox" Grid.Column="5" Margin="8,0,18,0" Padding="8,6"/>
                        <TextBlock Text="الشركة" Grid.Column="6" VerticalAlignment="Center"/>
                        <TextBox x:Name="PaymentCompanyIdTextBox" Grid.Column="7" Margin="8,0,18,0" Padding="8,6"/>
                        <TextBox x:Name="PaymentReferenceTextBox" Grid.Column="8" Margin="0,0,18,0" Padding="8,6" ToolTip="Reference / مرجع"/>
                        <Button Content="حفظ الدفعة / Save" Grid.Column="9" Padding="18,9" Style="{StaticResource AppFormButtonStyle}" Click="RecordPayment_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource AppCardBorderStyle}" Padding="16" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="تجميع الشركة" VerticalAlignment="Center"/>
                <TextBox x:Name="BatchCompanyIdTextBox" Grid.Column="1" Margin="8,0,18,0" Padding="8,6"/>
                <TextBlock Text="من" Grid.Column="2" VerticalAlignment="Center"/>
                <DatePicker x:Name="BatchFromDatePicker" Grid.Column="3" Margin="8,0,18,0"/>
                <TextBlock Text="إلى" Grid.Column="4" VerticalAlignment="Center"/>
                <DatePicker x:Name="BatchToDatePicker" Grid.Column="5" Margin="8,0,18,0"/>
                <TextBlock Text="إنشاء دفعة جاهزة للإرسال / Create submission batch" Grid.Column="6" Foreground="{StaticResource AppMutedTextBrush}" VerticalAlignment="Center"/>
                <Button Content="إنشاء / Create" Grid.Column="7" Padding="18,9" Style="{StaticResource AppFormButtonStyle}" Click="CreateBatch_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
