<Window x:Class="RaccoonWarehouse.Insurance.InsuranceSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إعدادات التأمين / Insurance Setup" Width="1260" Height="820" MinWidth="1000" MinHeight="650"
        Background="{StaticResource AppPageBackgroundBrush}" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Grid Margin="24" FlowDirection="{DynamicResource CurrentFlowDirection}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource AppDashboardHeroBrush}" CornerRadius="0,0,28,28" Padding="28,24" Margin="-24,-24,-24,20">
            <StackPanel>
                <TextBlock Text="إعدادات التأمين" Foreground="White" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="Insurance Setup" Foreground="White" Opacity=".88" FontSize="14" Margin="0,4,0,0"/>
                <TextBlock Text="إدارة العقود والخطط والأعضاء وقواعد التغطية" Foreground="White" Opacity=".78" FontSize="13" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
        <TabControl Grid.Row="1" Background="Transparent">
            <TabItem Header="العقود / Contracts">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource AppCardBorderStyle}" Padding="14">
                        <DataGrid x:Name="ContractsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="ContractsGrid_SelectionChanged" Style="{StaticResource AppModernDataGridStyle}">
                            <DataGrid.Columns><DataGridTextColumn Header="الرقم / Number" Binding="{Binding ContractNumber}" Width="150"/><DataGridTextColumn Header="الاسم / Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="الشركة / Company ID" Binding="{Binding InsuranceCompanyId}" Width="140"/><DataGridTextColumn Header="من / From" Binding="{Binding ValidFrom, StringFormat=d}" Width="120"/><DataGridTextColumn Header="إلى / To" Binding="{Binding ValidTo, StringFormat=d}" Width="120"/><DataGridTextColumn Header="الحالة / Status" Binding="{Binding Status}" Width="120"/></DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource AppCardBorderStyle}" Padding="16" Margin="0,14,0,0">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="إضافة أو تعديل عقد / Add or edit contract" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AppTextBrush}" Margin="0,0,0,14"/>
                            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="رقم العقد" VerticalAlignment="Center"/><TextBox x:Name="ContractNumberTextBox" Grid.Column="1" Margin="8,0,18,0" Padding="8,6"/>
                                <TextBlock Text="اسم العقد" Grid.Column="2" VerticalAlignment="Center"/><TextBox x:Name="ContractNameTextBox" Grid.Column="3" Margin="8,0,18,0" Padding="8,6"/>
                                <TextBlock Text="Company ID" Grid.Column="4" VerticalAlignment="Center"/><TextBox x:Name="ContractCompanyIdTextBox" Grid.Column="5" Margin="8,0,18,0" Padding="8,6"/>
                                <TextBlock Text="Valid from" Grid.Column="6" VerticalAlignment="Center"/><TextBox x:Name="ContractFromTextBox" Grid.Column="7" Margin="8,0,18,0" Padding="8,6"/>
                                <Button Content="حفظ / Save" Grid.Column="8" Padding="18,9" Style="{StaticResource AppFormButtonStyle}" Click="SaveContract_Click"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="الخطط / Plans">
                <Grid Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource AppCardBorderStyle}" Padding="14"><DataGrid x:Name="PlansGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Style="{StaticResource AppModernDataGridStyle}"><DataGrid.Columns><DataGridTextColumn Header="Contract ID" Binding="{Binding InsuranceContractId}" Width="120"/><DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="140"/><DataGridTextColumn Header="الاسم / Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="من / From" Binding="{Binding ValidFrom, StringFormat=d}" Width="120"/><DataGridTextColumn Header="إلى / To" Binding="{Binding ValidTo, StringFormat=d}" Width="120"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/></DataGrid.Columns></DataGrid></Border>
                    <Border Grid.Row="1" Style="{StaticResource AppCardBorderStyle}" Padding="16" Margin="0,14,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="إضافة خطة / Add plan" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AppTextBrush}" Margin="0,0,0,14"/><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="130"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Contract ID" VerticalAlignment="Center"/><TextBox x:Name="PlanContractIdTextBox" Grid.Column="1" Margin="8,0,18,0" Padding="8,6"/><TextBlock Text="Code" Grid.Column="2" VerticalAlignment="Center"/><TextBox x:Name="PlanCodeTextBox" Grid.Column="3" Margin="8,0,18,0" Padding="8,6"/><TextBlock Text="اسم الخطة" Grid.Column="4" VerticalAlignment="Center"/><TextBox x:Name="PlanNameTextBox" Grid.Column="5" Margin="8,0,18,0" Padding="8,6"/><Button Content="حفظ / Save" Grid.Column="6" Padding="18,9" Style="{StaticResource AppFormButtonStyle}" Click="SavePlan_Click"/></Grid></Grid></Border>
                </Grid>
            </TabItem>
            <TabItem Header="الأعضاء / Members">
                <Grid Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource AppCardBorderStyle}" Padding="14"><DataGrid x:Name="MembersGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Style="{StaticResource AppModernDataGridStyle}"><DataGrid.Columns><DataGridTextColumn Header="Customer ID" Binding="{Binding CustomerId}" Width="120"/><DataGridTextColumn Header="Company ID" Binding="{Binding InsuranceCompanyId}" Width="120"/><DataGridTextColumn Header="Member number" Binding="{Binding MemberNumber}" Width="180"/><DataGridTextColumn Header="Contract ID" Binding="{Binding InsuranceContractId}" Width="120"/><DataGridTextColumn Header="Plan ID" Binding="{Binding InsurancePlanId}" Width="100"/><DataGridTextColumn Header="Eligibility" Binding="{Binding EligibilityStatus}" Width="140"/></DataGrid.Columns></DataGrid></Border>
                    <Border Grid.Row="1" Style="{StaticResource AppCardBorderStyle}" Padding="16" Margin="0,14,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="إضافة عضوية / Add member policy" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AppTextBrush}" Margin="0,0,0,14"/><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Customer ID" VerticalAlignment="Center"/><TextBox x:Name="MemberCustomerIdTextBox" Grid.Column="1" Margin="8,0,16,0" Padding="8,6"/><TextBlock Text="Company ID" Grid.Column="2" VerticalAlignment="Center"/><TextBox x:Name="MemberCompanyIdTextBox" Grid.Column="3" Margin="8,0,16,0" Padding="8,6"/><TextBlock Text="Contract ID" Grid.Column="4" VerticalAlignment="Center"/><TextBox x:Name="MemberContractIdTextBox" Grid.Column="5" Margin="8,0,16,0" Padding="8,6"/><TextBlock Text="رقم العضوية" Grid.Column="6" VerticalAlignment="Center"/><TextBox x:Name="MemberNumberTextBox" Grid.Column="7" Margin="8,0,16,0" Padding="8,6"/><Button Content="حفظ / Save" Grid.Column="8" Padding="18,9" Style="{StaticResource AppFormButtonStyle}" Click="SaveMember_Click"/></Grid></Grid></Border>
                </Grid>
            </TabItem>
            <TabItem Header="قواعد التغطية / Coverage rules">
                <Grid Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource AppCardBorderStyle}" Padding="14"><DataGrid x:Name="RulesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Style="{StaticResource AppModernDataGridStyle}"><DataGrid.Columns><DataGridTextColumn Header="Version ID" Binding="{Binding InsuranceContractVersionId}" Width="110"/><DataGridTextColumn Header="Plan ID" Binding="{Binding InsurancePlanId}" Width="90"/><DataGridTextColumn Header="Product ID" Binding="{Binding ProductId}" Width="110"/><DataGridTextColumn Header="Discount %" Binding="{Binding DiscountPercent}" Width="100"/><DataGridTextColumn Header="Coverage %" Binding="{Binding CoveragePercent}" Width="100"/><DataGridTextColumn Header="Copay %" Binding="{Binding CopayPercent}" Width="90"/><DataGridCheckBoxColumn Header="Authorization" Binding="{Binding RequiresAuthorization}" Width="110"/><DataGridCheckBoxColumn Header="Excluded" Binding="{Binding IsExcluded}" Width="90"/></DataGrid.Columns></DataGrid></Border>
                    <Border Grid.Row="1" Style="{StaticResource AppCardBorderStyle}" Padding="16" Margin="0,14,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="إضافة قاعدة تغطية / Add coverage rule" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AppTextBrush}" Margin="0,0,0,14"/><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="140"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock Text="Version ID" VerticalAlignment="Center"/><TextBox x:Name="RuleVersionIdTextBox" Grid.Column="1" Margin="8,0,14,0" Padding="8,6"/><TextBlock Text="Plan ID" Grid.Column="2" VerticalAlignment="Center"/><TextBox x:Name="RulePlanIdTextBox" Grid.Column="3" Margin="8,0,14,0" Padding="8,6"/><TextBlock Text="Product" Grid.Column="4" VerticalAlignment="Center"/><TextBox x:Name="RuleProductIdTextBox" Grid.Column="5" Margin="8,0,6,0" Padding="8,6" IsReadOnly="True"/><Button Content="اختيار" Grid.Column="6" Padding="10,6" Click="SelectRuleProduct_Click"/><TextBlock Text="Coverage %" Grid.Column="7" VerticalAlignment="Center"/><TextBox x:Name="RuleCoverageTextBox" Grid.Column="8" Margin="8,0,0,0" Padding="8,6"/></Grid><Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Discount %" VerticalAlignment="Center"/><TextBox x:Name="RuleDiscountTextBox" Grid.Column="1" Margin="8,0,18,0" Padding="8,6"/><TextBlock Text="Fixed discount" Grid.Column="2" VerticalAlignment="Center"/><TextBox x:Name="RuleFixedDiscountTextBox" Grid.Column="3" Margin="8,0,18,0" Padding="8,6"/><TextBlock Text="Copay %" Grid.Column="4" VerticalAlignment="Center"/><TextBox x:Name="RuleCopayTextBox" Grid.Column="5" Margin="8,0,18,0" Padding="8,6"/><Button Content="حفظ / Save" Grid.Column="6" Padding="18,9" Style="{StaticResource AppFormButtonStyle}" Click="SaveRule_Click"/></Grid></Grid></Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
