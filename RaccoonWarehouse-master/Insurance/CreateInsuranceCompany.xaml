<Window x:Class="RaccoonWarehouse.Insurance.CreateInsuranceCompany"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إنشاء شركة تأمين" Height="800" Width="1400" MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppPageBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="240"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" CornerRadius="0,0,36,36" Background="{StaticResource AppGreenHeroBrush}">
            <StackPanel Margin="34,24,34,30" VerticalAlignment="Center">
                <TextBlock x:Name="FormTitleText" Text="إنشاء شركة تأمين" FontSize="34" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="FormSubtitleText" Text="أدخل بيانات جهة التأمين والخصم التعاقدي ثم احفظها في جدول شركات التأمين."
                           FontSize="14" Foreground="White" Opacity="0.85" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" Margin="28,-70,28,28">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource AppCardBorderStyle}" Padding="28" Margin="0,0,20,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="FormGrid">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,16">
                            <TextBlock Text="الرمز" Style="{StaticResource AppFieldLabelStyle}"/>
                            <TextBox x:Name="CodeTextBox" Style="{StaticResource AppTextInputStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,16">
                            <TextBlock Text="اسم شركة التأمين" Style="{StaticResource AppFieldLabelStyle}"/>
                            <TextBox x:Name="NameTextBox" Style="{StaticResource AppTextInputStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,16">
                            <TextBlock Text="الاسم بالإنجليزية" Style="{StaticResource AppFieldLabelStyle}"/>
                            <TextBox x:Name="NameEnglishTextBox" Style="{StaticResource AppTextInputStyle}" FlowDirection="LeftToRight"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,16">
                            <TextBlock Text="نوع جهة التأمين" Style="{StaticResource AppFieldLabelStyle}"/>
                            <ComboBox x:Name="OrganizationTypeComboBox" Style="{StaticResource AppComboBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,16">
                            <TextBlock Text="الخصم التعاقدي (%)" Style="{StaticResource AppFieldLabelStyle}"/>
                            <TextBox x:Name="ContractualDiscountTextBox" Text="0" FlowDirection="LeftToRight" Style="{StaticResource AppTextInputStyle}"/>
                            <TextBlock Text="نسبة من 0 إلى 100" Foreground="{StaticResource AppMutedTextBrush}" FontSize="12" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,16">
                            <TextBlock Text="الحالة" Style="{StaticResource AppFieldLabelStyle}"/>
                            <ComboBox x:Name="StatusComboBox" Style="{StaticResource AppComboBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,16">
                            <TextBlock Text="الهاتف" Style="{StaticResource AppFieldLabelStyle}"/>
                            <TextBox x:Name="PhoneTextBox" FlowDirection="LeftToRight" Style="{StaticResource AppTextInputStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,16">
                            <TextBlock Text="البريد الإلكتروني" Style="{StaticResource AppFieldLabelStyle}"/>
                            <TextBox x:Name="EmailTextBox" FlowDirection="LeftToRight" Style="{StaticResource AppTextInputStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,16">
                            <TextBlock Text="الرقم الضريبي" Style="{StaticResource AppFieldLabelStyle}"/>
                            <TextBox x:Name="TaxNumberTextBox" Style="{StaticResource AppTextInputStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,16">
                            <TextBlock Text="العنوان" Style="{StaticResource AppFieldLabelStyle}"/>
                            <TextBox x:Name="AddressTextBox" Style="{StaticResource AppTextInputStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="5" Grid.ColumnSpan="3">
                            <TextBlock Text="ملاحظات" Style="{StaticResource AppFieldLabelStyle}"/>
                            <TextBox x:Name="NotesTextBox" Style="{StaticResource AppTextInputStyle}" Height="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource AppCardBorderStyle}" Padding="24">
                <StackPanel>
                    <TextBlock Text="الإجراءات" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AppPrimaryBrush}"/>
                    <TextBlock x:Name="ActionHelpText" Text="احفظ شركة التأمين الجديدة أو عد إلى الجدول." Margin="0,12,0,0" FontSize="14"
                               Foreground="{StaticResource AppMutedTextBrush}" TextWrapping="Wrap"/>
                    <Button x:Name="SaveButton" Content="حفظ" Style="{StaticResource AppFormButtonStyle}" Margin="0,34,0,0" Click="Save_Click"/>
                    <Button x:Name="BackButton" Content="عودة" Style="{StaticResource AppSecondaryButtonStyle}" Margin="0,14,0,0" Click="Back_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
