<Window x:Class="RaccoonWarehouse.Products.UpdateProduct"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تعديل صنف"
        Height="900"
        Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource AppPageBackgroundBrush}"
        FlowDirection="{DynamicResource CurrentFlowDirection}">
    <Grid Background="{StaticResource AppPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="220"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" CornerRadius="0,0,34,34" Background="{StaticResource AppBlueHeroBrush}">
            <Grid Margin="34,24,34,34">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="تعديل صنف" FontSize="34" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="24,-52,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.6*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource AppCardBorderStyle}" Padding="24" Margin="0,0,20,0">
                <TabControl Background="Transparent" BorderThickness="0">
                    <TabItem Header="تفاصيل الصنف">
                     <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,18,8,8">
                      <StackPanel>
                        <TextBlock Text="المعلومات الأساسية" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AppBlueBrush}" Margin="8,0,8,16"/>
                        <UniformGrid Columns="3" Margin="0,0,0,10">
                            <StackPanel Margin="8,0">
                                <TextBlock Text="اسم الصنف" Style="{StaticResource AppFieldLabelStyle}"/>
                                <TextBox x:Name="NameTextBox" Style="{StaticResource AppTextInputStyle}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0">
                                <TextBlock Text="الكود / الباركود" Style="{StaticResource AppFieldLabelStyle}"/>
                                <TextBox x:Name="ITEMCODE" Style="{StaticResource AppTextInputStyle}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0">
                                <TextBlock Text="الحالة" Style="{StaticResource AppFieldLabelStyle}"/>
                                <ComboBox x:Name="StatusComboBox" Style="{StaticResource AppComboBoxStyle}"/>
                            </StackPanel>
                        </UniformGrid>
                        <UniformGrid Columns="3" Margin="0,0,0,10">
                            <StackPanel Margin="8,0">
                                <TextBlock Text="العلامة التجارية" Style="{StaticResource AppFieldLabelStyle}"/>
                                <ComboBox x:Name="BrandComboBox" Style="{StaticResource AppComboBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0">
                                <TextBlock Text="الفئة الفرعية" Style="{StaticResource AppFieldLabelStyle}"/>
                                <ComboBox x:Name="SubCategoryComboBox" Style="{StaticResource AppComboBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0">
                                <TextBlock Text="الكمية الدنيا" Style="{StaticResource AppFieldLabelStyle}"/>
                                <TextBox x:Name="MinimumQuantityTextBox" Style="{StaticResource AppTextInputStyle}"/>
                            </StackPanel>
                        </UniformGrid>
                        <StackPanel Margin="8,0,8,10">
                            <TextBlock Text="الوصف" Style="{StaticResource AppFieldLabelStyle}"/>
                            <TextBox x:Name="DescriptionTextBox" Style="{StaticResource AppTextInputStyle}" Height="72" AcceptsReturn="True" TextWrapping="Wrap"/>
                            <Grid Margin="0,8,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="TaxExemptCheckBox" Grid.Column="0" Content="معفى من الضريبة" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="نسبة الضريبة" Style="{StaticResource AppFieldLabelStyle}" VerticalAlignment="Center" Margin="0"/>
                                <TextBox x:Name="TaxRate" Grid.Column="3" Style="{StaticResource AppTextInputStyle}" Margin="10,0,0,0"/>
                            </Grid>
                        </StackPanel>
                      </StackPanel>
                     </ScrollViewer>
                    </TabItem>
                    <TabItem Header="الوحدات والأسعار">
                     <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,18,8,8">
                      <StackPanel>
                        <TextBlock Text="إدارة وحدات الصنف" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AppBlueBrush}" Margin="8,0,8,8"/>
                        <TextBlock Text="عدل الوحدات الحالية أو أضف وحدة جديدة مع أسعارها." Foreground="{StaticResource AppMutedTextBrush}" Margin="8,0,8,18"/>
                        <StackPanel x:Name="UnitsStackPanel" Margin="8,0,8,10"/>
                        <WrapPanel Margin="0,0,0,10" ItemWidth="150" ItemHeight="95">
                            <StackPanel Margin="6,0,14,10">
                                <TextBlock Text="الوحدة" Style="{StaticResource AppFieldLabelStyle}"/>
                                <ComboBox x:Name="UnitComboBox" Style="{StaticResource AppComboBoxStyle}" />
                            </StackPanel>
                            <StackPanel Margin="6,0,14,10">
                                <TextBlock Text="سعر البيع" Style="{StaticResource AppFieldLabelStyle}"/>
                                <TextBox x:Name="SalePriceTextBox" Style="{StaticResource AppTextInputStyle}" />
                            </StackPanel>
                            <StackPanel Margin="6,0,14,10">
                                <TextBlock Text="سعر الشراء" Style="{StaticResource AppFieldLabelStyle}"/>
                                <TextBox x:Name="PurchasePriceTextBox" Style="{StaticResource AppTextInputStyle}" />
                            </StackPanel>
                            <StackPanel Margin="6,0,14,10">
                                <TextBlock Text="الكمية لكل وحدة" Style="{StaticResource AppFieldLabelStyle}"/>
                                <TextBox x:Name="QuantityPerUnitTextBox" Style="{StaticResource AppTextInputStyle}" />
                            </StackPanel>
                            <StackPanel Margin="6,0,14,10">
                                <TextBlock Text="أساسية" Style="{StaticResource AppFieldLabelStyle}"/>
                                <CheckBox x:Name="IsBaseUnitCheckBox" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Margin="6,0,14,10">
                                <TextBlock Text="افتراضي بيع" Style="{StaticResource AppFieldLabelStyle}"/>
                                <CheckBox x:Name="IsDefaultSaleUnitCheckBox" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Margin="6,0,14,10">
                                <TextBlock Text="افتراضي شراء" Style="{StaticResource AppFieldLabelStyle}"/>
                                <CheckBox x:Name="IsDefaultPurchaseUnitCheckBox" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </WrapPanel>
                        <Button Content="إضافة وحدة" Width="200" Style="{StaticResource AppFormButtonStyle}" HorizontalAlignment="Center" Margin="0,10,0,20" Click="AddUnit_Click"/>
                      </StackPanel>
                     </ScrollViewer>
                    </TabItem>
                    <TabItem Header="المخزون الحالي">
                     <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,18,8,8">
                      <StackPanel>
                        <TextBlock Text="ملخص المخزون الحالي" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AppBlueBrush}" Margin="8,0,8,16"/>
                        <UniformGrid Columns="5" Margin="0,0,0,10">
                            <Border Margin="6,0,6,8" Padding="10" Background="#F7FBFD" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="إجمالي الكمية" Style="{StaticResource AppFieldLabelStyle}"/>
                                    <TextBlock Text="{Binding CurrentStockTotalQuantity, StringFormat={}{0:0.###}}" FontSize="16" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Margin="6,0,6,8" Padding="10" Background="#F7FBFD" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="إجمالي الكمية الأساسية" Style="{StaticResource AppFieldLabelStyle}"/>
                                    <TextBlock Text="{Binding CurrentStockTotalBaseQuantity, StringFormat={}{0:0.###}}" FontSize="16" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Margin="6,0,6,8" Padding="10" Background="#F7FBFD" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="متوسط التكلفة" Style="{StaticResource AppFieldLabelStyle}"/>
                                    <TextBlock Text="{Binding CurrentStockAverageCost, StringFormat={}{0:0.###}}" FontSize="16" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Margin="6,0,6,8" Padding="10" Background="#F7FBFD" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="متوسط سعر البيع" Style="{StaticResource AppFieldLabelStyle}"/>
                                    <TextBlock Text="{Binding CurrentStockAverageSalePrice, StringFormat={}{0:0.###}}" FontSize="16" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Margin="6,0,6,8" Padding="10" Background="#F7FBFD" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="أقرب صلاحية" Style="{StaticResource AppFieldLabelStyle}"/>
                                    <TextBlock Text="{Binding CurrentStockNearestExpiry}" FontSize="16" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <DataGrid x:Name="ProductStockGrid"
                                  ItemsSource="{Binding ProductStockByUnit}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  MinHeight="170"
                                  MaxHeight="280"
                                  Margin="0,0,0,12"
                                  Style="{StaticResource AppModernDataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الوحدة" Binding="{Binding UnitName}" Width="*"/>
                                <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, StringFormat={}{0:0.###}}" Width="110"/>
                                <DataGridTextColumn Header="الكمية الأساسية" Binding="{Binding BaseQuantity, StringFormat={}{0:0.###}}" Width="130"/>
                                <DataGridTextColumn Header="سعر الشراء" Binding="{Binding PurchasePrice, StringFormat={}{0:0.###}}" Width="110"/>
                                <DataGridTextColumn Header="سعر البيع" Binding="{Binding SalePrice, StringFormat={}{0:0.###}}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                      </StackPanel>
                     </ScrollViewer>
                    </TabItem>
                    <TabItem Header="حركات الصنف">
                     <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,18,8,8">
                      <StackPanel>
                        <TextBlock Text="سجل حركات الصنف" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AppBlueBrush}" Margin="8,0,8,8"/>
                        <TextBlock Text="راجع عمليات البيع والشراء والتسويات المرتبطة بالصنف." Foreground="{StaticResource AppMutedTextBrush}" Margin="8,0,8,18"/>
                        <DataGrid x:Name="ProductMovementsGrid"
                                  ItemsSource="{Binding ProductMovements}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  MinHeight="260"
                                  MaxHeight="420"
                                  Style="{StaticResource AppModernDataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding TransactionDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="160"/>
                                <DataGridTextColumn Header="النوع" Binding="{Binding TransactionTypeLabel}" Width="95"/>
                                <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, StringFormat={}{0:0.###}}" Width="85"/>
                                <DataGridTextColumn Header="الكمية الأساسية" Binding="{Binding BaseQuantity, StringFormat={}{0:0.###}}" Width="110"/>
                                <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitPrice, StringFormat={}{0:0.###}}" Width="95"/>
                                <DataGridTemplateColumn Header="مرجع الفاتورة" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding InvoiceRef}"
                                                    Click="InvoiceRef_Click"
                                                    IsEnabled="{Binding HasInvoiceRef}"
                                                    ToolTip="فتح الفاتورة"
                                                    Padding="4,0"
                                                    Style="{StaticResource AppSecondaryButtonStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="مرجع السند" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding VoucherRef}"
                                                    Click="VoucherRef_Click"
                                                    IsEnabled="{Binding HasVoucherRef}"
                                                    ToolTip="فتح السند"
                                                    Padding="4,0"
                                                    Style="{StaticResource AppSecondaryButtonStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="الكاشير" Binding="{Binding CashierName}" Width="110"/>
                                <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="120"/>
                                <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="220"/>
                            </DataGrid.Columns>
                        </DataGrid>
                      </StackPanel>
                     </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource AppCardBorderStyle}" Padding="24">
                <StackPanel>
                    <TextBlock Text="إجراءات" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AppBlueBrush}"/>
                    <TextBlock Margin="0,12,0,0" FontSize="14" Foreground="{StaticResource AppMutedTextBrush}" Text="حدث بيانات الصنف ووحداته ثم احفظ التعديلات أو ارجع."/>
                    <Button Content="تحديث" Margin="0,34,0,0" Width="160" Style="{StaticResource AppFormButtonStyle}" Background="{StaticResource AppBlueBrush}" Click="Update_Click"/>
                    <Button Content="عودة" Margin="0,14,0,0" Width="160" Style="{StaticResource AppSecondaryButtonStyle}" Click="Back_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
